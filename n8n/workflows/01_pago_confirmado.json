{
  "name": "Gym · Pago confirmado (webhook)",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "n1",
      "name": "Webhook pago",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "pago",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "n2",
      "name": "Plantilla",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [220, 0],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT cuerpo FROM plantillas_mensaje WHERE clave = 'pago_confirmado' AND activo LIMIT 1",
        "options": {}
      },
      "credentials": { "postgres": { "id": "GYM_PG", "name": "Gym Postgres (gym DB)" } }
    },
    {
      "id": "n3",
      "name": "Render",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "jsCode": "const b = $('Webhook pago').first().json.body || {};\nconst cuerpo = ($json.cuerpo) || 'Hola {{nombres}}, recibimos tu pago de S/ {{monto}}. Tu plan {{plan}} vence el {{fecha_fin}}.';\nconst vars = {\n  nombres: b.nombres || '',\n  apellidos: b.apellidos || '',\n  plan: b.plan || '',\n  fecha_fin: b.fecha_fin_txt || b.fecha_fin || '',\n  dias_restantes: '',\n  monto: (b.monto != null ? Number(b.monto).toFixed(2) : '')\n};\nconst texto = String(cuerpo).replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, (_, k) => (vars[k] ?? ''));\nconst numero = String(b.telefono || '').replace(/\\D/g, '');\nreturn [{ json: { socio_id: b.socio_id || null, numero, texto, clave: 'pago_confirmado' } }];"
      }
    },
    {
      "id": "n4",
      "name": "Tiene numero?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            { "leftValue": "={{ $json.numero }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n5",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, -40],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.numero, text: $json.texto }) }}",
        "options": {}
      }
    },
    {
      "id": "n6",
      "name": "SQL log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, -40],
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/'/g, \"''\");\nreturn $('Render').all().map(({ json: r }) => {\n  const sql = `INSERT INTO mensajes_enviados (socio_id, telefono, canal, plantilla_clave, contenido, estado, enviado_en, referencia_tipo) VALUES (${r.socio_id ? `'${esc(r.socio_id)}'` : 'NULL'}, '${esc(r.numero)}', 'whatsapp', '${esc(r.clave)}', '${esc(r.texto)}', 'enviado', now(), 'pago')`;\n  return { json: { sql } };\n});"
      }
    },
    {
      "id": "n7",
      "name": "Registrar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1320, -40],
      "parameters": { "operation": "executeQuery", "query": "={{ $json.sql }}", "options": {} },
      "credentials": { "postgres": { "id": "GYM_PG", "name": "Gym Postgres (gym DB)" } }
    }
  ],
  "connections": {
    "Webhook pago": { "main": [ [ { "node": "Plantilla", "type": "main", "index": 0 } ] ] },
    "Plantilla": { "main": [ [ { "node": "Render", "type": "main", "index": 0 } ] ] },
    "Render": { "main": [ [ { "node": "Tiene numero?", "type": "main", "index": 0 } ] ] },
    "Tiene numero?": { "main": [ [ { "node": "Enviar WhatsApp", "type": "main", "index": 0 } ], [] ] },
    "Enviar WhatsApp": { "main": [ [ { "node": "SQL log", "type": "main", "index": 0 } ] ] },
    "SQL log": { "main": [ [ { "node": "Registrar", "type": "main", "index": 0 } ] ] }
  }
}
