<div class="toolbar">
  <h1 class="mb0">Productos</h1>
  <button class="btn primary" type="button" onclick="abrirModalProductoNuevo();" style="display:inline-flex; align-items:center; gap:6px;">
    <%- u.icon('plus', 15) %> Nuevo producto
  </button>
</div>

<div class="card">
  <div class="table-wrap"><table>
    <thead><tr><th>Producto</th><th class="num">Precio</th><th class="num">Stock</th><th>Vender</th><th></th></tr></thead>
    <tbody>
    <% productos.forEach(function(p){ %>
      <tr<%= p.activo ? '' : ' class="muted"' %>>
        <td><strong><%= p.nombre %></strong></td>
        <td class="num"><%= u.soles(p.precio) %></td>
        <td class="num"><%= p.stock %></td>
        <td>
          <% if (p.activo) { %>
          <form method="post" action="/productos/<%= p.id %>/vender" class="search" style="margin:0;">
            <input type="number" name="cantidad" value="1" min="1" style="width:64px;">
            <select name="metodo_pago" style="width:auto;">
              <option value="efectivo">Efectivo</option>
              <option value="yape">Yape</option>
              <option value="plin">Plin</option>
              <option value="tarjeta">Tarjeta</option>
            </select>
            <button class="btn sm primary" type="submit">Vender</button>
          </form>
          <% } %>
        </td>
        <td class="actions">
          <button class="btn sm" type="button"
                  data-id="<%= p.id %>"
                  data-nombre="<%= p.nombre %>"
                  data-precio="<%= p.precio %>"
                  data-costo="<%= p.costo || '' %>"
                  data-stock="<%= p.stock %>"
                  onclick="abrirModalProductoEditar(this);"
                  style="display:inline-flex; align-items:center; gap:4px;">
            <%- u.icon('edit', 13) %> Editar
          </button>
          <form method="post" action="/productos/<%= p.id %>/toggle" style="margin:0;">
            <button class="btn sm" type="submit"><%= p.activo ? 'Desactivar' : 'Activar' %></button>
          </form>
        </td>
      </tr>
    <% }); %>
    <% if (!productos.length) { %><tr><td colspan="5" class="muted">Sin productos.</td></tr><% } %>
    </tbody>
  </table></div>
</div>

<h2>Ultimas ventas</h2>
<div class="card">
  <% if (!ventas.length) { %><p class="muted mb0">Sin ventas.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Fecha</th><th>Producto</th><th class="num">Cant.</th><th class="num">Subtotal</th><th>Metodo</th></tr></thead>
    <tbody>
    <% ventas.forEach(function(v){ %>
      <tr>
        <td><%= u.fechaHora(v.creado_en) %></td>
        <td><%= v.nombre %></td>
        <td class="num"><%= v.cantidad %></td>
        <td class="num"><%= u.soles(v.subtotal) %></td>
        <td><%= v.metodo_pago %></td>
      </tr>
    <% }); %>
    </tbody>
  </table></div>
  <% } %>
</div>

<!-- Modal Flotante: Crear / Editar Producto -->
<div id="modal-producto" class="modal-backdrop" style="display:none;" onclick="if(event.target===this) window.cerrarModal('modal-producto');">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">
        <%- u.icon('productos', 16) %> <span id="prod-modal-title">Nuevo Producto</span>
      </h3>
      <button type="button" class="modal-close" onclick="window.cerrarModal('modal-producto');" aria-label="Cerrar">
        <%- u.icon('close', 16) %>
      </button>
    </div>
    <form id="form-producto" method="post" action="/productos" class="stack" style="margin:0;">
      <div class="modal-body">
        <div style="margin-bottom:12px;">
          <label for="prod-nombre">Nombre del Producto *</label>
          <input id="prod-nombre" name="nombre" required placeholder="Ej: Agua San Luis 500ml, Batido Proteico...">
        </div>
        <div class="grid3">
          <div>
            <label for="prod-precio">Precio venta (S/) *</label>
            <input type="number" step="0.01" min="0" id="prod-precio" name="precio" placeholder="0.00" required>
          </div>
          <div>
            <label for="prod-costo">Costo (S/)</label>
            <input type="number" step="0.01" min="0" id="prod-costo" name="costo" placeholder="0.00">
          </div>
          <div>
            <label for="prod-stock">Stock actual</label>
            <input type="number" id="prod-stock" name="stock" value="0" min="0">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="window.cerrarModal('modal-producto');">Cancelar</button>
        <button type="submit" class="btn primary">Guardar Producto</button>
      </div>
    </form>
  </div>
</div>

<script>
  function abrirModalProductoNuevo() {
    document.getElementById('prod-modal-title').textContent = 'Nuevo Producto';
    var f = document.getElementById('form-producto');
    f.action = '/productos';
    f.reset();
    document.getElementById('prod-stock').value = '0';
    window.abrirModal('modal-producto');
  }

  function abrirModalProductoEditar(btn) {
    document.getElementById('prod-modal-title').textContent = 'Editar Producto';
    var f = document.getElementById('form-producto');
    f.action = '/productos/' + btn.getAttribute('data-id');
    document.getElementById('prod-nombre').value = btn.getAttribute('data-nombre') || '';
    document.getElementById('prod-precio').value = btn.getAttribute('data-precio') || '';
    document.getElementById('prod-costo').value = btn.getAttribute('data-costo') || '';
    document.getElementById('prod-stock').value = btn.getAttribute('data-stock') || '0';
    window.abrirModal('modal-producto');
  }
</script>
