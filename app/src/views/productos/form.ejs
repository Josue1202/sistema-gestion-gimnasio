<h1><%= modo === 'nuevo' ? 'Nuevo producto' : 'Editar producto' %></h1>
<div class="card">
  <form method="post" action="<%= modo === 'nuevo' ? '/productos' : '/productos/' + producto.id %>" class="stack">
    <div><label>Nombre *</label><input name="nombre" value="<%= producto.nombre || '' %>" required autofocus></div>
    <div class="grid3">
      <div><label>Precio venta (S/) *</label><input type="number" step="0.01" min="0" name="precio" value="<%= producto.precio != null ? producto.precio : '' %>" required></div>
      <div><label>Costo (S/)</label><input type="number" step="0.01" min="0" name="costo" value="<%= producto.costo != null ? producto.costo : '' %>"></div>
      <div><label>Stock</label><input type="number" name="stock" value="<%= producto.stock != null ? producto.stock : 0 %>"></div>
    </div>
    <div class="actions">
      <button class="btn primary" type="submit">Guardar</button>
      <a class="btn" href="/productos">Cancelar</a>
    </div>
  </form>
</div>
