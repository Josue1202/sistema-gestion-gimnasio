<div class="toolbar">
  <div>
    <h1 class="mb0">Control de Caja</h1>
    <p class="muted" style="margin-top:4px;">Gestión de ingresos, egresos y cuadre de efectivo diario.</p>
  </div>
  <div class="actions">
    <a class="btn" href="/caja/historial">📋 Ver Historial de Cajas Anteriores</a>
  </div>
</div>

<% if (!caja) { %>
  <div class="card" style="max-width:480px; margin:24px auto; border-top:4px solid var(--primary); padding:28px;">
    <h2 class="mt0" style="font-size:22px; text-align:center;">Abrir Caja del Día</h2>
    <p class="muted" style="text-align:center; margin-bottom:20px;">
      Ingresa el monto de efectivo base con el que inicia el turno en la caja física.
    </p>
    <form method="post" action="/caja/abrir" class="stack">
      <div>
        <label style="font-weight:700;">Monto de Apertura (S/ en efectivo)</label>
        <input type="number" step="0.01" min="0" name="monto_apertura" value="0.00" required autofocus
               style="font-size:20px; font-weight:700; padding:12px; text-align:center;">
      </div>
      <button class="btn primary" type="submit" style="font-size:16px; padding:12px; margin-top:8px;">
        ✓ Abrir Caja Ahora
      </button>
    </form>
  </div>
<% } else { %>
  <!-- KPIs de la Caja Abierta -->
  <div class="kpis">
    <div class="kpi">
      <div class="label">Monto Apertura</div>
      <div class="value"><%= u.soles(caja.monto_apertura) %></div>
    </div>
    <div class="kpi">
      <div class="label">Ingresos en Efectivo</div>
      <div class="value" style="color:#25d366;"><%= u.soles(caja.ingresos_efectivo) %></div>
    </div>
    <div class="kpi">
      <div class="label">Ingresos Yape / Plin / Tarjeta</div>
      <div class="value" style="color:#53bdeb;"><%= u.soles(caja.ingresos_otros) %></div>
    </div>
    <div class="kpi">
      <div class="label">Egresos / Gastos</div>
      <div class="value" style="color:#f15c6d;"><%= u.soles(caja.egresos_total) %></div>
    </div>
    <div class="kpi" style="border:2px solid var(--primary); background:var(--bubble-green);">
      <div class="label" style="color:#25d366;">Efectivo Físico Esperado</div>
      <div class="value" style="color:#ffffff; font-size:28px;"><%= u.soles(caja.efectivo_esperado) %></div>
    </div>
  </div>

  <p class="muted" style="font-size:13px; margin:10px 0 20px;">
    Caja abierta el <strong><%= u.fechaHora(caja.fecha_apertura) %></strong><%= caja.abierta_por ? ' por ' + caja.abierta_por : '' %>.
  </p>

  <div class="row">
    <div>
      <div class="card">
        <h2 class="mt0">Registrar Salida / Egreso</h2>
        <p class="muted" style="font-size:13px;">Registra compras de agua, insumos de limpieza o adelantos de sueldo.</p>
        <form method="post" action="/caja/egreso" class="stack">
          <div>
            <label>Concepto del gasto *</label>
            <input name="concepto" required placeholder="Ej: Compra de bidones de agua, artículos de limpieza...">
          </div>
          <div class="grid2">
            <div>
              <label>Monto (S/) *</label>
              <input type="number" step="0.01" min="0.10" name="monto" required placeholder="0.00" style="font-weight:700;">
            </div>
            <div>
              <label>Método utilizado</label>
              <select name="metodo_pago">
                <option value="efectivo">💵 Efectivo de caja</option>
                <option value="yape">🟣 Yape</option>
                <option value="plin">🔵 Plin</option>
                <option value="transferencia">🏦 Transferencia</option>
              </select>
            </div>
          </div>
          <button class="btn" type="submit" style="margin-top:4px;">- Guardar Egreso</button>
        </form>
      </div>
    </div>

    <div>
      <div class="card" style="border-top:3px solid #f15c6d;">
        <h2 class="mt0">Cerrar Caja (Fin de Turno)</h2>
        <p class="muted" style="font-size:13px;">Cuenta el efectivo físico en caja e ingrésalo para calcular si hay descuadre.</p>
        <form method="post" action="/caja/cerrar" class="stack" onsubmit="return confirm('¿Seguro que deseas cerrar la caja del turno? Esta acción registrará el cuadre final.');">
          <div>
            <label>Efectivo Físico Contado (S/) *</label>
            <input type="number" step="0.01" min="0" name="monto_cierre_real" required placeholder="0.00"
                   style="font-size:20px; font-weight:700; color:var(--text-bright);">
            <span class="muted" style="font-size:12px;">Se comparará contra el esperado: <strong><%= u.soles(caja.efectivo_esperado) %></strong></span>
          </div>
          <div>
            <label>Observaciones o notas de cierre</label>
            <input name="notas" placeholder="Opcional: motivo de faltante o sobrante...">
          </div>
          <button class="btn primary" type="submit" style="background:#ef4444; border-color:#ef4444; font-size:15px; padding:11px;">
            🔒 Cerrar Turno y Guardar Cuadre
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="toolbar" style="margin-top:24px;">
    <h2 class="mb0">Movimientos de esta Caja (<%= pagos.length + egresos.length %>)</h2>
  </div>
  <div class="card">
    <div class="table-wrap"><table>
      <thead>
        <tr>
          <th>Hora</th>
          <th>Tipo</th>
          <th>Detalle / Concepto</th>
          <th>Método</th>
          <th class="num">Monto</th>
        </tr>
      </thead>
      <tbody>
      <% pagos.forEach(function(p){ %>
        <tr>
          <td class="muted"><%= u.fechaHora(p.creado_en).split(' ')[1] || u.fechaHora(p.creado_en) %></td>
          <td><span class="badge ok">✓ Ingreso</span></td>
          <td><strong><%= p.concepto %></strong><%= p.nombres ? ' · ' + p.apellidos + ', ' + p.nombres : '' %></td>
          <td><span style="font-weight:600; text-transform:uppercase;"><%= p.metodo_pago %></span></td>
          <td class="num" style="color:#10b981;">+ <%= u.soles(p.monto) %></td>
        </tr>
      <% }); %>
      <% egresos.forEach(function(x){ %>
        <tr>
          <td class="muted"><%= u.fechaHora(x.creado_en).split(' ')[1] || u.fechaHora(x.creado_en) %></td>
          <td><span class="badge danger">- Egreso</span></td>
          <td><%= x.concepto %></td>
          <td><span style="text-transform:uppercase;"><%= x.metodo_pago %></span></td>
          <td class="num" style="color:#ef4444;">- <%= u.soles(x.monto) %></td>
        </tr>
      <% }); %>
      <% if (!pagos.length && !egresos.length) { %>
        <tr><td colspan="5" class="muted" style="text-align:center; padding:18px;">Sin movimientos registrados en este turno de caja.</td></tr>
      <% } %>
      </tbody>
    </table></div>
  </div>
<% } %>
