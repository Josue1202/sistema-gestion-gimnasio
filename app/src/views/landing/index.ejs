<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="Entrena en <%= gymName %>. Membresías inteligentes con acceso ilimitado, entrenadores certificados y academia de cursos de nutrición e hipertrofia.">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      color-scheme: dark;
      --bg: #090D16;
      --bg-alt: #0D1322;
      --surface: #121829;
      --surface-2: #182238;
      --border: rgba(255, 255, 255, 0.08);
      --border-hover: rgba(62, 207, 142, 0.35);
      --primary: #3ECF8E;
      --primary-hover: #32b57a;
      --primary-glow: rgba(62, 207, 142, 0.25);
      --text: #EDEDED;
      --text-bright: #FFFFFF;
      --muted: #9CA3AF;
      --muted-dark: #6B7280;
      --card-bg: rgba(18, 24, 41, 0.7);
      --font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background-color: var(--bg);
      background-image: 
        radial-gradient(at 0% 0%, rgba(62, 207, 142, 0.12) 0px, transparent 45%),
        radial-gradient(at 100% 30%, rgba(16, 185, 129, 0.08) 0px, transparent 40%),
        radial-gradient(at 50% 80%, rgba(20, 184, 166, 0.06) 0px, transparent 50%);
      color: var(--text);
      font-family: var(--font);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* Container */
    .container {
      width: 100%;
      max-width: 1220px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Navbar */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(9, 13, 22, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      transition: all 0.2s ease;
    }
    .navbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-bright);
    }
    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(62, 207, 142, 0.2), rgba(16, 185, 129, 0.05));
      border: 1px solid rgba(62, 207, 142, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      box-shadow: 0 4px 16px var(--primary-glow);
    }
    .brand-text {
      display: flex;
      flex-direction: column;
    }
    .brand-name {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }
    .brand-tag {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      list-style: none;
    }
    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: 14.5px;
      font-weight: 600;
      transition: color 0.15s ease;
    }
    .nav-links a:hover {
      color: var(--text-bright);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 9px;
      font-size: 14px;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.18s ease;
      border: 1px solid transparent;
      line-height: 1;
    }
    .btn.primary {
      background: var(--primary);
      color: #05160E;
      box-shadow: 0 4px 14px var(--primary-glow);
    }
    .btn.primary:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(62, 207, 142, 0.4);
    }
    .btn.outline {
      background: var(--surface);
      border-color: var(--border);
      color: var(--text);
    }
    .btn.outline:hover {
      border-color: rgba(255, 255, 255, 0.2);
      color: var(--text-bright);
      background: var(--surface-2);
    }
    .btn.ghost {
      background: transparent;
      color: var(--muted);
      padding: 8px 12px;
    }
    .btn.ghost:hover {
      color: var(--text-bright);
    }
    .btn.staff {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: var(--muted);
      font-size: 13px;
      padding: 8px 14px;
    }
    .btn.staff:hover {
      border-color: rgba(255, 255, 255, 0.25);
      color: var(--text-bright);
      background: rgba(255, 255, 255, 0.08);
    }
    .btn.lg {
      padding: 14px 26px;
      font-size: 15.5px;
      border-radius: 11px;
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .badge.green {
      background: rgba(62, 207, 142, 0.12);
      color: var(--primary);
      border: 1px solid rgba(62, 207, 142, 0.3);
    }
    .badge.gray {
      background: rgba(255, 255, 255, 0.06);
      color: var(--muted);
      border: 1px solid var(--border);
    }

    /* Hero */
    .hero {
      padding: 80px 0 60px;
      text-align: center;
      position: relative;
    }
    .hero-badge {
      margin-bottom: 20px;
    }
    .hero h1 {
      font-size: clamp(34px, 5.5vw, 62px);
      font-weight: 800;
      color: var(--text-bright);
      line-height: 1.12;
      letter-spacing: -0.03em;
      max-width: 900px;
      margin: 0 auto 20px;
    }
    .hero h1 span.gradient {
      background: linear-gradient(135deg, #3ECF8E 0%, #2DD4BF 60%, #38BDF8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero p.lead {
      font-size: clamp(16px, 2vw, 19px);
      color: var(--muted);
      max-width: 680px;
      margin: 0 auto 36px;
      font-weight: 500;
      line-height: 1.55;
    }
    .hero-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 50px;
    }

    /* Stats Bar */
    .stats-bar {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      backdrop-filter: blur(12px);
      max-width: 960px;
      margin: 0 auto;
    }
    .stat-item {
      text-align: center;
    }
    .stat-number {
      font-size: 28px;
      font-weight: 800;
      color: var(--text-bright);
      line-height: 1.1;
      margin-bottom: 4px;
    }
    .stat-number span { color: var(--primary); }
    .stat-label {
      font-size: 12.5px;
      color: var(--muted);
      font-weight: 600;
    }

    /* Section Headers */
    .section-header {
      text-align: center;
      max-width: 660px;
      margin: 0 auto 48px;
    }
    .section-header .tag {
      font-size: 12px;
      font-weight: 800;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 8px;
      display: block;
    }
    .section-header h2 {
      font-size: clamp(26px, 3.5vw, 38px);
      font-weight: 800;
      color: var(--text-bright);
      letter-spacing: -0.025em;
      line-height: 1.2;
      margin-bottom: 12px;
    }
    .section-header p {
      font-size: 15.5px;
      color: var(--muted);
      line-height: 1.5;
    }

    /* Bento Grid */
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 90px;
    }
    .bento-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 28px;
      backdrop-filter: blur(12px);
      transition: all 0.2s ease;
      position: relative;
      overflow: hidden;
    }
    .bento-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    }
    .bento-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(62, 207, 142, 0.1);
      border: 1px solid rgba(62, 207, 142, 0.25);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }
    .bento-card h3 {
      font-size: 18px;
      font-weight: 800;
      color: var(--text-bright);
      margin-bottom: 8px;
    }
    .bento-card p {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.5;
    }

    /* Calculator Section */
    .calculator-section {
      background: linear-gradient(180deg, rgba(18, 24, 41, 0.6) 0%, rgba(9, 13, 22, 0.9) 100%);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 44px 36px;
      margin-bottom: 90px;
      backdrop-filter: blur(14px);
    }
    .calc-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 36px;
      align-items: center;
    }
    .form-group {
      margin-bottom: 16px;
    }
    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
    }
    .form-input, .form-select {
      width: 100%;
      height: 44px;
      background: #090D16;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text-bright);
      padding: 0 14px;
      font-size: 14px;
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s ease;
    }
    .form-input:focus, .form-select:focus {
      border-color: var(--primary);
    }
    .calc-result-box {
      background: #090D16;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      text-align: center;
    }
    .calc-score {
      font-size: 48px;
      font-weight: 800;
      color: var(--primary);
      line-height: 1;
      margin-bottom: 6px;
    }
    .calc-status {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-bright);
      margin-bottom: 14px;
    }
    .calc-macros-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 18px;
      border-top: 1px solid var(--border);
      padding-top: 18px;
    }
    .calc-macro-item {
      font-size: 12px;
      color: var(--muted);
    }
    .calc-macro-val {
      font-size: 15px;
      font-weight: 800;
      color: var(--text-bright);
      margin-top: 2px;
    }

    /* Pricing Section */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
      margin-bottom: 90px;
    }
    .pricing-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px 28px;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: all 0.2s ease;
      backdrop-filter: blur(12px);
    }
    .pricing-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-3px);
    }
    .pricing-card.featured {
      border-color: rgba(62, 207, 142, 0.5);
      background: linear-gradient(180deg, rgba(62, 207, 142, 0.08) 0%, rgba(18, 24, 41, 0.8) 100%);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
    }
    .pricing-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--primary);
      color: #05160E;
      font-size: 11px;
      font-weight: 800;
      padding: 4px 12px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .plan-name {
      font-size: 20px;
      font-weight: 800;
      color: var(--text-bright);
      margin-bottom: 6px;
    }
    .plan-desc {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 20px;
      min-height: 40px;
    }
    .plan-price-wrap {
      margin-bottom: 24px;
      display: flex;
      align-items: baseline;
      gap: 6px;
    }
    .plan-currency {
      font-size: 20px;
      font-weight: 700;
      color: var(--primary);
    }
    .plan-amount {
      font-size: 42px;
      font-weight: 800;
      color: var(--text-bright);
      letter-spacing: -0.02em;
    }
    .plan-period {
      font-size: 13px;
      color: var(--muted);
    }
    .plan-features {
      list-style: none;
      margin-bottom: 28px;
      flex-grow: 1;
    }
    .plan-feature-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13.5px;
      color: #D1D5DB;
      margin-bottom: 12px;
    }
    .plan-feature-item svg {
      color: var(--primary);
      flex-shrink: 0;
    }

    /* Academy Section (DocentOS) */
    .academy-section {
      margin-bottom: 100px;
    }
    .academy-vip-bar {
      background: linear-gradient(90deg, rgba(62, 207, 142, 0.12) 0%, rgba(20, 184, 166, 0.05) 100%);
      border: 1px solid rgba(62, 207, 142, 0.25);
      border-radius: 14px;
      padding: 16px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 32px;
      flex-wrap: wrap;
    }
    .academy-vip-text {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .academy-vip-title {
      font-size: 14.5px;
      font-weight: 700;
      color: var(--text-bright);
    }
    .academy-vip-sub {
      font-size: 12.5px;
      color: var(--muted);
    }
    .academy-vip-form {
      display: flex;
      gap: 8px;
    }
    .academy-vip-input {
      height: 38px;
      background: #090D16;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text-bright);
      padding: 0 12px;
      font-size: 13px;
      width: 160px;
    }

    .academy-categories {
      display: flex;
      gap: 10px;
      margin-bottom: 28px;
      overflow-x: auto;
      padding-bottom: 8px;
    }
    .cat-pill {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--muted);
      padding: 8px 16px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
    }
    .cat-pill:hover, .cat-pill.active {
      background: rgba(62, 207, 142, 0.15);
      border-color: rgba(62, 207, 142, 0.4);
      color: var(--primary);
    }

    .courses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }
    .course-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 18px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .course-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-3px);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.4);
    }
    .course-cover {
      height: 140px;
      background: linear-gradient(135deg, #182238 0%, #0D1322 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      border-bottom: 1px solid var(--border);
    }
    .course-cover-icon {
      width: 54px;
      height: 54px;
      border-radius: 16px;
      background: rgba(62, 207, 142, 0.15);
      border: 1px solid rgba(62, 207, 142, 0.3);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .course-badge-level {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(8px);
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      padding: 3px 8px;
      border-radius: 6px;
      border: 1px solid var(--border);
    }
    .course-body {
      padding: 20px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }
    .course-title {
      font-size: 16.5px;
      font-weight: 800;
      color: var(--text-bright);
      margin-bottom: 8px;
      line-height: 1.3;
    }
    .course-desc {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.5;
      margin-bottom: 16px;
      flex-grow: 1;
    }
    .course-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border);
      padding-top: 14px;
      font-size: 12px;
      color: var(--muted);
    }
    .course-preview-tag {
      color: var(--primary);
      font-weight: 700;
    }

    /* Modal DocentOS Player */
    .docentos-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(12px);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .docentos-modal {
      width: 100%;
      max-width: 980px;
      background: #0D1322;
      border: 1px solid rgba(62, 207, 142, 0.3);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
      display: flex;
      flex-direction: column;
      max-height: 90vh;
    }
    .docentos-header {
      padding: 16px 20px;
      background: #090D16;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .docentos-header h3 {
      font-size: 16px;
      font-weight: 800;
      color: var(--text-bright);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .docentos-close {
      background: transparent;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 6px;
      border-radius: 6px;
    }
    .docentos-close:hover { color: #fff; background: rgba(255,255,255,0.06); }
    .docentos-body {
      display: grid;
      grid-template-columns: 1fr 340px;
      overflow: hidden;
      flex-grow: 1;
    }
    .docentos-video-pane {
      background: #000;
      display: flex;
      flex-direction: column;
    }
    .docentos-iframe-box {
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #050508;
    }
    .docentos-iframe-box iframe {
      width: 100%;
      height: 100%;
      border: none;
    }
    .docentos-info {
      padding: 20px;
      background: #0B0F19;
      flex-grow: 1;
      overflow-y: auto;
    }
    .docentos-curriculum-pane {
      background: #090D16;
      border-left: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }
    .curriculum-header {
      padding: 14px 16px;
      font-size: 13px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--border);
    }
    .lesson-item {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: flex-start;
      gap: 10px;
      cursor: pointer;
      transition: background 0.15s ease;
    }
    .lesson-item:hover, .lesson-item.active {
      background: rgba(62, 207, 142, 0.08);
    }
    .lesson-item.locked {
      opacity: 0.6;
    }
    .lesson-num {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.06);
      font-size: 11px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      flex-shrink: 0;
    }
    .lesson-title-text {
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
      line-height: 1.35;
    }
    .lesson-duration {
      font-size: 11px;
      color: var(--muted);
      margin-top: 3px;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    /* Footer */
    .footer {
      border-top: 1px solid var(--border);
      background: #060910;
      padding: 50px 0 30px;
    }
    .footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 30px;
      flex-wrap: wrap;
      margin-bottom: 40px;
    }
    .footer-brand {
