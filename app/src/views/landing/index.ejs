  <!-- ==========================================
       JAVASCRIPT INTERACTIVO
       ========================================== -->
  <script>
    // Datos de cursos y lecciones inyectados desde el servidor
    var CURSOS = <%- JSON.stringify(cursos || []) %>;
    var LECCIONES_MAP = <%- JSON.stringify(leccionesPorCurso || {}) %>;
    var socioVipDni = localStorage.getItem('gym_socio_dni') || '';
    var socioVipNombre = localStorage.getItem('gym_socio_nombre') || '';

    // Si ya validó su DNI anteriormente, restaurar feedback
    if (socioVipDni && socioVipNombre) {
      actualizarFeedbackVip(true, 'Bienvenido nuevamente ' + socioVipNombre + ' (Acceso VIP Activo a la Academia)');
    }

    // Calculadora Fitness en tiempo real
    function calcularFitness() {
      var peso = parseFloat(document.getElementById('calc-peso').value) || 70;
      var altura = parseFloat(document.getElementById('calc-altura').value) || 172;
      var genero = document.getElementById('calc-genero').value;
      var objetivo = document.getElementById('calc-objetivo').value;

      var alturaM = altura / 100;
      var imc = peso / (alturaM * alturaM);
      var imcRedondeado = imc.toFixed(1);
      document.getElementById('res-imc').textContent = imcRedondeado;

      var estadoEl = document.getElementById('res-estado');
      if (imc < 18.5) {
        estadoEl.textContent = 'Bajo Peso';
        estadoEl.style.color = '#F59E0B';
      } else if (imc <= 24.9) {
        estadoEl.textContent = 'Peso Saludable / Óptimo';
        estadoEl.style.color = '#3ECF8E';
      } else if (imc <= 29.9) {
        estadoEl.textContent = 'Sobrepeso Ligero';
        estadoEl.style.color = '#F59E0B';
      } else {
        estadoEl.textContent = 'Obesidad / Grasa Elevada';
        estadoEl.style.color = '#EF4444';
      }

      // Cálculo TMB Harris-Benedict simplificado
      var tmb = genero === 'M' 
        ? (10 * peso) + (6.25 * altura) - (5 * 25) + 5 
        : (10 * peso) + (6.25 * altura) - (5 * 25) - 161;
      
      var gastoTotal = tmb * 1.5; // actividad moderada
      var caloriasObj = gastoTotal;
      if (objetivo === 'perder_grasa') caloriasObj -= 400;
      if (objetivo === 'ganar_musculo') caloriasObj += 300;

      document.getElementById('res-calorias').textContent = Math.round(caloriasObj) + ' kcal';
      var proteina = Math.round(peso * 2.0);
      document.getElementById('res-proteina').textContent = proteina + ' g';
      var agua = (peso * 0.04).toFixed(1);
      document.getElementById('res-agua').textContent = agua + ' L';
    }

    // Filtros de categoría de cursos
    function filtrarCursos(cat, btn) {
      document.querySelectorAll('.cat-pill').forEach(function(b) { b.classList.remove('active'); });
      if (btn) btn.classList.add('active');

      var cards = document.querySelectorAll('.course-card');
      cards.forEach(function(card) {
        if (cat === 'todos' || card.getAttribute('data-cat') === cat) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Validación DNI de socio VIP
    function validarDniAcademia(e) {
      e.preventDefault();
      var input = document.getElementById('vip-dni-input');
      var btn = document.getElementById('vip-dni-btn');
      var dni = input.value.trim();
      if (!dni) return;

      btn.disabled = true;
      btn.textContent = 'Verificando...';

      fetch('/api/academia/validar-acceso', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ dni: dni })
      })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        btn.disabled = false;
        btn.textContent = 'Desbloquear';

        if (res.ok && res.socio) {
          socioVipDni = res.socio.dni;
          socioVipNombre = res.socio.nombres;
          localStorage.setItem('gym_socio_dni', socioVipDni);
          localStorage.setItem('gym_socio_nombre', socioVipNombre);
          actualizarFeedbackVip(true, res.mensaje);
        } else {
          actualizarFeedbackVip(false, res.mensaje || 'DNI no admitido.');
        }
      })
      .catch(function(err) {
        btn.disabled = false;
        btn.textContent = 'Desbloquear';
        actualizarFeedbackVip(false, 'Error de conexión: ' + err.message);
      });
    }

    function actualizarFeedbackVip(exito, msg) {
      var box = document.getElementById('vip-dni-feedback');
      box.textContent = msg;
      box.style.display = 'block';
      if (exito) {
        box.style.background = 'rgba(62, 207, 142, 0.15)';
        box.style.border = '1px solid rgba(62, 207, 142, 0.4)';
        box.style.color = '#3ECF8E';
      } else {
        box.style.background = 'rgba(239, 68, 68, 0.15)';
        box.style.border = '1px solid rgba(239, 68, 68, 0.4)';
        box.style.color = '#F87171';
      }
    }

    // Modal Reproductor DocentOS
    var cursoActivo = null;
    var leccionesActivas = [];

    function abrirModalCurso(cursoId) {
      cursoActivo = CURSOS.find(function(c) { return c.id === cursoId; });
      if (!cursoActivo) return;

      leccionesActivas = LECCIONES_MAP[cursoId] || [];
      document.getElementById('modal-curso-titulo').querySelector('span').textContent = cursoActivo.titulo;

      var listaEl = document.getElementById('modal-lecciones-lista');
      listaEl.innerHTML = '';

      leccionesActivas.forEach(function(lec, idx) {
        var puedeVer = lec.es_preview || Boolean(socioVipDni);
        var item = document.createElement('div');
        item.className = 'lesson-item' + (puedeVer ? '' : ' locked') + (idx === 0 ? ' active' : '');
        item.onclick = function() { reproducirLeccion(idx); };

        item.innerHTML = 
          '<div class="lesson-num">' + (idx + 1) + '</div>' +
          '<div style="flex-grow:1;">' +
            '<div class="lesson-title-text">' + lec.titulo + '</div>' +
            '<div class="lesson-duration">' +
              (lec.es_preview ? '<span style="color:#3ECF8E; font-weight:700;">Clase Abierta</span> · ' : '<span style="color:#F59E0B;">Socio Activo</span> · ') +
              lec.duracion_minutos + ' min' +
            '</div>' +
          '</div>';
        
        listaEl.appendChild(item);
      });

      if (leccionesActivas.length > 0) {
        reproducirLeccion(0);
      }

      document.getElementById('modal-docentos').style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function reproducirLeccion(idx) {
      var lec = leccionesActivas[idx];
      if (!lec) return;

      var items = document.querySelectorAll('.lesson-item');
      items.forEach(function(it, i) {
        it.classList.toggle('active', i === idx);
      });

      var puedeVer = lec.es_preview || Boolean(socioVipDni);
      var iframe = document.getElementById('modal-video-iframe');

      document.getElementById('modal-leccion-titulo').textContent = lec.titulo;
      document.getElementById('modal-leccion-desc').textContent = lec.descripcion || 'Sin descripción adicional.';

      var recursoBox = document.getElementById('modal-recurso-box');
      if (lec.recurso_nombre && puedeVer) {
        document.getElementById('modal-recurso-nombre').textContent = lec.recurso_nombre;
        document.getElementById('modal-recurso-link').href = lec.recurso_descarga || '#';
        recursoBox.style.display = 'flex';
      } else {
        recursoBox.style.display = 'none';
      }

      if (puedeVer) {
        iframe.src = lec.video_url || 'https://www.youtube.com/embed/S2oW0jMhWb0';
      } else {
        iframe.src = 'about:blank';
        alert('Esta clase requiere que ingreses tu DNI de socio con membresía activa.');
      }
    }

    function cerrarModalCurso() {
      document.getElementById('modal-docentos').style.display = 'none';
      document.getElementById('modal-video-iframe').src = '';
      document.body.style.overflow = '';
    }

    // Inicializar calculadora
    calcularFitness();
  </script>
</body>
</html>
