<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    :root {
      color-scheme: dark;
      --bg: #090D16;
      --bg-alt: #0D1322;
      --surface: #121829;
      --surface-2: #182238;
      --border: rgba(255, 255, 255, 0.08);
      --border-hover: rgba(62, 207, 142, 0.35);
      --primary: #3ECF8E;
      --primary-hover: #32b57a;
      --primary-glow: rgba(62, 207, 142, 0.25);
      --text: #EDEDED;
      --text-bright: #FFFFFF;
      --muted: #9CA3AF;
      --card-bg: rgba(18, 24, 41, 0.7);
      --font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg);
      background-image: 
        radial-gradient(at 0% 0%, rgba(62, 207, 142, 0.1) 0px, transparent 40%),
        radial-gradient(at 100% 50%, rgba(16, 185, 129, 0.06) 0px, transparent 40%);
      color: var(--text);
      font-family: var(--font);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .container {
      width: 100%;
      max-width: 1220px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Navbar */
    .navbar {
      background: rgba(9, 13, 22, 0.9);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .navbar-inner {
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-bright);
    }
    .brand-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: rgba(62, 207, 142, 0.12);
      border: 1px solid rgba(62, 207, 142, 0.35);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 10px var(--primary-glow);
    }
    .brand-title {
      font-size: 16.5px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .brand-sub {
      font-size: 11px;
      color: var(--primary);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .nav-user {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .user-pill {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      padding: 6px 14px;
      border-radius: 30px;
    }
    .user-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: var(--surface-2);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      font-weight: 800;
      font-size: 13px;
    }
    .user-name {
      font-size: 13.5px;
      font-weight: 700;
      color: #fff;
    }
    .membership-badge {
      font-size: 11px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 6px;
    }
    .membership-badge.activo {
      background: rgba(62, 207, 142, 0.15);
      color: #3ECF8E;
      border: 1px solid rgba(62, 207, 142, 0.35);
    }
    .membership-badge.vencido {
      background: rgba(239, 68, 68, 0.15);
      color: #F87171;
      border: 1px solid rgba(239, 68, 68, 0.35);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 9px 16px;
      border-radius: 9px;
      font-size: 13.5px;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.18s ease;
      border: 1px solid transparent;
    }
    .btn.primary {
      background: var(--primary);
      color: #05160E;
      box-shadow: 0 4px 14px var(--primary-glow);
    }
    .btn.primary:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
    }
    .btn.outline {
      background: var(--surface);
      border-color: var(--border);
      color: var(--text);
    }
    .btn.outline:hover {
      border-color: rgba(255, 255, 255, 0.2);
      color: #fff;
    }
    .btn.sm {
      padding: 6px 12px;
      font-size: 12.5px;
    }

    /* Main Content */
    .portal-main {
      flex-grow: 1;
      padding: 40px 0 60px;
    }

    /* Hero Banner */
    .hero-banner {
      background: linear-gradient(135deg, rgba(18, 24, 41, 0.9), rgba(13, 19, 34, 0.8));
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px;
      margin-bottom: 36px;
      position: relative;
      overflow: hidden;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 24px;
      align-items: center;
    }
    .hero-banner::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: 4px;
      background: var(--primary);
    }
    .hero-title {
      font-size: 24px;
      font-weight: 800;
      color: #fff;
      margin-bottom: 8px;
      letter-spacing: -0.02em;
    }
    .hero-desc {
      font-size: 14px;
      color: var(--muted);
      max-width: 600px;
      line-height: 1.5;
    }

    .hero-stats {
      display: flex;
      gap: 24px;
      background: rgba(9, 13, 22, 0.6);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 24px;
    }
    .stat-item {
      display: flex;
      flex-direction: column;
    }
    .stat-val {
      font-size: 22px;
      font-weight: 800;
      color: var(--primary);
      line-height: 1.2;
    }
    .stat-lbl {
      font-size: 11.5px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Section Heading */
    .section-title-wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }
    .section-title {
      font-size: 20px;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Resume Card */
    .resume-card {
      background: rgba(62, 207, 142, 0.06);
      border: 1px solid rgba(62, 207, 142, 0.25);
      border-radius: 16px;
      padding: 20px 24px;
      margin-bottom: 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .resume-info {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .resume-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--primary);
      color: #05160E;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 4px 16px var(--primary-glow);
    }
    .resume-title {
      font-size: 15.5px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 3px;
    }
    .resume-course {
      font-size: 12.5px;
      color: var(--muted);
    }

    /* Courses Grid */
    .courses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 24px;
    }
    .course-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 18px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.22s ease;
      position: relative;
    }
    .course-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-2px);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
    }
    .course-cover {
      height: 120px;
      background: linear-gradient(135deg, #101726, #0A0E18);
      border-bottom: 1px solid var(--border);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .course-cover-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: rgba(62, 207, 142, 0.1);
      border: 1px solid rgba(62, 207, 142, 0.25);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .course-badge-level {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(9, 13, 22, 0.7);
      backdrop-filter: blur(8px);
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      padding: 3px 8px;
      border-radius: 6px;
      border: 1px solid var(--border);
    }
    .course-body {
      padding: 22px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }
    .course-title {
      font-size: 16.5px;
      font-weight: 800;
      color: #fff;
      margin-bottom: 8px;
      line-height: 1.3;
    }
    .course-desc {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.5;
      margin-bottom: 18px;
      flex-grow: 1;
    }

    /* Progress bar */
    .progress-wrap {
      margin-bottom: 18px;
    }
    .progress-header {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 6px;
      color: var(--muted);
    }
    .progress-header span:last-child {
      color: var(--primary);
    }
    .progress-track {
      width: 100%;
      height: 7px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 10px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      background: var(--primary);
      border-radius: 10px;
      transition: width 0.3s ease;
    }

    .course-footer {
      border-top: 1px solid var(--border);
      padding-top: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .course-meta-text {
      font-size: 12px;
      color: var(--muted);
    }

    @media (max-width: 768px) {
      .hero-banner { grid-template-columns: 1fr; }
      .resume-card { flex-direction: column; align-items: flex-start; }
      .navbar-inner { height: auto; padding: 14px 0; flex-wrap: wrap; gap: 12px; }
    }
  </style>
</head>
<body>

  <!-- Top Navbar -->
  <header class="navbar">
    <div class="container navbar-inner">
      <a href="/" class="brand">
        <div class="brand-icon">
          <%- u.icon('cup', 20) %>
        </div>
        <div>
          <div class="brand-title"><%= gymName %></div>
          <div class="brand-sub">DocentOS Academy</div>
        </div>
      </a>

      <div class="nav-user">
        <div class="user-pill">
          <div class="user-avatar">
            <%= (socio.nombres || 'A')[0].toUpperCase() %>
          </div>
          <div>
            <div class="user-name"><%= socio.nombres %> <%= socio.apellidos %></div>
            <div style="font-size:11px; color:var(--muted);">DNI: <%= socio.dni %></div>
          </div>
          <span class="membership-badge <%= socio.estado_membresia %>">
            <%= socio.estado_membresia === 'activo' ? 'Plan Activo' : 'Membresía ' + socio.estado_membresia %>
          </span>
        </div>

        <a href="/" class="btn outline sm">
          <%- u.icon('arrowLeft', 13) %> Web Principal
        </a>
        <a href="/academia/logout" class="btn outline sm" title="Cerrar Sesión">
          <%- u.icon('logout', 14) %> Salir
        </a>
      </div>
    </div>
  </header>

  <main class="portal-main">
    <div class="container">

      <!-- Hero Banner -->
      <div class="hero-banner">
        <div>
          <h1 class="hero-title">¡Hola, <%= socio.nombres %>!</h1>
          <p class="hero-desc">
            Bienvenido a tu plataforma privada de capacitación continua. Explora los módulos de nutrición deportiva, biomecánica y suplementación incluidos en tu membresía.
          </p>
          <% if (socio.estado_membresia !== 'activo') { %>
            <div style="margin-top:14px;">
              <a href="/#planes" class="btn primary sm">
                <%- u.icon('zap', 14) %> Renovar Membresía para Desbloquear Todo
              </a>
            </div>
          <% } %>
        </div>

        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-val"><%= stats.totalCompletadas %></span>
            <span class="stat-lbl">Lecciones Vistas</span>
          </div>
          <div class="stat-item">
            <span class="stat-val"><%= stats.porcentajeGlobal %>%</span>
            <span class="stat-lbl">Avance Global</span>
          </div>
        </div>
      </div>

      <!-- Tarjeta Reanudar última lección si existe -->
      <% if (ultimaLeccion) { %>
        <div class="resume-card">
          <div class="resume-info">
            <div class="resume-icon">
              <%- u.icon('play', 20) %>
            </div>
            <div>
              <div class="resume-title">Continuar donde lo dejaste: <%= ultimaLeccion.leccion_titulo %></div>
              <div class="resume-course">Curso: <%= ultimaLeccion.curso_titulo %></div>
            </div>
          </div>
          <a href="/academia/curso/<%= ultimaLeccion.curso_slug %>?leccion=<%= ultimaLeccion.leccion_id %>" class="btn primary">
            <%- u.icon('play', 14) %> Continuar Lección
          </a>
        </div>
      <% } %>

      <!-- Catálogo de Cursos -->
      <div class="section-title-wrap">
        <h2 class="section-title">
          <%- u.icon('book', 20) %> Cursos Disponibles en Tu Plan
        </h2>
        <span style="font-size:13px; color:var(--muted);">
          <%= cursos.length %> módulos interactivos
        </span>
      </div>

      <div class="courses-grid">
        <% cursos.forEach(function(c) { %>
          <div class="course-card">
            <div class="course-cover">
              <div class="course-cover-icon">
                <%- u.icon(c.icono || 'dumbbell', 24) %>
              </div>
              <span class="course-badge-level"><%= c.nivel %></span>
            </div>

            <div class="course-body">
              <h3 class="course-title"><%= c.titulo %></h3>
              <p class="course-desc"><%= c.descripcion %></p>

              <!-- Barra de Progreso Personal -->
              <div class="progress-wrap">
                <div class="progress-header">
                  <span><%= c.lecciones_completadas %> de <%= c.total_lecciones %> lecciones</span>
                  <span><%= c.porcentaje_progreso %>%</span>
                </div>
                <div class="progress-track">
                  <div class="progress-fill" style="width: <%= c.porcentaje_progreso %>%;"></div>
                </div>
              </div>

              <div class="course-footer">
                <span class="course-meta-text">
                  <%- u.icon('clock', 12) %> <%= c.duracion_total_minutos %> min en video
                </span>
                <a href="/academia/curso/<%= c.slug %>" class="btn <%= c.porcentaje_progreso > 0 ? 'primary' : 'outline' %> sm">
                  <%- u.icon('play', 12) %> <%= c.porcentaje_progreso > 0 ? 'Continuar' : 'Entrar al Aula' %>
                </a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>

    </div>
  </main>

</body>
</html>
