<h1>Mensajes y Recordatorios</h1>
<p class="muted">
  Envío directo desde el servidor por WhatsApp. Haz clic en <strong>Enviar Directo</strong> para mandar el mensaje al socio en 1 segundo sin abrir pestañas ni WhatsApp Web. Puedes verificar el estado de conexión en <a href="/whatsapp" style="font-weight:600;">Estado de WhatsApp</a>.
</p>

<div class="actions" style="margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap;">
  <form method="post" action="/mensajes/ejecutar-cron" style="margin:0;">
    <input type="hidden" name="tipo" value="vencimiento">
    <button type="submit" class="btn primary sm" style="display:inline-flex; align-items:center; gap:6px;">
      <%- u.icon('whatsapp', 14) %> Enviar Recordatorios Pendientes Ahora
    </button>
  </form>
  <form method="post" action="/mensajes/ejecutar-cron" style="margin:0;">
    <input type="hidden" name="tipo" value="cumpleanos">
    <button type="submit" class="btn sm" style="display:inline-flex; align-items:center; gap:6px;">
      🎂 Saludar Cumpleañeros
    </button>
  </form>
  <form method="post" action="/mensajes/ejecutar-cron" style="margin:0;">
    <input type="hidden" name="tipo" value="vencidas">
    <button type="submit" class="btn sm" style="display:inline-flex; align-items:center; gap:6px;">
      🔄 Actualizar Membresías Vencidas
    </button>
  </form>
</div>

<% if (sinPlantilla.length) { %>
  <div class="flash info">Faltan plantillas: <%= sinPlantilla.join(', ') %>. Crealas en <a href="/plantillas">Plantillas</a>.</div>
<% } %>

<% grupos.forEach(function(g){ %>
  <h2><%= g.titulo %> <span class="muted">(<%= g.items.length %>)</span></h2>
  <div class="card">
    <% if (!g.items.length) { %>
      <p class="muted mb0">Nada pendiente.</p>
    <% } else { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Socio</th><th>Detalle</th><th>Mensaje</th><th class="right">Acción</th></tr></thead>
      <tbody>
      <% g.items.forEach(function(it){ %>
        <tr>
          <td><a href="/socios/<%= it.socio_id %>" style="font-weight:600;"><%= it.nombre %></a><br><span class="muted"><%= it.telefono || 'sin telefono' %></span></td>
          <td class="muted"><%= it.info %></td>
          <td style="max-width:340px;"><span class="muted" style="font-size:13px;"><%= it.contenido %></span></td>
          <td class="actions right">
            <% if (it.link) { %>
              <div style="display:flex; align-items:center; justify-content:flex-end; gap:8px;">
                <form method="post" action="/mensajes/enviar-directo" style="margin:0;">
                  <input type="hidden" name="socio_id" value="<%= it.socio_id %>">
                  <input type="hidden" name="telefono" value="<%= it.telefono || '' %>">
                  <input type="hidden" name="plantilla_clave" value="<%= it.clave %>">
                  <input type="hidden" name="contenido" value="<%= it.contenido %>">
                  <button class="btn sm wa" type="submit" style="font-weight:600; display:inline-flex; align-items:center; gap:5px;">
                    <%- u.icon('whatsapp', 14) %> Enviar Directo
                  </button>
                </form>
                <a class="muted" href="<%= it.link %>" target="_blank" rel="noopener" style="font-size:11px; text-decoration:underline;" title="Abrir en WhatsApp Web en una pestaña si el servidor no está vinculado">web</a>
              </div>
            <% } else { %>
              <span class="muted">sin teléfono</span>
            <% } %>
          </td>
        </tr>
      <% }); %>
      </tbody>
    </table></div>
    <% } %>
  </div>
<% }); %>

<h2>Historial</h2>
<div class="card">
  <% if (!historial.length) { %><p class="muted mb0">Sin mensajes registrados.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Fecha</th><th>Socio</th><th>Plantilla</th><th>Estado</th></tr></thead>
    <tbody>
    <% historial.forEach(function(m){ %>
      <tr>
        <td><%= u.fechaHora(m.creado_en) %></td>
        <td><%= m.apellidos ? m.apellidos + ', ' + m.nombres : (m.telefono || '—') %></td>
        <td><%= m.plantilla_clave || '—' %></td>
        <td><span class="badge <%= m.estado==='fallido'?'danger':(m.estado==='pendiente'?'muted':'ok') %>"><%= m.estado %></span></td>
      </tr>
    <% }); %>
    </tbody>
  </table></div>
  <% } %>
</div>
