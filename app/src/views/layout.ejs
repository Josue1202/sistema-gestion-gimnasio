<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Gimnasio</title>
  <link rel="stylesheet" href="/public/styles.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏋️</text></svg>">
</head>
<body>
  <% const nav = [
    ['/dashboard','Inicio'],
    ['/socios','Socios'],
    ['/asistencia','Asistencia'],
    ['/caja','Caja'],
    ['/productos','Productos'],
    ['/reportes','Reportes'],
    ['/mensajes','Mensajes'],
    ['/planes','Planes'],
    ['/plantillas','Plantillas'],
  ]; %>
  <nav class="nav">
    <span class="brand">🏋️ Gimnasio</span>
    <% nav.forEach(function(it){ %>
      <a class="item <%= currentPath.indexOf(it[0]) === 0 ? 'active' : '' %>" href="<%= it[0] %>"><%= it[1] %></a>
    <% }); %>
    <span class="spacer"></span>
    <span class="who"><%= user ? user.nombre : '' %></span>
    <form method="post" action="/logout" style="margin:0 0 0 10px;">
      <button class="btn sm" type="submit">Salir</button>
    </form>
  </nav>

  <main class="wrap">
    <% flash.forEach(function(f){ %>
      <div class="flash <%= f.type %>"><%= f.msg %></div>
    <% }); %>
    <%- body %>
  </main>
</body>
</html>
