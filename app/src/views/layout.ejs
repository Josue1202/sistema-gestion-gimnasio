<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= gymName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/styles.css?v=20261006_combos_v4">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%233ECF8E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M6.5 6.5h-1a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2V8.5a2 2 0 0 0-2-2zm11 0h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2V8.5a2 2 0 0 1 2-2zM8.5 12h7M2 10v4M22 10v4'/%3E%3C/svg%3E">
</head>
<body>
  <% 
    const currentP = currentPath || '';
    const navGroups = [
      {
        tipo: 'link',
        url: '/dashboard',
        label: 'Inicio',
        icon: 'dashboard',
        active: currentP === '/dashboard' || currentP === '/'
      },
      {
        tipo: 'dropdown',
        label: 'Operaciones',
        icon: 'terminal',
        active: currentP.startsWith('/asistencia') || currentP.startsWith('/caja') || currentP.startsWith('/socios'),
        items: [
          {
            url: '/asistencia',
            label: 'Terminal POS',
            desc: 'Check-in de asistencia y ventas en 1-clic',
            icon: 'terminal',
            active: currentP.startsWith('/asistencia')
          },
          {
            url: '/caja',
            label: 'Caja del Día',
            desc: 'Apertura de turno, gastos y cuadre final',
            icon: 'caja',
            active: currentP.startsWith('/caja')
          },
          {
            url: '/socios',
            label: 'Directorio de Socios',
            desc: 'Gestión de clientes, fichas y membresías',
            icon: 'socios',
            active: currentP.startsWith('/socios')
          }
        ]
      },
      {
        tipo: 'dropdown',
        label: 'Catálogo & Finanzas',
        icon: 'productos',
        active: currentP.startsWith('/productos') || currentP.startsWith('/planes') || currentP.startsWith('/reportes'),
        items: [
          {
            url: '/productos',
            label: 'Inventario de Productos',
            desc: 'Bebidas, suplementos y control de existencias',
            icon: 'productos',
            active: currentP.startsWith('/productos')
          },
          {
            url: '/planes',
            label: 'Planes & Tarifas',
            desc: 'Membresías diarias, mensuales y precios',
            icon: 'planes',
            active: currentP.startsWith('/planes')
          },
          {
            url: '/reportes',
            label: 'Reportes & Métricas',
            desc: 'Ingresos mensuales, medios de pago y retención',
            icon: 'reportes',
            active: currentP.startsWith('/reportes')
          }
        ]
      },
      {
        tipo: 'dropdown',
        label: 'Comunicación',
        icon: 'whatsapp',
        active: currentP.startsWith('/mensajes') || currentP.startsWith('/plantillas') || currentP.startsWith('/whatsapp'),
        items: [
          {
            url: '/mensajes',
            label: 'Mensajes & Recordatorios',
            desc: 'Avisos directos de vencimiento por WhatsApp',
            icon: 'mensajes',
            active: currentP.startsWith('/mensajes')
          },
          {
            url: '/plantillas',
            label: 'Plantillas de Mensajes',
            desc: 'Textos automáticos de bienvenida y cobranza',
            icon: 'plantillas',
            active: currentP.startsWith('/plantillas')
          },
          {
            url: '/whatsapp',
            label: 'Conexión WhatsApp',
            desc: 'Sincronización QR del servidor y estado del canal',
            icon: 'whatsapp',
            active: currentP.startsWith('/whatsapp')
          }
        ]
      }
    ];
  %>
  
  <header class="navbar-wrapper">
    <div class="supabase-top-bar"></div>
    <nav class="nav">
      <a href="/dashboard" class="brand">
        <span class="brand-icon"><%- u.icon('gym', 22) %></span>
        <span class="brand-name"><%= gymName %></span>
        <span class="brand-badge-pro">PRO</span>
      </a>

      <!-- Botón móvil para menú -->
      <button class="mobile-toggle" id="mobile-menu-btn" aria-label="Abrir menú" onclick="document.querySelector('.nav-items').classList.toggle('open');">
        <%- u.icon('dashboard', 18) %>
      </button>

      <div class="nav-items">
        <% navGroups.forEach(function(g){ %>
          <% if (g.tipo === 'link') { %>
            <a class="item <%= g.active ? 'active' : '' %>" href="<%= g.url %>">
              <span class="nav-ico"><%- u.icon(g.icon, 15) %></span>
              <span><%= g.label %></span>
            </a>
          <% } else { %>
            <div class="nav-dropdown">
              <button type="button" class="nav-dropdown-trigger <%= g.active ? 'active' : '' %>" aria-expanded="false">
                <span class="nav-ico"><%- u.icon(g.icon, 15) %></span>
                <span><%= g.label %></span>
                <span class="nav-dropdown-chevron">▼</span>
              </button>
              <div class="nav-dropdown-menu">
                <% g.items.forEach(function(it){ %>
                  <a href="<%= it.url %>" class="nav-dropdown-item <%= it.active ? 'active' : '' %>">
                    <div class="nav-dropdown-icon">
                      <%- u.icon(it.icon, 16) %>
                    </div>
                    <div class="nav-dropdown-text">
                      <span class="nav-dropdown-title"><%= it.label %></span>
                      <span class="nav-dropdown-desc"><%= it.desc %></span>
                    </div>
                  </a>
                <% }); %>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>

      <span class="spacer"></span>

      <!-- Estado de WhatsApp en vivo -->
      <a href="/whatsapp" id="nav-wa-pill" class="wa-status-pill loading" title="Ver estado de conexión de WhatsApp">
        <span class="wa-dot"></span>
        <span class="wa-txt">WhatsApp</span>
      </a>

      <div class="user-profile">
        <span class="user-badge"><%= user ? user.nombre.slice(0, 2).toUpperCase() : 'AD' %></span>
        <span class="who"><%= user ? user.nombre : '' %></span>
        <form method="post" action="/logout" style="margin:0 0 0 8px;">
          <button class="btn sm danger" type="submit" title="Cerrar sesión">
            <%- u.icon('logout', 13) %> Salir
          </button>
        </form>
      </div>
    </nav>
  </header>

  <main class="wrap">
    <% flash.forEach(function(f){ %>
      <div class="flash <%= f.type %>">
        <span class="flash-icon" style="display:inline-flex; align-items:center;">
          <% if (f.type === 'ok') { %><%- u.icon('checkCircle', 16) %><% } else if (f.type === 'error') { %><%- u.icon('closeCircle', 16) %><% } else { %><%- u.icon('alertCircle', 16) %><% } %>
        </span>
        <span><%= f.msg %></span>
      </div>
    <% }); %>
    <%- body %>
  </main>

  <script>
    // Sistema Global de Modales Flotantes Supabase
    window.abrirModal = function(id) {
      var m = typeof id === 'string' ? document.getElementById(id) : id;
      if (m) {
        m.style.setProperty('display', 'flex', 'important');
        m.classList.add('open');
        document.body.style.overflow = 'hidden';
        var inp = m.querySelector('input:not([type=hidden]), select, textarea');
        if (inp) setTimeout(function(){ inp.focus(); }, 60);
      }
    };

    window.cerrarModal = function(id) {
      var m = typeof id === 'string' ? document.getElementById(id) : id;
      if (m) {
        m.style.setProperty('display', 'none', 'important');
        m.classList.remove('open');
        document.body.style.overflow = '';
      }
    };

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        var open = document.querySelectorAll('.modal-backdrop.open, .modal-backdrop[style*="display: flex"]');
        open.forEach(function(m) { window.cerrarModal(m); });
      }
    });

    // Monitor en segundo plano para el pill de WhatsApp en el navbar
    (function() {
      var pill = document.getElementById('nav-wa-pill');
      if (!pill) return;
      function checkWa() {
        fetch('/whatsapp/estado')
          .then(function(r) { return r.json(); })
          .then(function(d) {
            pill.classList.remove('loading', 'open', 'close', 'offline');
            if (d.ok && d.estado === 'open') {
              pill.classList.add('open');
              pill.querySelector('.wa-txt').textContent = 'WhatsApp Conectado';
            } else {
              pill.classList.add('close');
              pill.querySelector('.wa-txt').textContent = 'Vincular WhatsApp';
            }
          })
          .catch(function() {
            pill.classList.remove('loading');
            pill.classList.add('offline');
            pill.querySelector('.wa-txt').textContent = 'WhatsApp Off';
          });
      }
      checkWa();
      setInterval(checkWa, 15000);
    })();
  </script>
</body>
</html>
