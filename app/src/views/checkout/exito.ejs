<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%233ECF8E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M6.5 6.5h-1a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2V8.5a2 2 0 0 0-2-2zm11 0h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2V8.5a2 2 0 0 1 2-2zM8.5 12h7M2 10v4M22 10v4'/%3E%3C/svg%3E">

  <style>
    :root {
      --bg: #0b0f19;
      --card-bg: rgba(22, 27, 39, 0.85);
      --card-border: rgba(255, 255, 255, 0.1);
      --primary: #3ECF8E;
      --primary-glow: rgba(62, 207, 142, 0.3);
      --text: #F3F4F6;
      --text-muted: #9CA3AF;
      --font: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg);
      background-image: 
        radial-gradient(at 50% 0%, rgba(62, 207, 142, 0.2) 0px, transparent 60%),
        radial-gradient(at 100% 100%, rgba(116, 34, 132, 0.15) 0px, transparent 60%);
      color: var(--text);
      font-family: var(--font);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 30px 20px;
      -webkit-font-smoothing: antialiased;
    }

    .ticket-container {
      max-width: 520px;
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 28px;
      padding: 36px 32px;
      backdrop-filter: blur(20px);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 40px rgba(62, 207, 142, 0.1);
      position: relative;
      overflow: hidden;
    }

    .success-badge {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(62, 207, 142, 0.15);
      border: 2px solid var(--primary);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      box-shadow: 0 0 25px var(--primary-glow);
      animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popIn {
      0% { transform: scale(0.5); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    .ticket-title {
      text-align: center;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }
    .ticket-subtitle {
      text-align: center;
      color: var(--text-muted);
      font-size: 14px;
      margin-bottom: 28px;
    }

    /* Pass Box */
    .pass-box {
      background: rgba(15, 23, 42, 0.7);
      border: 1px dashed rgba(255, 255, 255, 0.18);
      border-radius: 20px;
      padding: 24px;
      margin-bottom: 24px;
      position: relative;
    }

    .pass-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 14px;
      margin-bottom: 16px;
    }
    .pass-gym-name {
      font-size: 15px;
      font-weight: 800;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .pass-badge-active {
      background: rgba(16, 185, 129, 0.2);
      color: #34D399;
      font-size: 11px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pass-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      font-size: 14px;
    }
    .pass-label {
      color: var(--text-muted);
    }
    .pass-val {
      font-weight: 700;
      color: #fff;
      text-align: right;
    }

    /* QR Code Display */
    .qr-container {
      text-align: center;
      padding: 18px 0 6px;
      border-top: 1px dashed rgba(255, 255, 255, 0.15);
      margin-top: 14px;
    }
    .qr-box {
      display: inline-block;
      padding: 12px;
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }
    .qr-caption {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 10px;
    }

    /* WhatsApp Notice */
    .wa-notice {
      background: rgba(37, 211, 102, 0.12);
      border: 1px solid rgba(37, 211, 102, 0.25);
      border-radius: 14px;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
      font-size: 13px;
      color: #A7F3D0;
    }

    /* Buttons */
    .action-btns {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .btn-action {
      padding: 14px 20px;
      border-radius: 12px;
      font-family: inherit;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      text-align: center;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .btn-primary {
      background: var(--primary);
      color: #0b0f19;
      border: none;
    }
    .btn-primary:hover {
      background: #34b37b;
      transform: translateY(-2px);
    }
    .btn-outline {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #fff;
    }
    .btn-outline:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    @media print {
      body { background: #fff; color: #000; }
      .ticket-container { border: 1px solid #ccc; box-shadow: none; background: #fff; color: #000; }
      .action-btns, .wa-notice { display: none; }
      .pass-val, .pass-label { color: #000 !important; }
    }
  </style>
</head>
<body>

  <div class="ticket-container">
    <div class="success-badge">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>

    <h1 class="ticket-title">¡Membresía Activada!</h1>
    <p class="ticket-subtitle">Tu pago ha sido procesado de forma automática y tu membresía está vigente.</p>

    <!-- Pass Box -->
    <div class="pass-box">
      <div class="pass-header">
        <div class="pass-gym-name"><%= gymName %></div>
        <div class="pass-badge-active">Pase Oficial Vigente</div>
      </div>

      <div class="pass-row">
        <span class="pass-label">Socio:</span>
        <span class="pass-val"><%= pago.nombres %> <%= pago.apellidos %></span>
      </div>

      <div class="pass-row">
        <span class="pass-label">Documento / DNI:</span>
        <span class="pass-val"><%= pago.dni %></span>
      </div>

      <div class="pass-row">
        <span class="pass-label">Plan Adquirido:</span>
        <span class="pass-val" style="color:var(--primary);"><%= pago.plan_nombre || pago.concepto %></span>
      </div>

      <div class="pass-row">
        <span class="pass-label">Vigencia del Plan:</span>
        <span class="pass-val"><%= fechaInicioTxt %> al <%= fechaFinTxt %></span>
      </div>

      <div class="pass-row">
        <span class="pass-label">Monto Pagado:</span>
        <span class="pass-val"><%= montoSoles %></span>
      </div>

      <div class="pass-row">
        <span class="pass-label">Método de Pago:</span>
        <span class="pass-val" style="text-transform:uppercase;"><%= pago.metodo_pago %></span>
      </div>

      <div class="pass-row">
        <span class="pass-label">Código de Operación:</span>
        <span class="pass-val" style="font-family:monospace; font-size:12px; color:#FBBF24;"><%= pago.referencia || pago.id.slice(0, 12) %></span>
      </div>

      <!-- Torniquete QR -->
      <div class="qr-container">
        <div class="qr-box">
          <!-- SVG QR Code dinamico generado con el DNI del socio -->
          <svg width="130" height="130" viewBox="0 0 100 100">
            <rect width="100" height="100" fill="#ffffff" />
            <!-- Patrones de esquinas (Finder patterns) -->
            <rect x="10" y="10" width="25" height="25" fill="#000" />
            <rect x="13" y="13" width="19" height="19" fill="#fff" />
            <rect x="16" y="16" width="13" height="13" fill="#000" />

            <rect x="65" y="10" width="25" height="25" fill="#000" />
            <rect x="68" y="13" width="19" height="19" fill="#fff" />
            <rect x="71" y="16" width="13" height="13" fill="#000" />

            <rect x="10" y="65" width="25" height="25" fill="#000" />
            <rect x="13" y="68" width="19" height="19" fill="#fff" />
            <rect x="16" y="71" width="13" height="13" fill="#000" />

            <!-- Modulos de datos -->
            <rect x="42" y="12" width="6" height="6" fill="#000" />
            <rect x="52" y="12" width="6" height="6" fill="#000" />
            <rect x="42" y="24" width="6" height="6" fill="#000" />
            <rect x="48" y="32" width="8" height="6" fill="#000" />
            <rect x="12" y="44" width="6" height="6" fill="#000" />
            <rect x="24" y="44" width="6" height="8" fill="#000" />
            <rect x="36" y="42" width="8" height="8" fill="#000" />
            <rect x="48" y="44" width="6" height="6" fill="#000" />
            <rect x="62" y="44" width="8" height="6" fill="#000" />
            <rect x="78" y="44" width="8" height="6" fill="#000" />
            <rect x="42" y="56" width="6" height="8" fill="#000" />
            <rect x="54" y="56" width="6" height="6" fill="#000" />
            <rect x="68" y="56" width="8" height="8" fill="#000" />
            <rect x="42" y="72" width="8" height="6" fill="#000" />
            <rect x="56" y="72" width="6" height="8" fill="#000" />
            <rect x="72" y="72" width="8" height="8" fill="#000" />
            <rect x="84" y="72" width="6" height="6" fill="#000" />
          </svg>
        </div>
        <div class="qr-caption">Presenta este código en el torniquete o recepción para ingresar.</div>
      </div>
    </div>

    <!-- WhatsApp notice -->
    <div class="wa-notice">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.78-1.48-1.76-1.65-2.06-.18-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.2-.25-.6-.49-.51-.67-.52l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35m-5.42 7.4a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37A9.86 9.86 0 0 1 2.17 12c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9A9.83 9.83 0 0 1 21.94 12c0 5.45-4.44 9.88-9.89 9.88"/>
      </svg>
      <div>
        <strong>Recibo Digital Enviado:</strong> Enviamos el comprobante y detalle de vigencia a tu WhatsApp (<%= pago.telefono ? ('+' + pago.telefono) : 'registrado' %>).
      </div>
    </div>

    <!-- Actions -->
    <div class="action-btns">
      <button type="button" class="btn-action btn-primary" onclick="window.print()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
        Descargar / Imprimir Pase Digital
      </button>

      <a href="/membresias" class="btn-action btn-outline">
        Volver a la Página Principal
      </a>
    </div>
  </div>

</body>
</html>
