<%
  var ini = (socio.nombres.charAt(0) + (socio.apellidos ? socio.apellidos.charAt(0) : '')).toUpperCase();
%>
<div class="toolbar">
  <div style="display:flex; align-items:center; gap:16px;">
    <div style="position:relative; width:72px; height:72px; border-radius:14px; background:#18181b; border:2px solid var(--border); overflow:hidden; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
      <% if (socio.foto_url) { %>
        <img id="detail-socio-foto" src="<%= socio.foto_url %>" alt="<%= socio.nombres %>" style="width:100%; height:100%; object-fit:cover;">
      <% } else { %>
        <div id="detail-socio-placeholder" style="color:var(--text-bright); font-weight:800; font-size:22px;">
          <%= ini %>
        </div>
      <% } %>
      <button type="button" onclick="abrirModalFotoRapida('<%= socio.id %>', '<%= socio.nombres %>');" title="Cambiar / Tomar Foto" style="position:absolute; bottom:0; right:0; width:26px; height:26px; background:rgba(0,0,0,0.75); border:none; border-radius:6px 0 0 0; color:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer;">
        <%- u.icon('camera', 13) %>
      </button>
    </div>
    <div>
      <h1 class="mb0" style="font-size:24px;"><%= socio.apellidos %>, <%= socio.nombres %></h1>
      <span class="muted">Registrado el <%= u.fecha(socio.fecha_registro) %></span>
    </div>
  </div>
  <div class="actions">
    <a class="btn primary" href="/suscripciones/nueva?socio=<%= socio.id %>" style="display:inline-flex; align-items:center; gap:6px;"><%- u.icon('card', 14) %> Renovar / Cobrar</a>
    <button class="btn" type="button" onclick="abrirModalFotoRapida('<%= socio.id %>', '<%= socio.nombres %>');" style="display:inline-flex; align-items:center; gap:6px;"><%- u.icon('camera', 14) %> Foto</button>
    <button class="btn" type="button" onclick="abrirModalSocioEditar();" style="display:inline-flex; align-items:center; gap:6px;"><%- u.icon('edit', 14) %> Editar Datos</button>
    <a class="btn" href="/socios">Volver al listado</a>
  </div>
</div>

<div class="row" style="margin-top:16px;">
  <div>
    <div class="card">
      <h2 class="mt0">Datos del Socio</h2>
      <table>
        <tr><th style="width:130px;">DNI / Documento</th><td><strong><%= socio.dni || '—' %></strong></td></tr>
        <tr><th>Teléfono (WhatsApp)</th><td><%= socio.telefono ? socio.telefono : '—' %></td></tr>
        <tr><th>Correo</th><td><%= socio.email || '—' %></td></tr>
        <tr><th>Fecha de Nacimiento</th><td><%= socio.fecha_nacimiento ? u.fecha(socio.fecha_nacimiento) : '—' %></td></tr>
        <tr><th>Contacto Emergencia</th><td><%= socio.contacto_emergencia_nombre || '—' %> <%= socio.contacto_emergencia_telefono ? '· ' + socio.contacto_emergencia_telefono : '' %></td></tr>
        <tr><th>Dirección</th><td><%= socio.direccion || '—' %></td></tr>
        <% if (socio.notas) { %><tr><th>Notas / Salud</th><td><%= socio.notas %></td></tr><% } %>
      </table>
    </div>
  </div>

  <div>
    <div class="card">
      <h2 class="mt0">Estado de Membresía</h2>
      <div style="font-size:18px; margin:8px 0 12px;">
        <% var est = estado.estado_membresia; %>
        <% if (est==='activo' && estado.dias_restantes != null && estado.dias_restantes <= 7) { %>
          <span class="badge warn" style="font-size:14px; padding:6px 12px; display:inline-flex; align-items:center; gap:6px;"><%- u.icon('alertCircle', 14) %> Vence en <%= estado.dias_restantes %> días</span>
        <% } else if (est==='activo') { %>
          <span class="badge ok" style="font-size:14px; padding:6px 12px; display:inline-flex; align-items:center; gap:6px;"><%- u.icon('checkCircle', 14) %> Activo (<%= estado.dias_restantes %> días restantes)</span>
        <% } else if (est==='vencido') { %>
          <span class="badge danger" style="font-size:14px; padding:6px 12px; display:inline-flex; align-items:center; gap:6px;"><%- u.icon('closeCircle', 14) %> Membresía Vencida</span>
        <% } else if (est==='congelado') { %>
          <span class="badge muted" style="font-size:14px; padding:6px 12px; display:inline-flex; align-items:center; gap:6px;"><%- u.icon('clock', 14) %> Congelado</span>
        <% } else { %>
          <span class="badge muted" style="font-size:14px; padding:6px 12px; display:inline-flex; align-items:center; gap:6px;"><%- u.icon('alertCircle', 14) %> Sin suscripción activa</span>
        <% } %>
      </div>

      <% if (estado.plan_nombre) { %>
        <p class="muted" style="margin-bottom:12px;">
          Plan actual: <strong><%= estado.plan_nombre %></strong> · Vence: <strong><%= u.fecha(estado.fecha_fin) %></strong>
        </p>
      <% } %>

      <div class="actions" style="margin-top:14px;">
        <a class="btn primary" href="/suscripciones/nueva?socio=<%= socio.id %>">Cobrar / Renovar Plan</a>
        <form method="post" action="/socios/<%= socio.id %>/asistencia" style="margin:0;">
          <button class="btn" type="submit" style="display:inline-flex; align-items:center; gap:6px;">
            <%- u.icon('zap', 14) %> Marcar asistencia ahora
          </button>
        </form>
      </div>

      <% if (!cajaAbierta) { %>
        <p class="muted" style="margin-top:10px; font-size:12px; color:var(--warn-ink); display:flex; align-items:center; gap:6px;">
          <%- u.icon('alert', 14) %> Aviso: La caja del día está cerrada. Los cobros no se registrarán en una caja abierta.
        </p>
      <% } %>
    </div>

    <!-- Enviar WhatsApp Rápido -->
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <h3 class="mt0 mb0" style="display:flex; align-items:center; gap:6px;">
          <%- u.icon('whatsapp', 16) %> Mensajes rápidos por WhatsApp
        </h3>
        <a href="/whatsapp" style="font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px;">
          <%- u.icon('settings', 13) %> Estado WhatsApp
        </a>
      </div>
      <% if (!socio.telefono) { %>
        <p class="muted mb0">El socio no tiene teléfono registrado para enviar WhatsApp.</p>
      <% } else { %>
        <p class="muted" style="font-size:12px; margin-bottom:12px;">
          Haz clic en <strong>Enviar</strong> para mandar el mensaje directamente desde el servidor sin abrir pestañas.
        </p>
        <div style="display:flex; flex-direction:column; gap:8px;">
          <% (plantillasDisponibles || []).forEach(function(p){ %>
            <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 10px; background:var(--bg); border:1px solid var(--border); border-radius:6px;">
              <div>
                <span style="font-weight:600; text-transform:capitalize; font-size:13px;"><%= p.clave.replace(/_/g,' ') %></span>
                <span class="muted" style="font-size:11px; display:block; max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= p.cuerpo %></span>
              </div>
              <div style="display:flex; align-items:center; gap:8px;">
                <form method="post" action="/socios/<%= socio.id %>/enviar-whatsapp" style="margin:0;">
                  <input type="hidden" name="clave" value="<%= p.clave %>">
                  <button type="submit" class="btn sm wa" style="font-weight:600; font-size:12px; padding:4px 10px; display:inline-flex; align-items:center; gap:4px;">
                    <%- u.icon('send', 12) %> Enviar
                  </button>
                </form>
                <% if (p.link) { %>
                  <a href="<%= p.link %>" target="_blank" rel="noopener" class="muted" style="font-size:11px; text-decoration:underline;" title="Abrir en WhatsApp Web en una pestaña manual">web</a>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Suscripciones -->
<div class="toolbar" style="margin-top:24px;">
  <h2 class="mb0">Historial de Suscripciones</h2>
  <a class="btn sm primary" href="/suscripciones/nueva?socio=<%= socio.id %>">+ Nueva suscripción</a>
</div>

<div class="card">
  <% if (!subs.length) { %>
    <p class="muted mb0">Sin suscripciones registradas aún.</p>
  <% } else { %>
  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Plan</th>
        <th>Desde</th>
        <th>Hasta</th>
        <th class="num">Monto</th>
        <th>Estado</th>
        <th>Registrado por</th>
        <th class="right">Comprobante</th>
      </tr>
    </thead>
    <tbody>
    <% subs.forEach(function(x){ %>
      <tr>
        <td><strong><%= x.plan_nombre %></strong></td>
        <td><%= u.fecha(x.fecha_inicio) %></td>
        <td><%= u.fecha(x.fecha_fin) %></td>
        <td class="num"><%= u.soles(x.precio_pagado) %></td>
        <td>
          <span class="badge <%= x.estado==='activa'?'ok':(x.estado==='vencida'?'danger':'muted') %>">
            <%= x.estado %>
          </span>
        </td>
        <td class="muted"><%= u.fecha(x.creado_en) %><%= x.creado_por ? ' · ' + x.creado_por : '' %></td>
        <td class="right">
          <a class="btn sm" href="/suscripciones/<%= x.id %>/ticket" title="Ver comprobante e imprimir ticket" style="display:inline-flex; align-items:center; gap:5px;">
            <%- u.icon('printer', 13) %> Ver Ticket
          </a>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table></div>
  <% } %>
</div>

<div class="row">
  <div>
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
      <h2 class="mb0">Historial de Pagos y Consumos</h2>
      <% var totalGastado = (pagos || []).reduce(function(acc, cur){ return acc + Number(cur.monto || 0); }, 0); %>
      <span class="badge ok" style="font-size:12px;">Total aportado: <%= u.soles(totalGastado) %></span>
    </div>
    <div class="card">
      <% if (!pagos.length) { %>
        <p class="muted mb0">Sin pagos ni consumos registrados.</p>
      <% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Fecha y Hora</th><th>Concepto / Detalle</th><th>Método</th><th class="num">Monto</th></tr></thead>
        <tbody>
        <% pagos.forEach(function(p){ %>
          <tr>
            <td><%= u.fechaHora(p.creado_en) %></td>
            <td>
              <% if (p.concepto && p.concepto.toLowerCase().includes('venta')) { %>
                <span class="badge" style="background:rgba(249,115,22,0.15); color:var(--accent); font-size:10.5px; padding:2px 6px; margin-right:4px; display:inline-flex; align-items:center; gap:3px;">
                  <%- u.icon('coffee', 11) %> Mostrador
                </span>
              <% } else { %>
                <span class="badge ok" style="font-size:10.5px; padding:2px 6px; margin-right:4px; display:inline-flex; align-items:center; gap:3px;">
                  <%- u.icon('card', 11) %> Plan
                </span>
              <% } %>
              <%= p.concepto %>
            </td>
            <td><span style="font-weight:600; text-transform:uppercase;"><%= p.metodo_pago %></span></td>
            <td class="num" style="font-weight:700;"><%= u.soles(p.monto) %></td>
          </tr>
        <% }); %>
        </tbody>
      </table></div>
      <% } %>
    </div>
  </div>

  <div>
    <h2>Últimas Asistencias</h2>
    <div class="card">
      <% if (!asistencias.length) { %>
        <p class="muted mb0">Sin asistencias registradas.</p>
      <% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Fecha y Hora</th><th>Método de Acceso</th></tr></thead>
        <tbody>
        <% asistencias.forEach(function(a){ %>
          <tr>
            <td><%= u.fechaHora(a.fecha) %></td>
            <td><span class="badge muted"><%= a.metodo || 'manual' %></span></td>
          </tr>
        <% }); %>
        </tbody>
      </table></div>
      <% } %>
    </div>
  </div>
</div>

<div class="card" style="margin-top:20px; display:flex; justify-content:space-between; align-items:center;">
  <div>
    <strong style="color:var(--danger-ink);">Zona de Peligro</strong>
    <p class="muted" style="margin:2px 0 0; font-size:13px;">Dar de baja al socio lo oculta de las listas sin eliminar su historial.</p>
  </div>
  <form method="post" action="/socios/<%= socio.id %>/baja" onsubmit="return confirm('¿Dar de baja a este socio? No se borrarán sus datos históricos, solo dejará de aparecer en las listas activas.');" style="margin:0;">
    <button class="btn danger sm" type="submit">Dar de baja al socio</button>
  </form>
</div>

<!-- Modal Flotante: Editar Datos del Socio -->
<div id="modal-socio-edit" class="modal-backdrop" style="display:none;" onclick="if(event.target===this) window.cerrarModal('modal-socio-edit');">
  <div class="modal-dialog lg">
    <div class="modal-header">
      <h3 class="modal-title">
        <%- u.icon('edit', 16) %> Editar Datos del Socio
      </h3>
      <button type="button" class="modal-close" onclick="window.cerrarModal('modal-socio-edit');" aria-label="Cerrar">
        <%- u.icon('close', 16) %>
      </button>
    </div>
    <form method="post" action="/socios/<%= socio.id %>" class="stack" style="margin:0;" autocomplete="off">
      <div class="modal-body">
        <div class="grid2">
          <div>
            <label for="ed-nombres">Nombres *</label>
            <input id="ed-nombres" name="nombres" value="<%= socio.nombres || '' %>" required autofocus>
          </div>
          <div>
            <label for="ed-apellidos">Apellidos *</label>
            <input id="ed-apellidos" name="apellidos" value="<%= socio.apellidos || '' %>" required>
          </div>
        </div>

        <div class="grid3">
          <div>
            <label for="ed-dni">DNI / Documento</label>
            <input id="ed-dni" name="dni" value="<%= socio.dni || '' %>">
          </div>
          <div>
            <label for="ed-tel">Teléfono (WhatsApp)</label>
            <input id="ed-tel" name="telefono" value="<%= socio.telefono || '' %>" placeholder="51987654321">
          </div>
          <div>
            <label for="ed-fnac">Fecha de Nacimiento</label>
            <input type="date" id="ed-fnac" name="fecha_nacimiento" value="<%= socio.fecha_nacimiento ? (socio.fecha_nacimiento.toISOString ? socio.fecha_nacimiento.toISOString().slice(0,10) : String(socio.fecha_nacimiento).slice(0,10)) : '' %>">
          </div>
        </div>

        <div class="grid3">
          <div>
            <label for="ed-email">Correo Electrónico</label>
            <input type="email" id="ed-email" name="email" value="<%= socio.email || '' %>">
          </div>
          <div>
            <label for="ed-genero">Género</label>
            <select id="ed-genero" name="genero">
              <option value="">—</option>
              <option value="M" <%= socio.genero==='M'?'selected':'' %>>Masculino</option>
              <option value="F" <%= socio.genero==='F'?'selected':'' %>>Femenino</option>
              <option value="otro" <%= socio.genero==='otro'?'selected':'' %>>Otro</option>
            </select>
          </div>
          <div>
            <label for="ed-dir">Dirección</label>
            <input id="ed-dir" name="direccion" value="<%= socio.direccion || '' %>">
          </div>
        </div>

        <div class="grid2">
          <div>
            <label for="ed-cemer">Contacto de Emergencia</label>
            <input id="ed-cemer" name="contacto_emergencia_nombre" value="<%= socio.contacto_emergencia_nombre || '' %>">
          </div>
          <div>
            <label for="ed-temer">Teléfono de Emergencia</label>
            <input id="ed-temer" name="contacto_emergencia_telefono" value="<%= socio.contacto_emergencia_telefono || '' %>">
          </div>
        </div>

        <div>
          <label for="ed-notas">Notas / Salud</label>
          <textarea id="ed-notas" name="notas" rows="2"><%= socio.notas || '' %></textarea>
        </div>

        <div>
          <label style="display:flex; gap:8px; align-items:center; cursor:pointer;">
            <input type="checkbox" name="acepta_marketing" style="width:auto;" <%= socio.acepta_marketing ? 'checked' : '' %>>
            <span>Acepta mensajes promocionales y recordatorios</span>
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="window.cerrarModal('modal-socio-edit');">Cancelar</button>
        <button type="submit" class="btn primary">Guardar Cambios</button>
      </div>
    </form>
  </div>
</div>

<!-- ========================================================
     MODAL RÁPIDO: TOMAR / SUBIR FOTO DEL SOCIO
     ======================================================== -->
<div id="modal-foto-rapida" class="modal-backdrop" style="display:none;" onclick="if(event.target===this) cerrarModalFoto();">
  <div class="modal-card" style="max-width:440px;" onclick="event.stopPropagation();">
    <div class="modal-header">
      <h3 style="display:flex; align-items:center; gap:8px; margin:0;">
        <%- u.icon('camera', 18) %> Foto de <%= socio.nombres %>
      </h3>
      <button type="button" class="modal-close" onclick="cerrarModalFoto();" aria-label="Cerrar">
        <%- u.icon('close', 14) %>
      </button>
    </div>
    <div class="modal-body stack" style="margin:0;">
      <div id="foto-rapida-alerta" style="display:none;" class="flash error"></div>

      <!-- Preview y opciones -->
      <div style="display:flex; flex-direction:column; align-items:center; gap:12px;">
        <div style="width:160px; height:160px; border-radius:16px; background:#18181b; border:2px solid var(--border); overflow:hidden; display:flex; align-items:center; justify-content:center;">
          <img id="foto-rapida-img" src="<%= socio.foto_url || '' %>" style="width:100%; height:100%; object-fit:cover; <%= socio.foto_url ? '' : 'display:none;' %>">
          <div id="foto-rapida-empty" style="color:var(--muted); font-size:12px; display:<%= socio.foto_url ? 'none' : 'flex' %>; flex-direction:column; align-items:center; gap:6px;">
            <%- u.icon('camera', 36) %>
            <span>Sin fotografía</span>
          </div>
        </div>

        <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:center;">
          <input type="file" id="foto-rapida-file" accept="image/*" style="display:none;" onchange="handleFotoRapidaFile(event);">
          <button type="button" class="btn sm" onclick="document.getElementById('foto-rapida-file').click();" style="display:inline-flex; align-items:center; gap:6px;">
            <%- u.icon('file', 14) %> Subir Archivo
          </button>
          <button type="button" class="btn sm primary" onclick="iniciarCamaraRapida();" style="display:inline-flex; align-items:center; gap:6px;">
            <%- u.icon('camera', 14) %> Tomar con Cámara Web
          </button>
          <% if (socio.foto_url) { %>
            <button type="button" class="btn sm" onclick="eliminarFotoDirecto();" style="display:inline-flex; align-items:center; gap:4px; color:var(--danger);">
              <%- u.icon('close', 12) %> Eliminar
            </button>
          <% } %>
        </div>
      </div>

      <!-- Visor de la cámara en vivo -->
      <div id="webcam-rapida-box" style="display:none; background:#09090b; padding:10px; border-radius:8px; border:1px solid #3f3f46; margin-top:8px;">
        <video id="webcam-rapida-video" autoplay playsinline style="width:100%; height:220px; object-fit:cover; border-radius:6px; background:#000;"></video>
        <canvas id="webcam-rapida-canvas" style="display:none;"></canvas>
        <div style="display:flex; justify-content:space-between; gap:8px; margin-top:8px;">
          <button type="button" class="btn primary sm" onclick="capturarFotoRapida();" style="flex:1;">
            📸 Capturar y Guardar
          </button>
          <button type="button" class="btn sm" onclick="detenerCamaraRapida();">Cancelar</button>
        </div>
      </div>
    </div>
    <div class="modal-footer" style="margin-top:12px;">
      <button type="button" class="btn" onclick="cerrarModalFoto();">Cerrar</button>
    </div>
  </div>
</div>

<script>
  function abrirModalSocioEditar() {
    window.abrirModal('modal-socio-edit');
  }

  var webcamRapidaStream = null;
  var currentSocioId = '<%= socio.id %>';

  function abrirModalFotoRapida(socioId, nombre) {
    document.getElementById('foto-rapida-alerta').style.display = 'none';
    window.abrirModal('modal-foto-rapida');
  }

  function cerrarModalFoto() {
    detenerCamaraRapida();
    window.cerrarModal('modal-foto-rapida');
  }

  function iniciarCamaraRapida() {
    var box = document.getElementById('webcam-rapida-box');
    var video = document.getElementById('webcam-rapida-video');

    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      alert('Tu navegador no admite cámara web o requiere HTTPS.');
      return;
    }

    box.style.display = 'block';
    navigator.mediaDevices.getUserMedia({
      video: { width: { ideal: 480 }, height: { ideal: 480 }, facingMode: 'user' }
    })
    .then(function(stream) {
      webcamRapidaStream = stream;
      video.srcObject = stream;
    })
    .catch(function(err) {
      alert('Error accediendo a cámara: ' + err.message);
      box.style.display = 'none';
    });
  }

  function detenerCamaraRapida() {
    var box = document.getElementById('webcam-rapida-box');
    if (webcamRapidaStream) {
      webcamRapidaStream.getTracks().forEach(function(t) { t.stop(); });
      webcamRapidaStream = null;
    }
    if (box) box.style.display = 'none';
  }

  function capturarFotoRapida() {
    var video = document.getElementById('webcam-rapida-video');
    var canvas = document.getElementById('webcam-rapida-canvas');
    if (!video || !webcamRapidaStream) return;

    var w = video.videoWidth || 480;
    var h = video.videoHeight || 480;
    canvas.width = 400;
    canvas.height = 400;

    var ctx = canvas.getContext('2d');
    var minDim = Math.min(w, h);
    var sx = (w - minDim) / 2;
    var sy = (h - minDim) / 2;
    ctx.drawImage(video, sx, sy, minDim, minDim, 0, 0, 400, 400);

    var dataUrl = canvas.toDataURL('image/jpeg', 0.88);
    detenerCamaraRapida();
    guardarFotoServidor(dataUrl);
  }

  function handleFotoRapidaFile(e) {
    var file = e.target.files && e.target.files[0];
    if (!file) return;

    var reader = new FileReader();
    reader.onload = function(evt) {
      guardarFotoServidor(evt.target.result);
    };
    reader.readAsDataURL(file);
  }

  function guardarFotoServidor(base64Data) {
    var alerta = document.getElementById('foto-rapida-alerta');
    alerta.style.display = 'none';

    fetch('/socios/' + currentSocioId + '/foto', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ foto_base64: base64Data })
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok && res.foto_url) {
        document.getElementById('foto-rapida-img').src = res.foto_url;
        document.getElementById('foto-rapida-img').style.display = 'block';
        document.getElementById('foto-rapida-empty').style.display = 'none';

        var headerFoto = document.getElementById('detail-socio-foto');
        var headerPlaceholder = document.getElementById('detail-socio-placeholder');
        if (headerFoto) {
          headerFoto.src = res.foto_url;
          headerFoto.style.display = 'block';
        } else if (headerPlaceholder) {
          headerPlaceholder.outerHTML = '<img id="detail-socio-foto" src="' + res.foto_url + '" style="width:100%; height:100%; object-fit:cover;">';
        }
        cerrarModalFoto();
      } else {
        alerta.textContent = res.error || 'Error al guardar foto.';
        alerta.style.display = 'block';
      }
    })
    .catch(function(err) {
      alerta.textContent = 'Error: ' + err.message;
      alerta.style.display = 'block';
    });
  }

  function eliminarFotoDirecto() {
    if (!confirm('¿Deseas eliminar la foto de este socio?')) return;
    fetch('/socios/' + currentSocioId + '/foto', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ eliminar: true })
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok) {
        location.reload();
      }
    });
  }
</script>
