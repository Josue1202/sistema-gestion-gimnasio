<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title><%= title %> · <%= gymName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      color-scheme: dark;
      --bg: #121212;
      --card: #18181b;
      --border: #27272a;
      --primary: #3ECF8E;
      --primary-hover: #30b77b;
      --text: #EDEDED;
      --muted: #a1a1aa;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 16px;
      -webkit-font-smoothing: antialiased;
    }
    .container {
      width: 100%;
      max-width: 420px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px 20px;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
    }
    .badge-gym {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(62, 207, 142, 0.12);
      color: var(--primary);
      border: 1px solid rgba(62, 207, 142, 0.3);
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 14px;
    }
    h1 {
      font-size: 20px;
      font-weight: 800;
      margin-bottom: 4px;
      color: #fff;
    }
    p.sub {
      color: var(--muted);
      font-size: 13.5px;
      margin-bottom: 20px;
    }
    .preview-box {
      width: 220px;
      height: 220px;
      margin: 0 auto 20px;
      border-radius: 50%;
      border: 3px solid var(--border);
      background: #09090b;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }
    .preview-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .preview-box .placeholder-icon {
      color: var(--muted);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      font-size: 12px;
    }
    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      height: 52px;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      border: none;
      transition: all 0.15s ease;
      font-family: inherit;
      text-decoration: none;
    }
    .btn.primary {
      background: var(--primary);
      color: #000;
      box-shadow: 0 4px 16px rgba(62, 207, 142, 0.35);
    }
    .btn.primary:active { transform: scale(0.98); }
    .btn.secondary {
      background: #27272a;
      color: #fff;
      margin-top: 10px;
    }
    .btn.secondary:active { transform: scale(0.98); }
    .status-alert {
      padding: 12px;
      border-radius: 10px;
      font-size: 13px;
      margin-bottom: 16px;
      display: none;
    }
    .status-alert.success {
      background: rgba(62, 207, 142, 0.15);
      border: 1px solid rgba(62, 207, 142, 0.3);
      color: var(--primary);
    }
    .status-alert.error {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #f87171;
    }
    .success-screen {
      display: none;
      text-align: center;
      padding: 20px 0;
    }
    .success-icon {
      width: 64px;
      height: 64px;
      background: rgba(62, 207, 142, 0.15);
      border: 2px solid var(--primary);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      color: var(--primary);
      font-size: 28px;
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="badge-gym">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      <%= gymName %> · Cámara Móvil
    </div>

    <div id="capture-flow">
      <h1>Foto para <%= socio.nombres %></h1>
      <p class="sub">Toma la fotografía del socio de frente con buena iluminación.</p>

      <div id="alert-box" class="status-alert"></div>

      <div class="preview-box">
        <img id="preview-img" src="<%= socio.foto_url || '' %>" style="<%= socio.foto_url ? '' : 'display:none;' %>">
        <div id="preview-placeholder" class="placeholder-icon" style="<%= socio.foto_url ? 'display:none;' : '' %>">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
            <circle cx="12" cy="13" r="4"></circle>
          </svg>
          <span>Sin foto aún</span>
        </div>
      </div>

      <!-- Inputs ocultos para disparar cámara de celular nativa -->
      <input type="file" id="camera-rear" accept="image/*" capture="environment" style="display:none;" onchange="procesarFotoArchivo(event);">
      <input type="file" id="camera-front" accept="image/*" capture="user" style="display:none;" onchange="procesarFotoArchivo(event);">

      <div id="buttons-initial">
        <button type="button" class="btn primary" onclick="document.getElementById('camera-rear').click();">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
            <circle cx="12" cy="13" r="4"></circle>
          </svg>
          Abrir Cámara del Celular
        </button>
        <button type="button" class="btn secondary" onclick="document.getElementById('camera-front').click();">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 6.2002V17.8002C7 18.9203 7 19.4796 7.21799 19.9074C7.40973 20.2837 7.71547 20.5905 8.0918 20.7822C8.5192 21 9.07899 21 10.1969 21H13.8031C14.921 21 15.48 21 15.9074 20.7822C16.2837 20.5905 16.5905 20.2837 16.7822 19.9074C17 19.48 17 18.921 17 17.8031V6.19691C17 5.07899 17 4.5192 16.7822 4.0918C16.5905 3.71547 16.2837 3.40973 15.9074 3.21799C15.4796 3 14.9203 3 13.8002 3H10.2002C9.08009 3 8.51962 3 8.0918 3.21799C7.71547 3.40973 7.40973 3.71547 7.21799 4.0918C7 4.51962 7 5.08009 7 6.2002Z"></path>
          </svg>
          Cámara Frontal (Selfie)
        </button>
      </div>

      <div id="buttons-confirm" style="display:none;">
        <button type="button" id="btn-save" class="btn primary" onclick="enviarFotoServidor();">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Guardar y Enviar a Laptop
        </button>
        <button type="button" class="btn secondary" onclick="document.getElementById('camera-rear').click();">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 16H19V21M10 8H5V3M19.4176 9.0034C18.8569 7.61566 17.9181 6.41304 16.708 5.53223C15.4979 4.65141 14.0652 4.12752 12.5723 4.02051C11.0794 3.9135 9.58606 4.2274 8.2627 4.92661C6.93933 5.62582 5.83882 6.68254 5.08594 7.97612M4.58203 14.9971C5.14272 16.3848 6.08146 17.5874 7.29157 18.4682C8.50169 19.3491 9.93588 19.8723 11.4288 19.9793C12.9217 20.0863 14.4138 19.7725 15.7371 19.0732C17.0605 18.374 18.1603 17.3175 18.9131 16.0239"></path>
          </svg>
          Tomar otra foto
        </button>
      </div>
    </div>

    <!-- Pantalla de éxito tras subir -->
    <div id="success-flow" class="success-screen">
      <div class="success-icon">✓</div>
      <h2 style="font-size:22px; font-weight:800; color:#fff; margin-bottom:8px;">¡Foto enviada!</h2>
      <p style="color:var(--muted); font-size:14px; line-height:1.5; margin-bottom:24px;">
        La fotografía de <strong><%= socio.nombres %></strong> se guardó y ya se actualizó en la pantalla de la laptop.
      </p>
      <button type="button" class="btn secondary" onclick="window.close();">
        Cerrar pestaña
      </button>
    </div>
  </div>

  <canvas id="hidden-canvas" style="display:none;"></canvas>

  <script>
    var currentBase64 = null;
    var socioId = '<%= socio.id %>';
    var token = '<%= token %>';

    function mostrarAlerta(msg, tipo) {
      var b = document.getElementById('alert-box');
      b.textContent = msg;
      b.className = 'status-alert ' + tipo;
      b.style.display = 'block';
    }

    function procesarFotoArchivo(e) {
      var file = e.target.files && e.target.files[0];
      if (!file) return;

      var reader = new FileReader();
      reader.onload = function(evt) {
        var img = new Image();
        img.onload = function() {
          // Comprimir y recortar a 500x500 centrado para subida instantánea
          var canvas = document.getElementById('hidden-canvas');
          var ctx = canvas.getContext('2d');
          var targetSize = 500;
          canvas.width = targetSize;
          canvas.height = targetSize;

          var minDim = Math.min(img.width, img.height);
          var sx = (img.width - minDim) / 2;
          var sy = (img.height - minDim) / 2;

          ctx.drawImage(img, sx, sy, minDim, minDim, 0, 0, targetSize, targetSize);
          currentBase64 = canvas.toDataURL('image/jpeg', 0.85);

          // Actualizar preview en la pantalla del celular
          var previewImg = document.getElementById('preview-img');
          previewImg.src = currentBase64;
          previewImg.style.display = 'block';
          document.getElementById('preview-placeholder').style.display = 'none';

          // Cambiar botones a confirmar
          document.getElementById('buttons-initial').style.display = 'none';
          document.getElementById('buttons-confirm').style.display = 'block';
          mostrarAlerta('Foto lista. Revisa la vista previa y presiona Guardar.', 'success');
        };
        img.src = evt.target.result;
      };
      reader.readAsDataURL(file);
    }

    function enviarFotoServidor() {
      if (!currentBase64) return;
      var btn = document.getElementById('btn-save');
      btn.disabled = true;
      btn.textContent = 'Subiendo al sistema...';

      fetch('/foto-movil/' + socioId + '/' + token, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ foto_base64: currentBase64 })
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.ok) {
          if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
          document.getElementById('capture-flow').style.display = 'none';
          document.getElementById('success-flow').style.display = 'block';
        } else {
          btn.disabled = false;
          btn.textContent = 'Guardar y Enviar a Laptop';
          mostrarAlerta('Error: ' + (data.error || 'No se pudo guardar la foto'), 'error');
        }
      })
      .catch(function(err) {
        btn.disabled = false;
        btn.textContent = 'Guardar y Enviar a Laptop';
        mostrarAlerta('Error de conexión: ' + err.message, 'error');
      });
    }
  </script>
</body>
</html>
