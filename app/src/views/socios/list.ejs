<div class="toolbar">
  <div>
    <h1 class="mb0">Directorio de Socios</h1>
    <p class="muted" style="margin-top:4px;">Total registrados en el sistema: <strong><%= total %></strong> socios.</p>
  </div>
  <div class="actions">
    <button class="btn primary" type="button" onclick="abrirModalSocioNuevo();" style="display:inline-flex; align-items:center; gap:6px;">
      <%- u.icon('userPlus', 16) %> Nuevo Socio
    </button>
  </div>
</div>

<form method="get" action="/socios" class="card" style="padding:14px; margin-bottom:16px;">
  <div class="toolbar" style="margin-bottom:0;">
    <div class="search" style="flex:1;">
      <input type="text" name="q" value="<%= q %>" placeholder="Buscar por Nombre, DNI o Teléfono..." autofocus
             style="min-width:280px; font-weight:500;">
      <select name="estado" style="max-width:200px;">
        <option value="">Todos los estados</option>
        <option value="activo"        <%= estado==='activo'?'selected':'' %>>Activos</option>
        <option value="por_vencer"    <%= estado==='por_vencer'?'selected':'' %>>Por vencer (7 días)</option>
        <option value="vencido"       <%= estado==='vencido'?'selected':'' %>>Vencidos</option>
        <option value="congelado"     <%= estado==='congelado'?'selected':'' %>>Congelados</option>
        <option value="sin_suscripcion" <%= estado==='sin_suscripcion'?'selected':'' %>>Sin suscripción</option>
      </select>
      <button class="btn" type="submit" style="display:inline-flex; align-items:center; gap:6px;">
        <%- u.icon('search', 14) %> Filtrar
      </button>
      <% if (q || estado) { %>
        <a class="btn" href="/socios">Limpiar</a>
      <% } %>
    </div>
  </div>
</form>

<div class="card">
  <% if (!socios.length) { %>
    <p class="muted mb0" style="padding:16px 0; text-align:center;">No se encontraron socios con los filtros aplicados.</p>
  <% } else { %>
  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Socio</th>
        <th>DNI / Doc</th>
        <th>WhatsApp</th>
        <th>Plan Vigente</th>
        <th>Vencimiento</th>
        <th>Estado</th>
        <th class="right">Acciones</th>
      </tr>
    </thead>
    <tbody>
    <% socios.forEach(function(s){
       var est = s.estado_membresia;
       if (est === 'activo' && s.dias_restantes != null && s.dias_restantes <= 7) est = 'por_vencer';
       var ini = (s.nombres.charAt(0) + (s.apellidos ? s.apellidos.charAt(0) : '')).toUpperCase();
    %>
      <tr>
        <td>
          <div style="display:flex; align-items:center; gap:10px;">
            <% if (s.foto_url) { %>
              <img src="<%= s.foto_url %>" alt="<%= s.nombres %>" style="width:32px; height:32px; border-radius:var(--radius-sm); object-fit:cover; border:1px solid #333333; flex-shrink:0;">
            <% } else { %>
              <div style="width:32px; height:32px; border-radius:var(--radius-sm); background:#222222; border:1px solid #333333; color:var(--text-bright); display:flex; align-items:center; justify-content:center; font-weight:600; font-size:11px; flex-shrink:0;">
                <%= ini %>
              </div>
            <% } %>
            <div>
              <a href="/socios/<%= s.id %>" style="font-weight:700; font-size:14px; color:var(--text-bright);">
                <%= s.apellidos %>, <%= s.nombres %>
              </a>
            </div>
          </div>
        </td>
        <td><%= s.dni || '—' %></td>
        <td>
          <% if (s.telefono) { %>
            <a href="https://wa.me/<%= s.telefono %>" target="_blank" rel="noopener" style="color:var(--muted); font-size:13px;">
              <%= s.telefono %>
            </a>
          <% } else { %>
            <span class="muted">—</span>
          <% } %>
        </td>
        <td><strong><%= s.plan_nombre || '—' %></strong></td>
        <td><%= s.fecha_fin ? u.fecha(s.fecha_fin) : '—' %></td>
        <td>
          <% if (est==='activo') { %><span class="badge ok">Activo</span>
          <% } else if (est==='por_vencer') { %><span class="badge warn">Vence en <%= s.dias_restantes %>d</span>
          <% } else if (est==='vencido') { %><span class="badge danger">Vencido</span>
          <% } else if (est==='congelado') { %><span class="badge muted">Congelado</span>
          <% } else { %><span class="badge muted">Sin plan</span><% } %>
        </td>
        <td class="right actions" style="justify-content:flex-end;">
          <a class="btn sm" href="/socios/<%= s.id %>">Ficha</a>
          <button class="btn sm" type="button"
                  data-id="<%= s.id %>"
                  data-nombres="<%= s.nombres %>"
                  data-apellidos="<%= s.apellidos %>"
                  data-dni="<%= s.dni || '' %>"
                  data-telefono="<%= s.telefono || '' %>"
                  data-email="<%= s.email || '' %>"
                  data-genero="<%= s.genero || '' %>"
                  data-direccion="<%= s.direccion || '' %>"
                  data-fecha-nacimiento="<%= s.fecha_nacimiento ? (s.fecha_nacimiento.toISOString ? s.fecha_nacimiento.toISOString().slice(0,10) : String(s.fecha_nacimiento).slice(0,10)) : '' %>"
                  data-contacto-nombre="<%= s.contacto_emergencia_nombre || '' %>"
                  data-contacto-telefono="<%= s.contacto_emergencia_telefono || '' %>"
                  data-notas="<%= s.notas || '' %>"
                  data-marketing="<%= s.acepta_marketing ? '1' : '0' %>"
                  onclick="abrirModalSocioEditar(this);"
                  style="display:inline-flex; align-items:center; gap:4px;">
            <%- u.icon('edit', 12) %> Editar
          </button>
          <a class="btn sm primary" href="/suscripciones/nueva?socio=<%= s.id %>">Cobrar</a>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table></div>
  <% } %>
</div>

<% if (page > 1 || hayMas) { %>
<div class="actions" style="justify-content:center; margin-top:20px;">
  <% if (page > 1) { %><a class="btn" href="/socios?q=<%= encodeURIComponent(q) %>&estado=<%= estado %>&page=<%= page-1 %>">« Página Anterior</a><% } %>
  <% if (hayMas) { %><a class="btn" href="/socios?q=<%= encodeURIComponent(q) %>&estado=<%= estado %>&page=<%= page+1 %>">Página Siguiente »</a><% } %>
</div>
<% } %>

<!-- Modal Flotante: Crear / Editar Socio -->
<div id="modal-socio" class="modal-backdrop" style="display:none;" onclick="if(event.target===this) window.cerrarModal('modal-socio');">
  <div class="modal-dialog lg">
    <div class="modal-header">
      <h3 class="modal-title">
        <%- u.icon('userPlus', 16) %> <span id="socio-modal-title">Registrar Nuevo Socio</span>
      </h3>
      <button type="button" class="modal-close" onclick="window.cerrarModal('modal-socio');" aria-label="Cerrar">
        <%- u.icon('close', 16) %>
      </button>
    </div>
    <form id="form-socio" method="post" action="/socios" class="stack" style="margin:0;">
      <div class="modal-body">
        <div class="grid2">
          <div>
            <label for="socio-nombres">Nombres *</label>
            <input id="socio-nombres" name="nombres" required placeholder="Ej: Juan Carlos">
          </div>
          <div>
            <label for="socio-apellidos">Apellidos *</label>
            <input id="socio-apellidos" name="apellidos" required placeholder="Ej: Pérez García">
          </div>
        </div>

        <div class="grid3">
          <div>
            <label for="socio-dni">DNI / Documento</label>
            <input id="socio-dni" name="dni" placeholder="8 dígitos...">
          </div>
          <div>
            <label for="socio-tel">Teléfono (WhatsApp)</label>
            <input id="socio-tel" name="telefono" placeholder="Ej: 987654321">
          </div>
          <div>
            <label for="socio-fnac">Fecha de Nacimiento</label>
            <input type="date" id="socio-fnac" name="fecha_nacimiento">
          </div>
        </div>

        <div class="grid3">
          <div>
            <label for="socio-email">Correo Electrónico</label>
            <input type="email" id="socio-email" name="email" placeholder="socio@email.com">
          </div>
          <div>
            <label for="socio-genero">Género</label>
            <select id="socio-genero" name="genero">
              <option value="">—</option>
              <option value="M">Masculino</option>
              <option value="F">Femenino</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div>
            <label for="socio-dir">Dirección</label>
            <input id="socio-dir" name="direccion" placeholder="Av. Principal 123...">
          </div>
        </div>

        <div class="grid2">
          <div>
            <label for="socio-cemer">Contacto de Emergencia</label>
            <input id="socio-cemer" name="contacto_emergencia_nombre" placeholder="Nombre de familiar / amigo">
          </div>
          <div>
            <label for="socio-temer">Teléfono de Emergencia</label>
            <input id="socio-temer" name="contacto_emergencia_telefono" placeholder="Número de contacto">
          </div>
        </div>

        <div>
          <label for="socio-notas">Notas / Historial de Salud</label>
          <textarea id="socio-notas" name="notas" rows="2" placeholder="Lesiones previas, alergias, observaciones..."></textarea>
        </div>

        <div>
          <label style="display:flex; gap:8px; align-items:center; cursor:pointer;">
            <input type="checkbox" id="socio-mkt" name="acepta_marketing" style="width:auto;" checked>
            <span>Acepta recibir recordatorios y avisos promocionales por WhatsApp</span>
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="window.cerrarModal('modal-socio');">Cancelar</button>
        <button type="submit" class="btn primary">Guardar Socio</button>
      </div>
    </form>
  </div>
</div>

<script>
  function abrirModalSocioNuevo() {
    document.getElementById('socio-modal-title').textContent = 'Registrar Nuevo Socio';
    var f = document.getElementById('form-socio');
    f.action = '/socios';
    f.reset();
    document.getElementById('socio-mkt').checked = true;
    window.abrirModal('modal-socio');
  }

  function abrirModalSocioEditar(btn) {
    document.getElementById('socio-modal-title').textContent = 'Editar Socio: ' + btn.getAttribute('data-nombres') + ' ' + btn.getAttribute('data-apellidos');
    var f = document.getElementById('form-socio');
    f.action = '/socios/' + btn.getAttribute('data-id');
    document.getElementById('socio-nombres').value = btn.getAttribute('data-nombres') || '';
    document.getElementById('socio-apellidos').value = btn.getAttribute('data-apellidos') || '';
    document.getElementById('socio-dni').value = btn.getAttribute('data-dni') || '';
    document.getElementById('socio-tel').value = btn.getAttribute('data-telefono') || '';
    document.getElementById('socio-fnac').value = btn.getAttribute('data-fecha-nacimiento') || '';
    document.getElementById('socio-email').value = btn.getAttribute('data-email') || '';
    document.getElementById('socio-genero').value = btn.getAttribute('data-genero') || '';
    document.getElementById('socio-dir').value = btn.getAttribute('data-direccion') || '';
    document.getElementById('socio-cemer').value = btn.getAttribute('data-contacto-nombre') || '';
    document.getElementById('socio-temer').value = btn.getAttribute('data-contacto-telefono') || '';
    document.getElementById('socio-notas').value = btn.getAttribute('data-notas') || '';
    document.getElementById('socio-mkt').checked = btn.getAttribute('data-marketing') === '1';
    window.abrirModal('modal-socio');
  }
</script>
