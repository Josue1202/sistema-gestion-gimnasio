<div class="toolbar">
  <div>
    <h1 class="mb0">Cobrar / Renovar Membresía</h1>
    <p class="muted" style="margin-top:4px;">Registra el plan, método de pago y emite el comprobante del socio.</p>
  </div>
  <a class="btn" href="/socios/<%= socio.id %>">Volver a la ficha</a>
</div>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:16px;">
    <div>
      <h2 class="mt0 mb0"><%= socio.apellidos %>, <%= socio.nombres %></h2>
      <span class="muted">DNI: <%= socio.dni || 'No registrado' %> · Teléfono: <%= socio.telefono || 'Sin teléfono' %></span>
    </div>
    <% if (actual) { %>
      <div style="text-align:right;">
        <span class="badge ok">Plan actual: <%= actual.plan_nombre %></span><br>
        <span class="muted" style="font-size:12px;">Vence el <%= u.fecha(actual.fecha_fin) %></span>
      </div>
    <% } %>
  </div>

  <form method="post" action="/suscripciones" class="stack">
    <input type="hidden" name="socio_id" value="<%= socio.id %>">

    <div class="grid3">
      <div>
        <label for="plan" style="font-weight:700;">1. Seleccionar Plan *</label>
        <select name="plan_id" id="plan" required style="font-weight:600; padding:11px;">
          <option value="">Elegir plan...</option>
          <% planes.forEach(function(p){ %>
            <option value="<%= p.id %>" data-precio="<%= p.precio %>" data-dias="<%= p.duracion_dias %>">
              <%= p.nombre %> — <%= u.soles(p.precio) %> (<%= p.duracion_dias %> días)
            </option>
          <% }); %>
        </select>
      </div>

      <div>
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <label for="inicio" style="font-weight:700;">2. Fecha de Inicio *</label>
          <div style="display:flex; gap:4px; margin-bottom:4px;">
            <button type="button" class="btn sm" onclick="setInicioHoy();" style="padding:2px 6px; font-size:11px;">Hoy</button>
            <% if (actual && actual.fecha_fin) { %>
              <button type="button" class="btn sm" onclick="setInicioSiguiente();" style="padding:2px 6px; font-size:11px;">Al vencer</button>
            <% } %>
          </div>
        </div>
        <input type="date" name="fecha_inicio" id="inicio" value="<%= inicio %>" required>
      </div>

      <div>
        <label for="fin" style="font-weight:700;">3. Fecha de Vencimiento *</label>
        <input type="date" name="fecha_fin" id="fin" required>
      </div>
    </div>

    <!-- Precios y Métodos de Pago Locales (100% Sin Comisiones) -->
    <div class="grid3" style="margin-top:8px;">
      <div>
        <label for="precio" style="font-weight:700;">Monto a Cobrar (S/) *</label>
        <input type="number" step="0.01" min="0" name="precio_pagado" id="precio" placeholder="0.00" required
               style="font-size:17px; font-weight:700; color:var(--text-bright);">
      </div>

      <div>
        <label for="metodo_pago" style="font-weight:700;">Método de Pago *</label>
        <select name="metodo_pago" id="metodo_pago" required style="font-weight:600; padding:11px;">
          <option value="efectivo">Efectivo</option>
          <option value="yape">Yape</option>
          <option value="plin">Plin</option>
          <option value="tarjeta">Tarjeta (POS)</option>
          <option value="transferencia">Transferencia Bancaria</option>
          <option value="otro">Otro</option>
        </select>
      </div>

      <div>
        <label for="referencia">N° de Operación / Referencia (opcional)</label>
        <input type="text" name="referencia" id="referencia" placeholder="Ej: 148293 o últimos 4 dígitos">
      </div>
    </div>

    <div style="background:var(--surface-2); padding:12px 16px; border-radius:var(--radius-sm); margin:8px 0;">
      <label style="display:flex; gap:10px; align-items:center; cursor:pointer; margin-bottom:0;">
        <input type="checkbox" name="marcar_asistencia" style="width:auto;" checked>
        <span style="font-weight:600; color:var(--text-bright);">Registrar también la asistencia de hoy en recepción</span>
      </label>
    </div>

    <% if (!cajaAbierta) { %>
      <div class="flash error" style="margin:0; display:flex; align-items:center; gap:8px;">
        <%- u.icon('alertCircle', 16) %>
        <span>No hay caja abierta. El cobro se registrará en el historial, pero no quedará asignado a una caja diaria.</span>
        <a href="/caja" target="_blank" style="margin-left:8px; font-weight:700;">Abrir caja</a>
      </div>
    <% } %>

    <div class="actions" style="margin-top:10px;">
      <button class="btn primary" type="submit" style="font-size:15px; padding:11px 22px; display:inline-flex; align-items:center; gap:8px;">
        <%- u.icon('checkCircle', 16) %> Guardar Pago y Ver Ticket
      </button>
      <a class="btn" href="/socios/<%= socio.id %>">Cancelar</a>
    </div>
  </form>
</div>

<script>
  (function () {
    var planes = <%- planesJson %>;
    var sel = document.getElementById('plan');
    var inicio = document.getElementById('inicio');
    var fin = document.getElementById('fin');
    var precio = document.getElementById('precio');
    var inicioSugeridoHoy = '<%= u.hoyISO() %>';
    var inicioSugeridoFin = '<%= inicio %>';

    window.setInicioHoy = function() {
      inicio.value = inicioSugeridoHoy;
      recalcular();
    };

    window.setInicioSiguiente = function() {
      inicio.value = inicioSugeridoFin;
      recalcular();
    };

    function addDias(iso, d) {
      if (!iso) return '';
      var parts = iso.split('-').map(Number);
      var dt = new Date(parts[0], parts[1] - 1, parts[2]);
      dt.setDate(dt.getDate() + Number(d));
      var y = dt.getFullYear();
      var m = String(dt.getMonth() + 1).padStart(2, '0');
      var day = String(dt.getDate()).padStart(2, '0');
      return y + '-' + m + '-' + day;
    }

    function recalcular() {
      var opt = sel.options[sel.selectedIndex];
      if (!opt || !opt.value) return;
      var dias = parseInt(opt.getAttribute('data-dias'), 10) || 30;
      if (inicio.value) fin.value = addDias(inicio.value, dias);
      if (!precio.value) precio.placeholder = opt.getAttribute('data-precio');
    }

    sel.addEventListener('change', function () {
      var opt = sel.options[sel.selectedIndex];
      if (opt && opt.value && !precio.value) {
        precio.value = opt.getAttribute('data-precio');
      }
      recalcular();
    });

    inicio.addEventListener('change', recalcular);
    recalcular();
  })();
</script>
