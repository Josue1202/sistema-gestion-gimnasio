  function actualizarBannerCheckin(d) {
    var box = document.getElementById('checkin-result');
    var isOk = d.estado === 'activo';
    var isWarn = d.estado === 'por_vencer';
    var isDanger = d.estado === 'vencido';

    var statusHtml = isOk
      ? '<span style="display:inline-flex; align-items:center; gap:6px;">' + SVG_ICONS.checkCircle + ' ACCESO CONCEDIDO</span>'
      : (isWarn
          ? '<span style="display:inline-flex; align-items:center; gap:6px;">' + SVG_ICONS.alertCircle + ' ACCESO CONCEDIDO (POR VENCER)</span>'
          : '<span style="display:inline-flex; align-items:center; gap:6px;">' + SVG_ICONS.closeCircle + ' MEMBRESÍA VENCIDA</span>');
    var statusColor = isOk ? '#3ECF8E' : (isWarn ? '#fbbf24' : '#f15c6d');
    var bannerClass = isOk ? '' : (isWarn ? 'warn' : 'danger');

    box.style.display = 'block';
    box.innerHTML =
      '<div class="active-member-banner ' + bannerClass + '">' +
        '<div style="font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:0.06em; color:' + statusColor + ';">' + statusHtml + '</div>' +
        '<div style="font-size:19px; font-weight:800; color:var(--text-bright); margin:4px 0 2px;">' + d.nombre + '</div>' +
        '<div class="muted" style="font-size:13px;">' +
          'DNI: <strong>' + (d.dni || '—') + '</strong> · Plan: <strong>' + (d.plan || 'Sin plan') + '</strong>' +
          (d.fecha_fin ? ' · Vence: <strong>' + d.fecha_fin + '</strong>' : '') +
          (d.dias_restantes != null ? ' (' + d.dias_restantes + ' días restantes)' : '') +
        '</div>' +
        '<div class="actions" style="margin-top:10px;">' +
          (isWarn || isDanger || d.estado === 'sin_suscripcion'
            ? '<a class="btn primary sm" href="/suscripciones/nueva?socio=' + d.socio_id + '" target="_blank" style="display:inline-flex; align-items:center; gap:6px;">' + SVG_ICONS.card + ' Cobrar / Renovar Plan</a>'
            : '') +
          '<a class="btn sm" href="/socios/' + d.socio_id + '" target="_blank">Ver Ficha</a>' +
        '</div>' +
      '</div>';
  }

  function mostrarBannerError(msg) {
    var box = document.getElementById('checkin-result');
    box.style.display = 'block';
    box.innerHTML =
      '<div class="active-member-banner danger">' +
        '<div style="font-size:11px; font-weight:800; color:#ef4444; text-transform:uppercase; display:flex; align-items:center; gap:6px;">' + SVG_ICONS.closeCircle + ' NO ENCONTRADO</div>' +
        '<div style="font-size:15px; font-weight:700; color:var(--text); margin-top:4px;">' + msg + '</div>' +
        '<div style="margin-top:8px;"><a class="btn primary sm" href="/socios/nuevo" target="_blank">+ Registrar Nuevo Socio</a></div>' +
      '</div>';
  }

  function seleccionarSocioManualmente(id, nombre, dni, plan, estado) {
    clienteActivo = { id: id, nombre: nombre, dni: dni, plan: plan };
    var elId = document.getElementById('active-client-id');
    var elName = document.getElementById('active-client-name');
    var elDoc = document.getElementById('active-client-doc');
    if (elId) elId.value = id;
    if (elName) elName.textContent = nombre;
    if (elDoc) elDoc.textContent = 'DNI: ' + (dni || '—') + ' · Plan: ' + (plan || 'Sin plan');

    var badge = document.getElementById('cart-buyer-badge');
    if (badge) {
      badge.innerHTML = '<span style="display:inline-flex; align-items:center; gap:4px;">' + SVG_ICONS.user + ' ' + (nombre.split(' ')[0]) + '</span>';
      badge.style.background = 'rgba(16,185,129,0.15)';
      badge.style.color = 'var(--ok-ink)';
    }
  }

  function desvincularClienteMostrador() {
    clienteActivo = { id: '', nombre: 'Público General / Mostrador', dni: '', plan: '' };
    var elId = document.getElementById('active-client-id');
    var elName = document.getElementById('active-client-name');
    var elDoc = document.getElementById('active-client-doc');
    if (elId) elId.value = '';
    if (elName) elName.textContent = 'Público General / Mostrador';
    if (elDoc) elDoc.textContent = 'Las ventas se registrarán sin socio asignado (o marca asistencia para asociar).';

    var badge = document.getElementById('cart-buyer-badge');
    if (badge) {
      badge.textContent = 'Mostrador General';
      badge.style.background = 'rgba(156,163,175,0.15)';
      badge.style.color = 'var(--muted)';
    }
  }

  function agregarItemFeedAsistencia(d) {
    var empty = document.getElementById('asistencias-empty-msg');
    if (empty) empty.style.display = 'none';

    var feed = document.getElementById('asistencias-feed');
    var countEl = document.getElementById('asistencias-count');
    if (countEl) countEl.textContent = (parseInt(countEl.textContent || '0', 10) + 1);

    var div = document.createElement('div');
    div.className = 'feed-item';
    div.innerHTML =
      '<div>' +
        '<a href="/socios/' + d.socio_id + '" target="_blank" style="font-weight:700; font-size:13px; color:var(--text);">' + d.nombre + '</a>' +
        '<span class="muted" style="display:block; font-size:11px;">' + (d.plan || 'Sin plan') + ' · ' + (d.hora || 'Ahora') + '</span>' +
      '</div>' +
      '<div style="display:flex; align-items:center; gap:6px;">' +
        '<button type="button" class="btn sm" style="font-size:11px; padding:3px 8px; display:inline-flex; align-items:center; gap:4px;" ' +
          'data-id="' + d.socio_id + '" ' +
          'data-nombre="' + d.nombre + '" ' +
          'data-dni="' + (d.dni || '') + '" ' +
          'data-plan="' + (d.plan || '') + '" ' +
          'data-estado="' + (d.estado || 'activo') + '" ' +
          'onclick="seleccionarSocioDesdeBoton(this);">' +
          SVG_ICONS.cart + ' Vender' +
        '</button>' +
      '</div>';

    feed.insertBefore(div, feed.firstChild);
  }

  // ---------- MANEJO DEL PUNTO DE VENTA (POS) ----------
  function filtrarProductos(query) {
    var q = (query || '').toLowerCase().trim();
    var cards = document.querySelectorAll('.pos-prod-card');
    cards.forEach(function(card) {
      var nombre = (card.getAttribute('data-nombre') || '').toLowerCase();
      if (!q || nombre.indexOf(q) !== -1) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function filtrarCategoria(cat, btn) {
    document.querySelectorAll('.pos-cat-btn').forEach(function(b) { b.classList.remove('active'); });
    if (btn) btn.classList.add('active');

    var cards = document.querySelectorAll('.pos-prod-card');
    cards.forEach(function(card) {
      var c = card.getAttribute('data-cat');
      if (cat === 'todos' || c === cat) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function agregarAlCarrito(id, nombre, precio, stock) {
    if (stock <= 0) return;

    if (carrito[id]) {
      if (carrito[id].cantidad < stock) {
        carrito[id].cantidad++;
      } else {
        mostrarAlertaPOS('No hay más stock disponible para ' + nombre, 'warn');
        return;
      }
    } else {
      carrito[id] = {
        id: id,
        nombre: nombre,
        precio: Number(precio),
        cantidad: 1,
        stock: Number(stock),
      };
    }
    sonarCaja();
    renderizarCarrito();
  }

  function cambiarCantidad(id, delta) {
    if (!carrito[id]) return;
    carrito[id].cantidad += delta;
    if (carrito[id].cantidad <= 0) {
      delete carrito[id];
    } else if (carrito[id].cantidad > carrito[id].stock) {
      carrito[id].cantidad = carrito[id].stock;
      mostrarAlertaPOS('Límite de stock alcanzado (' + carrito[id].stock + ')', 'warn');
    }
    renderizarCarrito();
  }

  function eliminarItem(id) {
    delete carrito[id];
    renderizarCarrito();
  }

  function renderizarCarrito() {
    var container = document.getElementById('cart-items-container');
    var totalDisplay = document.getElementById('cart-total-display');
    var btnAmount = document.getElementById('btn-total-amount');
    var checkoutBtn = document.getElementById('pos-checkout-btn');

    var keys = Object.keys(carrito);
    if (keys.length === 0) {
      container.innerHTML = '<p id="cart-empty-msg" class="muted" style="text-align:center; padding:16px 0; font-size:13px; margin:0;">Selecciona productos arriba para agregarlos a la venta.</p>';
      totalDisplay.textContent = 'S/ 0.00';
      btnAmount.textContent = '0.00';
      checkoutBtn.disabled = true;
      return;
    }

    var total = 0;
    var html = '';

    keys.forEach(function(id) {
      var item = carrito[id];
      var sub = item.precio * item.cantidad;
      total += sub;

      html +=
        '<div class="pos-cart-item">' +
          '<div style="max-width:55%;">' +
            '<strong style="color:var(--text-bright); font-size:12.5px;">' + item.nombre + '</strong>' +
            '<div class="muted" style="font-size:11px;">S/ ' + item.precio.toFixed(2) + ' c/u</div>' +
          '</div>' +
          '<div style="display:flex; align-items:center; gap:6px;">' +
            '<button type="button" class="pos-qty-btn" onclick="cambiarCantidad(\'' + id + '\', -1);">-</button>' +
            '<span style="font-weight:700; font-size:13px; min-width:18px; text-align:center;">' + item.cantidad + '</span>' +
            '<button type="button" class="pos-qty-btn" onclick="cambiarCantidad(\'' + id + '\', 1);">+</button>' +
            '<strong style="margin-left:6px; min-width:50px; text-align:right; font-size:13px;">S/ ' + sub.toFixed(2) + '</strong>' +
            '<button type="button" style="background:none; border:none; cursor:pointer; color:var(--muted); display:inline-flex; align-items:center; margin-left:4px;" onclick="eliminarItem(\'' + id + '\');" title="Quitar">' + SVG_ICONS.close + '</button>' +
          '</div>' +
        '</div>';
    });

    container.innerHTML = html;
    totalDisplay.textContent = 'S/ ' + total.toFixed(2);
    btnAmount.textContent = total.toFixed(2);
    checkoutBtn.disabled = false;
  }

  function seleccionarMetodoPago(metodo, btn) {
    metodoSeleccionado = metodo;
    document.querySelectorAll('.pos-method-btn').forEach(function(b) { b.classList.remove('active'); });
    if (btn) btn.classList.add('active');
  }

  function mostrarAlertaPOS(texto, tipo) {
    var el = document.getElementById('pos-alert');
    el.style.display = 'block';
    el.textContent = texto;
    if (tipo === 'ok') {
      el.style.background = 'rgba(16,185,129,0.15)';
      el.style.color = 'var(--ok-ink)';
      el.style.border = '1px solid var(--ok-border)';
    } else {
      el.style.background = 'rgba(239,68,68,0.15)';
      el.style.color = 'var(--danger-ink)';
      el.style.border = '1px solid var(--danger-border)';
    }
    setTimeout(function() { el.style.display = 'none'; }, 4500);
  }

  function procesarVentaPOS() {
    var keys = Object.keys(carrito);
    if (!keys.length) return;

    var btn = document.getElementById('pos-checkout-btn');
    btn.disabled = true;
    btn.innerHTML = '<span style="display:inline-flex; align-items:center; gap:6px;">' + SVG_ICONS.card + ' Procesando cobro...</span>';

    var itemsPayload = keys.map(function(k) {
      return { producto_id: k, cantidad: carrito[k].cantidad, precio_unitario: carrito[k].precio };
    });

    var payload = {
      items: itemsPayload,
      socio_id: clienteActivo.id || null,
      metodo_pago: metodoSeleccionado,
    };

    fetch('/productos/venta-rapida', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
      },
      body: JSON.stringify(payload),
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      btn.disabled = false;
      btn.innerHTML = '<span style="display:inline-flex; align-items:center; gap:6px;">' + SVG_ICONS.zap + ' Cobrar y Entregar (S/ <span id="btn-total-amount">0.00</span>)</span>';

      if (!res.ok) {
        sonarAlerta();
        mostrarAlertaPOS(res.error || 'Error al procesar la venta.', 'error');
        return;
      }

      // Venta exitosa
      sonarCaja();
      mostrarAlertaPOS('Venta de S/ ' + res.total.toFixed(2) + ' cobrada con ' + res.metodo_pago.toUpperCase() + ' (' + res.socio + ')', 'ok');

      // Actualizar stocks en los botones de productos del DOM
      res.items.forEach(function(it) {
        var card = document.querySelector('.pos-prod-card[data-id="' + it.producto_id + '"]');
        if (card) {
          var currentStock = parseInt(card.getAttribute('data-stock') || '0', 10);
          var newStock = Math.max(0, currentStock - it.cantidad);
          card.setAttribute('data-stock', newStock);
          var stockLabel = card.querySelector('.pos-prod-stock');
          if (stockLabel) {
            stockLabel.textContent = newStock <= 0 ? 'Agotado' : 'Stock: ' + newStock;
          }
          if (newStock <= 0) {
            card.classList.add('out-of-stock');
          }
        }
      });

      // Agregar al feed de ventas de la columna 3
      agregarItemFeedVenta(res);

      // Limpiar carrito
      carrito = {};
      renderizarCarrito();

      // Regresar foco al input de DNI para la siguiente persona
      var input = document.getElementById('dni-input');
      if (input) input.focus();
    })
    .catch(function(err) {
      btn.disabled = false;
      btn.innerHTML = '<span style="display:inline-flex; align-items:center; gap:6px;">' + SVG_ICONS.zap + ' Cobrar y Entregar (S/ <span id="btn-total-amount">0.00</span>)</span>';
      sonarAlerta();
      mostrarAlertaPOS('Error de conexión al procesar venta: ' + err.message, 'error');
    });
  }

  function agregarItemFeedVenta(v) {
    var empty = document.getElementById('ventas-empty-msg');
    if (empty) empty.style.display = 'none';

    var feed = document.getElementById('ventas-feed');
    var countEl = document.getElementById('ventas-count');
    if (countEl) countEl.textContent = (parseInt(countEl.textContent || '0', 10) + 1);

    var nowStr = new Date().toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' });
    var div = document.createElement('div');
    div.className = 'feed-item';
    div.innerHTML =
      '<div style="max-width:65%;">' +
        '<strong style="font-size:12.5px; color:var(--text);">' + (v.socio || 'Cliente General') + '</strong>' +
        '<span class="muted" style="display:block; font-size:11px; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">' +
          v.concepto +
        '</span>' +
        '<span class="muted" style="font-size:10px;">' + nowStr + ' · <span style="text-transform:uppercase;">' + v.metodo_pago + '</span></span>' +
      '</div>' +
      '<div style="text-align:right;">' +
        '<span style="font-weight:800; font-size:13px; color:var(--primary); display:block;">S/ ' + v.total.toFixed(2) + '</span>' +
      '</div>';

    feed.insertBefore(div, feed.firstChild);
  }

  // Atajos de teclado: F2 para ir a DNI
  window.addEventListener('keydown', function(e) {
    if (e.key === 'F2') {
      e.preventDefault();
      var inp = document.getElementById('dni-input');
      if (inp) { inp.focus(); inp.select(); }
    }
  });

  // Foco inicial
  window.addEventListener('DOMContentLoaded', function() {
    var inp = document.getElementById('dni-input');
    if (inp) { inp.focus(); inp.select(); }
  });

  // ---------- MODAL FLOTANTE NUEVO SOCIO EN TERMINAL ----------
  function abrirModalSocioTerminal() {
    var f = document.getElementById('form-socio-terminal');
    if (f) f.reset();
    document.getElementById('modal-socio-terminal').classList.add('open');
    setTimeout(function() { document.getElementById('term-socio-nombres').focus(); }, 60);
  }

  function handleSocioTerminalSubmit(e) {
    e.preventDefault();
    var f = e.target;
    var btn = f.querySelector('button[type="submit"]');
    var alertBox = document.getElementById('term-socio-alert');
    alertBox.style.display = 'none';

    var data = {
      nombres: f.nombres.value.trim(),
      apellidos: f.apellidos.value.trim(),
      dni: f.dni.value.trim(),
      telefono: f.telefono.value.trim(),
      fecha_nacimiento: f.fecha_nacimiento.value.trim(),
      email: f.email.value.trim(),
      genero: f.genero.value,
      direccion: f.direccion.value.trim(),
      contacto_emergencia_nombre: f.contacto_emergencia_nombre.value.trim(),
      contacto_emergencia_telefono: f.contacto_emergencia_telefono.value.trim(),
      notas: f.notas.value.trim(),
      acepta_marketing: f.acepta_marketing.checked ? 'on' : 'off',
    };

    if (!data.nombres || !data.apellidos) {
      alertBox.textContent = 'Nombres y apellidos son obligatorios.';
      alertBox.style.display = 'block';
      alertBox.className = 'flash error';
      return false;
    }

    btn.disabled = true;
    btn.textContent = 'Guardando...';

    fetch('/socios', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
      },
      body: JSON.stringify(data),
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      btn.disabled = false;
      btn.textContent = 'Guardar Socio';
      if (res.ok) {
        sonarExito();
        cerrarModal('modal-socio-terminal');
        // Auto-seleccionar al socio recién creado en el mostrador del Terminal
        seleccionarSocioManualmente(res.id, res.nombres + ' ' + res.apellidos, res.dni, 'Sin plan', 'sin_suscripcion');
        // Mostrar alerta rápida
        var resultDiv = document.getElementById('checkin-result');
        if (resultDiv) {
          resultDiv.style.display = 'block';
          resultDiv.innerHTML =
            '<div class="active-member-banner warn">' +
              '<div style="font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:0.06em; color:#fbbf24; display:flex; align-items:center; gap:6px;">' +
                SVG_ICONS.alertCircle + ' SOCIO RECIÉN REGISTRADO (SIN PLAN)' +
              '</div>' +
              '<div style="font-size:18px; font-weight:800; color:var(--text-bright); margin:4px 0 2px;">' +
                res.nombres + ' ' + res.apellidos +
              '</div>' +
              '<div class="muted" style="font-size:12.5px;">DNI: <strong>' + (res.dni || '—') + '</strong> · ¡Listo para cobrar suscripción!</div>' +
              '<div class="actions" style="margin-top:10px;">' +
                '<a class="btn primary sm" href="/suscripciones/nueva?socio=' + res.id + '" target="_blank" style="display:inline-flex; align-items:center; gap:6px;">' +
                  SVG_ICONS.card + ' Cobrar / Asignar Plan Ahora' +
                '</a>' +
                '<a class="btn sm" href="/socios/' + res.id + '" target="_blank">Ver Ficha</a>' +
              '</div>' +
            '</div>';
        }
      } else {
        sonarAlerta();
        alertBox.textContent = res.error || 'Error al registrar socio.';
        alertBox.style.display = 'block';
        alertBox.className = 'flash error';
      }
    })
    .catch(function(err) {
      btn.disabled = false;
      btn.textContent = 'Guardar Socio';
      sonarAlerta();
      alertBox.textContent = 'Error de conexión: ' + err.message;
      alertBox.style.display = 'block';
      alertBox.className = 'flash error';
    });
  }

  function cerrarModal(id) {
    var m = document.getElementById(id);
    if (m) m.classList.remove('open');
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var open = document.querySelector('.modal-backdrop.open');
      if (open) open.classList.remove('open');
    }
  });
</script>

<!-- Modal Flotante: Registrar Socio desde Terminal -->
<div id="modal-socio-terminal" class="modal-backdrop" onclick="if(event.target===this) cerrarModal('modal-socio-terminal');">
  <div class="modal-dialog lg">
    <div class="modal-header">
      <h3 class="modal-title">
        <%- u.icon('userPlus', 16) %> Registrar Nuevo Socio al Mostrador
      </h3>
      <button type="button" class="modal-close" onclick="cerrarModal('modal-socio-terminal');" aria-label="Cerrar">
        <%- u.icon('close', 16) %>
      </button>
    </div>
    <form id="form-socio-terminal" onsubmit="return handleSocioTerminalSubmit(event);" class="stack" style="margin:0;">
      <div class="modal-body">
        <div id="term-socio-alert" style="display:none; margin-bottom:12px;"></div>
        <div class="grid2">
          <div>
            <label for="term-socio-nombres">Nombres *</label>
            <input id="term-socio-nombres" name="nombres" required placeholder="Ej: Juan Carlos">
          </div>
          <div>
            <label for="term-socio-apellidos">Apellidos *</label>
            <input id="term-socio-apellidos" name="apellidos" required placeholder="Ej: Pérez García">
          </div>
        </div>

        <div class="grid3">
          <div>
            <label for="term-socio-dni">DNI / Documento</label>
            <input id="term-socio-dni" name="dni" placeholder="8 dígitos...">
          </div>
          <div>
            <label for="term-socio-tel">Teléfono (WhatsApp)</label>
            <input id="term-socio-tel" name="telefono" placeholder="Ej: 987654321">
          </div>
          <div>
            <label for="term-socio-fnac">Fecha de Nacimiento</label>
            <input type="date" id="term-socio-fnac" name="fecha_nacimiento">
          </div>
        </div>

        <div class="grid3">
          <div>
            <label for="term-socio-email">Correo Electrónico</label>
            <input type="email" id="term-socio-email" name="email" placeholder="socio@email.com">
          </div>
          <div>
            <label for="term-socio-genero">Género</label>
            <select id="term-socio-genero" name="genero">
              <option value="">—</option>
              <option value="M">Masculino</option>
              <option value="F">Femenino</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div>
            <label for="term-socio-dir">Dirección</label>
            <input id="term-socio-dir" name="direccion" placeholder="Av. Principal 123...">
          </div>
        </div>

        <div class="grid2">
          <div>
            <label for="term-socio-cemer">Contacto de Emergencia</label>
            <input id="term-socio-cemer" name="contacto_emergencia_nombre" placeholder="Familiar / Amigo">
          </div>
          <div>
            <label for="term-socio-temer">Teléfono de Emergencia</label>
            <input id="term-socio-temer" name="contacto_emergencia_telefono" placeholder="Número de contacto">
          </div>
        </div>

        <div>
          <label for="term-socio-notas">Notas / Salud</label>
          <textarea id="term-socio-notas" name="notas" rows="2" placeholder="Observaciones, lesiones..."></textarea>
        </div>

        <div>
          <label style="display:flex; gap:8px; align-items:center; cursor:pointer;">
            <input type="checkbox" id="term-socio-mkt" name="acepta_marketing" style="width:auto;" checked>
            <span>Acepta avisos y confirmaciones de pago por WhatsApp</span>
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="cerrarModal('modal-socio-terminal');">Cancelar</button>
        <button type="submit" class="btn primary">Guardar Socio</button>
      </div>
    </form>
  </div>
</div>
