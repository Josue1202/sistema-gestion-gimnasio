<div class="terminal-container">
  <!-- Cabecera Superior del Terminal -->
  <div class="toolbar" style="margin-bottom:16px;">
    <div>
      <h1 class="mb0" style="display:flex; align-items:center; gap:10px; font-size:24px;">
        <%- u.icon('terminal', 24) %> Terminal de Recepción & Mostrador POS
      </h1>
      <p class="muted" style="margin-top:4px; font-size:13.5px;">
        Control de acceso inmediato, venta rápida de productos y atención continua sin cambiar de pantalla.
      </p>
    </div>
    <div class="actions">
      <button class="btn primary" type="button" onclick="abrirModalSocioTerminal();" style="display:inline-flex; align-items:center; gap:6px;"><%- u.icon('userPlus', 16) %> Nuevo Socio</button>
      <a class="btn" href="/caja" style="display:inline-flex; align-items:center; gap:6px;"><%- u.icon('caja', 16) %> Caja del Día</a>
      <a class="btn" href="/productos" style="display:inline-flex; align-items:center; gap:6px;"><%- u.icon('productos', 16) %> Inventario</a>
    </div>
  </div>

  <!-- Contenedor Grid 3-en-1 -->
  <div class="terminal-grid">

    <!-- ========================================================
         DIVISIÓN 1: CONTROL DE ACCESO & CHECK-IN
         ======================================================== -->
    <div class="terminal-card terminal-col-checkin">
      <div class="terminal-header">
        <h2 class="terminal-title">
          <%- u.icon('zap', 20) %> Check-in de Asistencia
        </h2>
        <span class="badge ok" style="font-size:11px; display:inline-flex; align-items:center; gap:4px;">
          <%- u.icon('checkCircle', 12) %> Lector Activo
        </span>
      </div>

      <!-- Input de marcado rápido -->
      <form id="checkin-form" method="post" action="/asistencia/marcar" onsubmit="return handleCheckinSubmit(event);">
        <div class="checkin-input-wrap">
          <label for="dni-input" style="display:block; font-size:12px; font-weight:700; color:var(--muted); margin-bottom:6px; text-transform:uppercase; letter-spacing:0.04em;">
            Escanear código de barras o digitar DNI / Nombre:
          </label>
          <input type="text" id="dni-input" name="dni" placeholder="Ej: 45678901..." autofocus autocomplete="off">
        </div>
        <button class="btn primary" type="submit" style="width:100%; font-size:14.5px; font-weight:700; padding:11px; display:inline-flex; align-items:center; justify-content:center; gap:8px;">
          <%- u.icon('checkCircle', 18) %> Marcar Acceso (Enter)
        </button>
      </form>

      <!-- Banner de Resultado del Check-in -->
      <div id="checkin-result" style="<%= ultimoCheckin ? '' : 'display:none;' %> margin-top:14px;">
        <% if (ultimoCheckin) {
             var uc = ultimoCheckin;
             var isOk = uc.estado === 'activo';
             var isWarn = uc.estado === 'por_vencer';
             var isDanger = uc.estado === 'vencido';
             var bannerClass = isOk ? '' : (isWarn ? 'warn' : 'danger');
             var statusColor = isOk ? '#3ECF8E' : (isWarn ? '#fbbf24' : '#f15c6d');
        %>
          <div class="active-member-banner <%= bannerClass %>" id="banner-box">
            <div style="font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:0.06em; color:<%= statusColor %>; display:flex; align-items:center; gap:6px;" id="banner-status">
              <% if (isOk) { %>
                <%- u.icon('checkCircle', 16) %> ACCESO CONCEDIDO
              <% } else if (isWarn) { %>
                <%- u.icon('alertCircle', 16) %> ACCESO CONCEDIDO (POR VENCER)
              <% } else { %>
                <%- u.icon('closeCircle', 16) %> MEMBRESÍA VENCIDA
              <% } %>
            </div>
            <div style="font-size:19px; font-weight:800; color:var(--text-bright); margin:4px 0 2px;" id="banner-name">
              <%= uc.nombre %>
            </div>
            <div class="muted" style="font-size:13px;" id="banner-detail">
              DNI: <strong id="banner-dni"><%= uc.dni %></strong> · Plan: <strong id="banner-plan"><%= uc.plan %></strong>
              <% if (uc.fecha_fin) { %> · Vence: <strong id="banner-fecha"><%= uc.fecha_fin %></strong><% } %>
              <% if (uc.dias_restantes != null) { %> (<span id="banner-dias"><%= uc.dias_restantes %></span> días restantes)<% } %>
            </div>
            <div class="actions" style="margin-top:10px;" id="banner-actions">
              <% if (isWarn || isDanger || uc.estado === 'sin_suscripcion') { %>
                <a class="btn primary sm" href="/suscripciones/nueva?socio=<%= uc.socio_id %>" target="_blank" style="display:inline-flex; align-items:center; gap:6px;">
                  <%- u.icon('card', 14) %> Cobrar / Renovar Plan
                </a>
              <% } %>
              <a class="btn sm" href="/socios/<%= uc.socio_id %>" target="_blank">Ver Ficha</a>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Componente: Socio Seleccionado para Mostrador / POS -->
      <div class="card" style="margin-top:16px; background:var(--surface-2); border:1px solid var(--border); padding:14px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <span style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--muted); display:inline-flex; align-items:center; gap:6px;">
            <%- u.icon('user', 14) %> Cliente Activo en Mostrador
          </span>
          <button type="button" class="btn sm" onclick="desvincularClienteMostrador();" style="padding:2px 8px; font-size:11px; display:inline-flex; align-items:center; gap:4px;">
            <%- u.icon('close', 12) %> Poner Anónimo
          </button>
        </div>

        <div id="active-client-info">
          <% if (ultimoCheckin) { %>
            <div style="font-size:15px; font-weight:700; color:var(--primary);" id="active-client-name">
              <%= ultimoCheckin.nombre %>
            </div>
            <div class="muted" style="font-size:12px;" id="active-client-doc">
              DNI: <%= ultimoCheckin.dni %> · Plan: <%= ultimoCheckin.plan %>
            </div>
            <input type="hidden" id="active-client-id" value="<%= ultimoCheckin.socio_id %>">
          <% } else { %>
            <div style="font-size:14px; font-weight:600; color:var(--muted);" id="active-client-name">
              Público General / Mostrador
            </div>
            <div class="muted" style="font-size:11.5px;" id="active-client-doc">
              Las ventas se registrarán sin socio asignado (o marca asistencia para asociar).
            </div>
            <input type="hidden" id="active-client-id" value="">
          <% } %>
        </div>
      </div>

      <!-- Coincidencias de búsqueda si hubo desambiguación -->
      <% if (q && encontrados && encontrados.length) { %>
        <div style="margin-top:16px;">
          <span class="muted" style="font-size:12px; font-weight:600;">Socios encontrados para "<%= q %>":</span>
          <div style="max-height:180px; overflow-y:auto; margin-top:6px; display:flex; flex-direction:column; gap:6px;">
            <% encontrados.forEach(function(s){ %>
              <div style="display:flex; justify-content:space-between; align-items:center; background:var(--surface-2); padding:8px 10px; border-radius:6px; border:1px solid var(--border);">
                <div>
                  <strong style="font-size:13px;"><%= s.apellidos %>, <%= s.nombres %></strong>
                  <span class="muted" style="font-size:11px; display:block;">DNI: <%= s.dni || '—' %> · <%= s.plan_nombre || 'Sin plan' %></span>
                </div>
                <button type="button" class="btn sm primary"
                        data-id="<%= s.id %>"
                        data-nombre="<%= s.nombres %> <%= s.apellidos %>"
                        data-dni="<%= s.dni || '' %>"
                        data-plan="<%= s.plan_nombre || '' %>"
                        data-estado="<%= s.estado_membresia %>"
                        onclick="seleccionarSocioDesdeBoton(this)">
                  Seleccionar
                </button>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- ========================================================
         DIVISIÓN 2: PUNTO DE VENTA RÁPIDO (POS MOSTRADOR)
         ======================================================== -->
    <div class="terminal-card terminal-col-pos">
      <div class="terminal-header">
        <h2 class="terminal-title">
          <%- u.icon('coffee', 20) %> Punto de Venta Rápido
        </h2>
        <span class="badge ok" style="font-size:11px; display:inline-flex; align-items:center; gap:4px;">
          <%- u.icon('zap', 12) %> 1-Clic
        </span>
      </div>

      <!-- Barra de Filtro y Búsqueda de Productos -->
      <div class="pos-filter-bar">
        <input type="text" id="pos-search" class="pos-search-input" placeholder="Filtrar productos (agua, gatorade, barra, batido)..." oninput="filtrarProductos(this.value);" autocomplete="off">
      </div>

      <!-- Chips de Categorías Rápidas -->
      <div class="pos-category-chips">
        <button type="button" class="pos-cat-btn active" onclick="filtrarCategoria('todos', this);">Todos</button>
        <button type="button" class="pos-cat-btn" onclick="filtrarCategoria('agua', this);"><%- u.icon('water', 14) %> Aguas</button>
        <button type="button" class="pos-cat-btn" onclick="filtrarCategoria('isotonica', this);"><%- u.icon('zap', 14) %> Isotónicas</button>
        <button type="button" class="pos-cat-btn" onclick="filtrarCategoria('proteina', this);"><%- u.icon('bag', 14) %> Proteínas</button>
        <button type="button" class="pos-cat-btn" onclick="filtrarCategoria('batido', this);"><%- u.icon('coffee', 14) %> Batidos</button>
        <button type="button" class="pos-cat-btn" onclick="filtrarCategoria('otros', this);"><%- u.icon('tag', 14) %> Otros</button>
      </div>

      <!-- Grid de Productos -->
      <div class="pos-products-grid" id="pos-grid">
        <% if (!productos || !productos.length) { %>
          <div style="grid-column:span 3; padding:20px; text-align:center; color:var(--muted);">
            No hay productos registrados en el inventario. <a href="/productos/nuevo">Crear producto</a>.
          </div>
        <% } else { %>
          <% productos.forEach(function(p){
               var nomLower = p.nombre.toLowerCase();
               var iconKey = 'coffee';
               var cat = 'otros';
               if (nomLower.includes('agua') || nomLower.includes('mineral') || nomLower.includes('san luis') || nomLower.includes('cielo')) {
                 iconKey = 'water'; cat = 'agua';
               } else if (nomLower.includes('gatorade') || nomLower.includes('sporade') || nomLower.includes('power') || nomLower.includes('isotonica') || nomLower.includes('isotónica') || nomLower.includes('monster') || nomLower.includes('red bull')) {
                 iconKey = 'zap'; cat = 'isotonica';
               } else if (nomLower.includes('barra') || nomLower.includes('snack') || nomLower.includes('galleta') || nomLower.includes('chocolate')) {
                 iconKey = 'bag'; cat = 'proteina';
               } else if (nomLower.includes('batido') || nomLower.includes('whey') || nomLower.includes('shaker') || nomLower.includes('proteina') || nomLower.includes('proteína') || nomLower.includes('creatina')) {
                 iconKey = 'coffee'; cat = 'batido';
               } else {
                 iconKey = 'tag'; cat = 'otros';
               }
               var sinStock = p.stock <= 0;
          %>
            <div class="pos-prod-card <%= sinStock ? 'out-of-stock' : '' %>"
                 data-id="<%= p.id %>"
                 data-nombre="<%= p.nombre %>"
                 data-precio="<%= p.precio %>"
                 data-stock="<%= p.stock %>"
                 data-cat="<%= cat %>"
                 onclick="agregarCardAlCarrito(this);">
              <div>
                <div class="pos-prod-icon"><%- u.icon(iconKey, 24) %></div>
                <div class="pos-prod-name" title="<%= p.nombre %>"><%= p.nombre %></div>
              </div>
              <div>
                <div class="pos-prod-price"><%= u.soles(p.precio) %></div>
                <div class="pos-prod-stock">
                  <%= sinStock ? 'Agotado' : 'Stock: ' + p.stock %>
                </div>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>

      <!-- Carrito de Compras Rápido -->
      <div class="pos-cart-box">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; border-bottom:1px solid var(--border); padding-bottom:6px;">
          <strong style="font-size:13.5px; color:var(--text-bright); display:flex; align-items:center; gap:6px;">
            <%- u.icon('cart', 16) %> Carrito de Venta
          </strong>
          <span id="cart-buyer-badge" class="badge" style="background:rgba(16,185,129,0.12); color:var(--ok-ink); font-size:11px;">
            Mostrador General
          </span>
        </div>

        <div id="cart-items-container" class="pos-cart-list">
          <p id="cart-empty-msg" class="muted" style="text-align:center; padding:16px 0; font-size:13px; margin:0;">
            Selecciona productos arriba para agregarlos a la venta.
          </p>
        </div>

        <!-- Total de la Venta -->
        <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-top:1px dashed var(--border); margin-top:6px;">
          <span style="font-size:14px; font-weight:700;">TOTAL A COBRAR:</span>
          <span id="cart-total-display" style="font-size:22px; font-weight:800; color:var(--primary);">S/ 0.00</span>
        </div>

        <!-- Métodos de pago con 1 Clic -->
        <div style="margin-top:8px;">
          <label style="font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase;">Método de Pago:</label>
          <div class="pos-methods-row">
            <button type="button" class="pos-method-btn active" data-metodo="efectivo" onclick="seleccionarMetodoPago('efectivo', this);"><%- u.icon('cash', 14) %> Efectivo</button>
            <button type="button" class="pos-method-btn" data-metodo="yape" onclick="seleccionarMetodoPago('yape', this);"><%- u.icon('mobile', 14) %> Yape</button>
            <button type="button" class="pos-method-btn" data-metodo="plin" onclick="seleccionarMetodoPago('plin', this);"><%- u.icon('mobile', 14) %> Plin</button>
            <button type="button" class="pos-method-btn" data-metodo="tarjeta" onclick="seleccionarMetodoPago('tarjeta', this);"><%- u.icon('card', 14) %> Tarjeta</button>
            <button type="button" class="pos-method-btn" data-metodo="transferencia" onclick="seleccionarMetodoPago('transferencia', this);"><%- u.icon('building', 14) %> Transf</button>
          </div>
        </div>

        <!-- Botón de Cobro Inmediato -->
        <button type="button" id="pos-checkout-btn" class="pos-checkout-btn" onclick="procesarVentaPOS();" disabled style="margin-top:10px;">
          <span style="display:inline-flex; align-items:center; gap:6px;">
            <%- u.icon('zap', 16) %> Cobrar y Entregar (S/ <span id="btn-total-amount">0.00</span>)
          </span>
        </button>

        <div id="pos-alert" style="display:none; margin-top:8px; font-size:12.5px; padding:8px 12px; border-radius:6px;"></div>
      </div>
    </div>

    <!-- ========================================================
         DIVISIÓN 3: MONITOR EN VIVO (ACTIVIDAD Y CAJA)
         ======================================================== -->
    <div class="terminal-card terminal-col-monitor">
      <div class="terminal-header">
        <h2 class="terminal-title">
          <%- u.icon('reportes', 20) %> Monitor en Vivo
        </h2>
        <a href="/asistencia" style="font-size:12px; display:inline-flex; align-items:center; gap:4px;">
          <%- u.icon('refresh', 13) %> Refrescar
        </a>
      </div>

      <!-- Resumen Rápido de Caja -->
      <div style="background:var(--surface-2); border:1px solid var(--border); border-radius:var(--radius); padding:12px; margin-bottom:16px;">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <div>
            <span style="font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase;">Caja de Hoy:</span>
            <div style="font-size:20px; font-weight:800; color:var(--ok-ink); margin-top:2px;">
              <%= caja ? u.soles(caja.total_ingresos) : 'S/ 0.00' %>
            </div>
          </div>
          <div>
            <% if (caja) { %>
              <span class="badge ok" style="font-size:11px; display:inline-flex; align-items:center; gap:4px;">
                <%- u.icon('checkCircle', 12) %> Caja Abierta
              </span>
            <% } else { %>
              <a href="/caja" class="badge warn" style="font-size:11px; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
                <%- u.icon('alertCircle', 12) %> Abrir Caja
              </a>
            <% } %>
          </div>
        </div>
        <div class="muted" style="font-size:11.5px; margin-top:4px;">
          Cobros socios + ventas mostrador en tiempo real.
        </div>
      </div>

      <!-- Feed de Últimas Asistencias -->
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <h3 style="margin:0; font-size:13.5px; font-weight:700; color:var(--text-bright); display:flex; align-items:center; gap:6px;">
            <%- u.icon('gym', 16) %> Asistencias del Turno (<span id="asistencias-count"><%= hoy.length %></span>)
          </h3>
          <span class="muted" style="font-size:11px;">Hoy</span>
        </div>

        <div id="asistencias-feed" style="max-height:220px; overflow-y:auto; padding-right:2px; margin-bottom:16px;">
          <% if (!hoy.length) { %>
            <p id="asistencias-empty-msg" class="muted" style="font-size:12.5px; padding:10px 0; text-align:center; margin:0;">
              Aún no hay asistencias registradas hoy.
            </p>
          <% } else { %>
            <% hoy.slice(0, 15).forEach(function(a){ %>
              <div class="feed-item" id="asist-item-<%= a.socio_id %>">
                <div>
                  <a href="/socios/<%= a.socio_id %>" target="_blank" style="font-weight:700; font-size:13px; color:var(--text);">
                    <%= a.nombres %> <%= a.apellidos %>
                  </a>
                  <span class="muted" style="display:block; font-size:11px;">
                    <%= a.plan_nombre || 'Sin plan' %> · <%= u.fechaHora(a.fecha).split(' ')[1] || '' %>
                  </span>
                </div>
                <div style="display:flex; align-items:center; gap:6px;">
                  <button type="button" class="btn sm" style="font-size:11px; padding:3px 8px; display:inline-flex; align-items:center; gap:4px;"
                          data-id="<%= a.socio_id %>"
                          data-nombre="<%= a.nombres %> <%= a.apellidos %>"
                          data-dni="<%= a.dni || '' %>"
                          data-plan="<%= a.plan_nombre || '' %>"
                          data-estado="activo"
                          onclick="seleccionarSocioDesdeBoton(this);"
                          title="Vender productos a este socio en el POS">
                    <%- u.icon('cart', 12) %> Vender
                  </button>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <!-- Feed de Últimas Ventas de Productos -->
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <h3 style="margin:0; font-size:13.5px; font-weight:700; color:var(--text-bright); display:flex; align-items:center; gap:6px;">
            <%- u.icon('coffee', 16) %> Últimas Ventas del Mostrador (<span id="ventas-count"><%= ventasHoy.length %></span>)
          </h3>
          <a href="/productos" style="font-size:11px;">Ver todas</a>
        </div>

        <div id="ventas-feed" style="max-height:240px; overflow-y:auto; padding-right:2px;">
          <% if (!ventasHoy.length) { %>
            <p id="ventas-empty-msg" class="muted" style="font-size:12.5px; padding:10px 0; text-align:center; margin:0;">
              No se han registrado ventas de mostrador hoy.
            </p>
          <% } else { %>
            <% ventasHoy.forEach(function(v){ %>
              <div class="feed-item">
                <div style="max-width:65%;">
                  <strong style="font-size:12.5px; color:var(--text);"><%= v.comprador %></strong>
                  <span class="muted" style="display:block; font-size:11px; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">
                    <%= v.concepto %>
                  </span>
                  <span class="muted" style="font-size:10px;">
                    <%= u.fechaHora(v.creado_en).split(' ')[1] || '' %> · <span style="text-transform:uppercase;"><%= v.metodo_pago %></span>
                  </span>
                </div>
                <div style="text-align:right;">
                  <span style="font-weight:800; font-size:13px; color:var(--primary); display:block;">
                    <%= u.soles(v.monto) %>
                  </span>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

    </div>

  </div>
</div>

<!-- ============================================================
     SCRIPTS DE ALTA VELOCIDAD: CHECK-IN + CARRITO POS
     ============================================================ -->
<script>
  // ---------- SONIDOS WEB AUDIO API NATIVOS ----------
  var audioCtx = null;
  function getAudioContext() {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    return audioCtx;
  }

  function sonarExito() {
    try {
      var ctx = getAudioContext();
      var now = ctx.currentTime;
      var osc1 = ctx.createOscillator();
      var gain1 = ctx.createGain();
      osc1.type = 'sine';
      osc1.frequency.setValueAtTime(587.33, now); // D5
      osc1.frequency.exponentialRampToValueAtTime(880, now + 0.15); // A5
      gain1.gain.setValueAtTime(0.2, now);
      gain1.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
      osc1.connect(gain1);
      gain1.connect(ctx.destination);
      osc1.start(now);
      osc1.stop(now + 0.35);
    } catch(e) {}
  }

  function sonarAlerta() {
    try {
      var ctx = getAudioContext();
      var now = ctx.currentTime;
      var osc = ctx.createOscillator();
      var gain = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(260, now);
      osc.frequency.setValueAtTime(200, now + 0.15);
      gain.gain.setValueAtTime(0.3, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.4);
    } catch(e) {}
  }

  function sonarCaja() {
    try {
      var ctx = getAudioContext();
      var now = ctx.currentTime;
      var osc = ctx.createOscillator();
      var gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(987.77, now); // B5
      osc.frequency.setValueAtTime(1318.51, now + 0.08); // E6
      gain.gain.setValueAtTime(0.25, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.3);
    } catch(e) {}
  }

  // ---------- ESTADO GLOBAL DEL TERMINAL ----------
  var clienteActivo = {
    id: '<%= ultimoCheckin ? ultimoCheckin.socio_id : "" %>',
    nombre: '<%= ultimoCheckin ? ultimoCheckin.nombre : "Público General / Mostrador" %>',
    dni: '<%= ultimoCheckin ? ultimoCheckin.dni : "" %>',
    plan: '<%= ultimoCheckin ? ultimoCheckin.plan : "" %>',
  };

  var carrito = {}; // { prodId: { id, nombre, precio, cantidad, stock } }
  var metodoSeleccionado = 'efectivo';

  // Helper para agregar al carrito desde el elemento card
  function agregarCardAlCarrito(card) {
    var id = card.getAttribute('data-id');
    var nombre = card.getAttribute('data-nombre');
    var precio = parseFloat(card.getAttribute('data-precio')) || 0;
    var stock = parseInt(card.getAttribute('data-stock'), 10) || 0;
    agregarAlCarrito(id, nombre, precio, stock);
  }

  // Helper para seleccionar socio desde botón data-*
  function seleccionarSocioDesdeBoton(btn) {
    var id = btn.getAttribute('data-id');
    var nombre = btn.getAttribute('data-nombre');
    var dni = btn.getAttribute('data-dni');
    var plan = btn.getAttribute('data-plan');
    var estado = btn.getAttribute('data-estado');
    seleccionarSocioManualmente(id, nombre, dni, plan, estado);
  }

  // ---------- MANEJO DE CHECK-IN RÁPIDO ----------
  function handleCheckinSubmit(e) {
    e.preventDefault();
    var input = document.getElementById('dni-input');
    var val = (input.value || '').trim();
    if (!val) return false;

    fetch('/asistencia/marcar', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
      },
      body: JSON.stringify({ dni: val }),
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (!data.ok) {
        sonarAlerta();
        mostrarBannerError(data.error || 'Socio no encontrado. Revisa el DNI.');
        return;
      }

      // Check-in exitoso
      if (data.estado === 'activo' || data.estado === 'por_vencer') {
        sonarExito();
      } else {
        sonarAlerta();
      }

      // Actualizar Banner
      actualizarBannerCheckin(data);

      // Vincular automáticamente al socio como cliente activo en POS
      seleccionarSocioManualmente(data.socio_id, data.nombre, data.dni, data.plan, data.estado);

      // Agregar al feed de asistencias en tiempo real
      agregarItemFeedAsistencia(data);

      // Limpiar input y re-enfocar para el siguiente socio
      input.value = '';
      input.focus();
    })
    .catch(function(err) {
      // Fallback a envio normal de formulario si falla fetch
      document.getElementById('checkin-form').submit();
    });

    return false;
  }

