<div class="toolbar">
  <div>
    <h1 class="mb0">Canales de WhatsApp</h1>
    <p class="muted" style="margin-top:4px;">Gestiona la mensajería oficial en la nube de Meta y la pasarela de WhatsApp Web.</p>
  </div>
  <div class="actions">
    <a class="btn" href="/mensajes">Ir a Mensajería</a>
  </div>
</div>

<div class="row" style="margin-top:16px; gap:20px; align-items:flex-start;">
  <!-- Columna izquierda: Canales disponibles -->
  <div style="flex:1.2; display:flex; flex-direction:column; gap:16px;">
    
    <!-- CANAL 1: Meta Cloud API Oficial -->
    <div class="card" style="border-left: 4px solid var(--primary, #059669);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:8px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <h2 class="mt0 mb0" style="font-size:17px; display:inline-flex; align-items:center; gap:6px;">
            <%- u.icon('checkCircle', 18) %> Canal 1: Meta Cloud API (Oficial)
          </h2>
        </div>
        <% if (metaInfo && metaInfo.ok) { %>
          <span class="badge ok" style="font-size:12px; padding:4px 10px; display:inline-flex; align-items:center; gap:4px;">
            <%- u.icon('checkCircle', 12) %> ACTIVO Y OPERATIVO (0% BAN)
          </span>
        <% } else if (metaInfo && metaInfo.configured) { %>
          <span class="badge warn" style="font-size:12px; padding:4px 10px;">
            <%- u.icon('alertCircle', 12) %> REVISAR TOKEN DE META
          </span>
        <% } else { %>
          <span class="badge muted" style="font-size:12px; padding:4px 10px;">NO CONFIGURADO</span>
        <% } %>
      </div>

      <% if (metaInfo && metaInfo.ok) { %>
        <div style="background:var(--ok-bg, #ecfdf5); border:1px solid var(--ok-border, #a7f3d0); border-radius:var(--radius-lg, 8px); padding:14px; margin-bottom:12px;">
          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap:10px; font-size:13px;">
            <div>
              <span class="muted" style="display:block; font-size:11px; text-transform:uppercase; letter-spacing:0.5px;">Número Emisor:</span>
              <strong style="color:var(--text, #111827);"><%= metaInfo.displayPhone || 'Conectado' %></strong>
            </div>
            <div>
              <span class="muted" style="display:block; font-size:11px; text-transform:uppercase; letter-spacing:0.5px;">Calidad de Cuenta:</span>
              <span style="color:#059669; font-weight:700;"><%= metaInfo.qualityRating || 'ÓPTIMA (GREEN)' %></span>
            </div>
            <div>
              <span class="muted" style="display:block; font-size:11px; text-transform:uppercase; letter-spacing:0.5px;">Plataforma:</span>
              <strong>Meta Graph Cloud API</strong>
            </div>
          </div>
          <p class="muted" style="margin:10px 0 0; font-size:12.5px; line-height:1.5;">
            🛡️ <strong>Ventaja corporativa:</strong> Conexión directa a los servidores oficiales de Meta. Cero riesgo de baneo, mensajes prioritarios y entrega inmediata para cobros y recordatorios.
          </p>
        </div>
      <% } else if (metaInfo && metaInfo.configured) { %>
        <div style="background:var(--warn-bg, #fffbeb); border:1px solid var(--warn-border, #fde68a); border-radius:8px; padding:12px; margin-bottom:12px; font-size:13px;">
          <strong style="color:#b45309;">Aviso de Meta API:</strong> <%= metaInfo.error || 'Token temporal expirado o no válido.' %>
        </div>
      <% } else { %>
        <p class="muted" style="font-size:13px; margin-bottom:8px;">
          Configura tus credenciales de Meta Developer en las variables de entorno para activar el canal oficial con 0% riesgo de baneo.
        </p>
      <% } %>
    </div>

    <!-- CANAL 2: Evolution API (WhatsApp Web / QR) -->
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:8px;">
        <h2 class="mt0 mb0" style="font-size:17px; display:inline-flex; align-items:center; gap:6px;">
          <%- u.icon('whatsapp', 18) %> Canal 2: Evolution API (WhatsApp Web / QR)
        </h2>
        <% if (estado === 'open') { %>
          <span class="badge ok" style="font-size:12px; padding:4px 10px; display:inline-flex; align-items:center; gap:4px;">
            <%- u.icon('checkCircle', 12) %> QR VINCULADO
          </span>
        <% } else if (estado === 'connecting') { %>
          <span class="badge warn" style="font-size:12px; padding:4px 10px; display:inline-flex; align-items:center; gap:4px;">
            <%- u.icon('alertCircle', 12) %> CONECTANDO...
          </span>
        <% } else { %>
          <span class="badge danger" style="font-size:12px; padding:4px 10px; display:inline-flex; align-items:center; gap:4px;">
            <%- u.icon('closeCircle', 12) %> DESCONECTADO (ESCANEAR QR)
          </span>
        <% } %>
      </div>

      <% if (estado === 'open') { %>
        <div style="background:var(--surface-2); border-radius:var(--radius-lg); padding:14px; margin-bottom:14px;">
          <% if (info && info.ownerJid) { %>
            <p style="margin:0 0 6px; font-weight:600; font-size:13.5px;">
              Número vinculado: +<%= info.ownerJid.split('@')[0] %>
              <% if (info.profileName) { %> (<%= info.profileName %>)<% } %>
            </p>
          <% } %>
          <p class="muted" style="margin:0; font-size:12.5px;">
            El teléfono físico del gimnasio está conectado como sesión activa de WhatsApp Web en el servidor.
          </p>
        </div>

        <div class="actions">
          <form method="post" action="/whatsapp/desconectar" onsubmit="return confirm('¿Seguro que deseas desvincular este número de WhatsApp?');">
            <button class="btn danger sm" type="submit">Desvincular WhatsApp</button>
          </form>
          <form method="post" action="/whatsapp/reiniciar" onsubmit="return confirm('Esto cerrará la sesión actual y creará un QR nuevo. ¿Continuar?');">
            <button class="btn sm" type="submit" style="display:inline-flex; align-items:center; gap:6px;">
              <%- u.icon('refresh', 13) %> Reiniciar sesión QR
            </button>
          </form>
        </div>

      <% } else { %>
        <div style="text-align:center; padding:6px 0;">
          <div style="display:inline-block; text-align:left; background:var(--surface-2); padding:10px 16px; border-radius:8px; margin-bottom:14px; font-size:12.5px; line-height:1.6;">
            1. Abre <strong>WhatsApp</strong> en el teléfono celular del gimnasio.<br>
            2. Toca <strong>Dispositivos vinculados</strong> > <strong>Vincular un dispositivo</strong>.<br>
            3. Escanea el código QR que se muestra abajo.
          </div>

          <div id="qr-container" style="min-height:240px; display:flex; flex-direction:column; align-items:center; justify-content:center;">
            <div id="qr-box" style="background:#fff; padding:12px; border-radius:10px; box-shadow:0 3px 15px rgba(0,0,0,0.15); display:inline-block;">
              <img id="qr-img" src="<%= qr ? (qr.startsWith('data:') ? qr : 'data:image/png;base64,' + qr) : '' %>"
                   alt="Código QR de WhatsApp"
                   style="width:200px; height:200px; display:<%= qr ? 'block' : 'none' %>;">
              <div id="qr-spinner" style="display:<%= qr ? 'none' : 'block' %>; padding:35px 20px; text-align:center; color:#4a5568;">
                <div style="display:flex; justify-content:center; margin-bottom:8px;"><%- u.icon('clock', 24) %></div>
                Generando código QR...
              </div>
            </div>
            
            <div style="width:200px; margin-top:10px;">
              <div class="bar-track" style="height:3px;">
                <div id="qr-timer-bar" class="bar" style="width:100%; transition: width 1s linear;"></div>
              </div>
              <p class="muted" style="font-size:11px; margin-top:4px;">
                Actualiza en <span id="countdown">15</span>s
              </p>
            </div>
          </div>

          <div class="actions" style="justify-content:center; margin-top:14px;">
            <button class="btn sm" type="button" onclick="recargarQRManual();" style="display:inline-flex; align-items:center; gap:5px;">
              <%- u.icon('refresh', 12) %> Actualizar QR
            </button>
            <form method="post" action="/whatsapp/reiniciar" onsubmit="return confirm('Esto creará una sesión limpia. ¿Deseas reiniciar?');" style="margin:0;">
              <button class="btn sm danger" type="submit" style="display:inline-flex; align-items:center; gap:5px;">
                <%- u.icon('alert', 12) %> Reiniciar sesión
              </button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Columna derecha: Probador y Documentación -->
  <div style="flex:1; display:flex; flex-direction:column; gap:16px;">
    <div class="card">
      <h2 class="mt0" style="font-size:17px;">Probar envío de WhatsApp</h2>
      <p class="muted" style="font-size:13px; margin-bottom:14px;">Prueba el despacho en vivo a tu celular seleccionando el canal preferido.</p>
      
      <form method="post" action="/whatsapp/probar" class="stack">
        <div>
          <label>Canal de Envío</label>
          <select name="canal" style="width:100%; padding:8px 10px; border-radius:6px; border:1px solid var(--border); background:var(--surface);">
            <option value="meta" <%= (metaInfo && metaInfo.ok) ? 'selected' : '' %>>
              Meta Cloud API (Oficial - Recomendado 0% Ban)
            </option>
            <option value="evolution" <%= (!metaInfo || !metaInfo.ok) && estado === 'open' ? 'selected' : '' %>>
              Evolution API (WhatsApp Web / QR)
            </option>
            <option value="auto">
              Automático (Intenta Meta -> Respaldo en Evolution)
            </option>
          </select>
        </div>
        <div>
          <label>Número de WhatsApp (con código de país o 9 dígitos de Perú)</label>
          <input type="text" name="telefono" placeholder="Ej: 902539354 o 51902539354" value="51902539354" required>
        </div>
        <div>
          <label>Mensaje de prueba</label>
          <textarea name="mensaje" rows="3" placeholder="Escribe un mensaje de prueba...">¡Hola! Este es un mensaje de prueba oficial desde Zona Fitness Pro 🏋️‍♂️</textarea>
        </div>
        <% const canSend = (metaInfo && metaInfo.ok) || estado === 'open'; %>
        <button class="btn primary" type="submit" <%= !canSend ? 'disabled' : '' %> style="display:inline-flex; align-items:center; justify-content:center; gap:6px;">
          <%- u.icon('send', 14) %> Enviar mensaje de prueba
        </button>
        <% if (!canSend) { %>
          <span class="muted" style="font-size:12px; text-align:center;">(Configura el Token de Meta o vincula el código QR para enviar)</span>
        <% } %>
      </form>
    </div>

    <div class="card">
      <h3 class="mt0" style="font-size:15px; display:flex; align-items:center; gap:6px;">
        <%- u.icon('zap', 16) %> Resumen de Canales para Clientes
      </h3>
      <div style="font-size:12.5px; color:var(--muted); line-height:1.6; display:flex; flex-direction:column; gap:8px;">
        <div>
          <strong style="color:var(--text, #111827);">1. Meta Cloud API (Corporativo):</strong>
          <br>0% riesgo de baneo. Se envía desde la nube oficial de Meta. Es el método recomendado para gimnasios medianos y grandes.
        </div>
        <div>
          <strong style="color:var(--text, #111827);">2. Evolution API (QR Directo):</strong>
          <br>Vincula el WhatsApp normal o Business del gimnasio escaneando un código QR en 5 segundos.
        </div>
        <div>
          <strong style="color:var(--text, #111827);">3. WhatsApp Web (1 Clic manual):</strong>
          <br>En la lista de socios o caja, el botón "web" abre la conversación con el texto pre-redactado para dar Enter.
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    var estadoActual = '<%= estado %>';
    if (estadoActual === 'open') return;

    var timeLeft = 15;
    var qrImg = document.getElementById('qr-img');
    var qrSpinner = document.getElementById('qr-spinner');
    var timerBar = document.getElementById('qr-timer-bar');
    var countdownEl = document.getElementById('countdown');

    function actualizarTimer() {
      timeLeft--;
      if (countdownEl) countdownEl.textContent = timeLeft;
      if (timerBar) timerBar.style.width = (timeLeft / 15 * 100) + '%';

      if (timeLeft <= 0) {
        timeLeft = 15;
        recargarQR();
      }
    }

    function recargarQR() {
      fetch('/whatsapp/qr-live')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok && data.estado === 'open') {
            window.location.reload();
            return;
          }
          if (data.ok && data.qr) {
            var src = data.qr.startsWith('data:') ? data.qr : 'data:image/png;base64,' + data.qr;
            qrImg.src = src;
            qrImg.style.display = 'block';
            if (qrSpinner) qrSpinner.style.display = 'none';
          }
        })
        .catch(function() {});
    }

    window.recargarQRManual = function() {
      timeLeft = 15;
      if (qrSpinner) qrSpinner.style.display = 'block';
      if (qrImg) qrImg.style.display = 'none';
      recargarQR();
    };

    setInterval(actualizarTimer, 1000);
  })();
</script>
