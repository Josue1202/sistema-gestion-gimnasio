<div class="toolbar" style="margin-bottom:18px;">
  <div>
    <h1 class="mb0" style="display:flex; align-items:center; gap:8px;">
      <span>Panel de Control</span>
    </h1>
    <p class="muted" style="margin-top:4px;">Resumen operativo del gimnasio en tiempo real.</p>
  </div>
  <div class="actions">
    <a class="btn primary" href="/asistencia"><%- u.icon('terminal', 15) %> Check-in Rápido</a>
    <button class="btn" type="button" onclick="abrirModalSocioDashboard();" style="display:inline-flex; align-items:center; gap:6px;"><%- u.icon('userPlus', 15) %> Registrar Socio</button>
    <a class="btn" href="/caja"><%- u.icon('caja', 15) %> Ir a Caja</a>
  </div>
</div>

<!-- Estado de Caja -->
<% if (!caja) { %>
  <div class="flash error" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
    <div>
      <strong><%- u.icon('alert', 16) %> La caja del día está cerrada.</strong>
      <span style="opacity:0.9;">Abre caja para registrar cobros y pagos de mostrador.</span>
    </div>
    <a class="btn sm primary" href="/caja">Abrir Caja Ahora</a>
  </div>
<% } else { %>
  <div class="card" style="padding:12px 16px; margin-bottom:16px; background:var(--surface-2);">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
      <div>
        <span class="badge ok" style="font-size:11px;">CAJA ABIERTA</span>
        <span style="font-size:13.5px; margin-left:8px;">
          Abierta <%= u.fechaHora(caja.fecha_apertura) %> · Efectivo esperado: <strong><%= u.soles(caja.efectivo_esperado) %></strong>
        </span>
      </div>
      <a class="btn sm" href="/caja">Ver movimientos de caja »</a>
    </div>
  </div>
<% } %>

<!-- KPIs Principales -->
<div class="kpis">
  <div class="kpi">
    <div class="label" style="display:flex; align-items:center; gap:6px;"><%- u.icon('socios', 15) %> Socios activos</div>
    <div class="value" style="color:var(--primary);"><%= kpis.socios_activos || 0 %></div>
  </div>
  <div class="kpi">
    <div class="label" style="display:flex; align-items:center; gap:6px;"><%- u.icon('alert', 15) %> Vencidos</div>
    <div class="value"><%= kpis.socios_vencidos || 0 %></div>
  </div>
  <div class="kpi">
    <div class="label" style="display:flex; align-items:center; gap:6px;"><%- u.icon('clock', 15) %> Vencen en 7 días</div>
    <div class="value"><%= kpis.vencen_7d || 0 %></div>
  </div>
  <div class="kpi">
    <div class="label" style="display:flex; align-items:center; gap:6px;"><%- u.icon('dollar', 15) %> Ingresos de hoy</div>
    <div class="value"><%= u.soles(kpis.ingresos_hoy) %></div>
  </div>
  <div class="kpi">
    <div class="label" style="display:flex; align-items:center; gap:6px;"><%- u.icon('reportes', 15) %> Ingresos del mes</div>
    <div class="value"><%= u.soles(kpis.ingresos_mes) %></div>
  </div>
  <div class="kpi">
    <div class="label" style="display:flex; align-items:center; gap:6px;"><%- u.icon('checkCircle', 15) %> Asistencias hoy</div>
    <div class="value"><%= kpis.asistencias_hoy || 0 %></div>
  </div>
</div>

<!-- Vencimientos en los próximos 7 días -->
<div class="toolbar" style="margin-top:28px;">
  <h2 class="mb0">Vencimientos en los próximos 7 días (<%= porVencer.length %>)</h2>
  <a class="btn sm" href="/mensajes">Gestionar recordatorios »</a>
</div>

<div class="card">
  <% if (!porVencer.length) { %>
    <p class="muted mb0">No hay membresías por vencer en los próximos 7 días.</p>
  <% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Socio</th><th>Plan</th><th>Fecha de Vencimiento</th><th class="num">Días</th><th>Acción Rápida</th></tr></thead>
    <tbody>
    <% porVencer.forEach(function(r){ var link = linkPara(r.dias_restantes === 0 ? 'recordatorio_hoy' : 'recordatorio_3d', r); %>
      <tr>
        <td>
          <a href="/socios/<%= r.socio_id %>" style="font-weight:600;">
            <%= r.nombres %> <%= r.apellidos %>
          </a>
        </td>
        <td><%= r.plan_nombre %></td>
        <td><%= u.fecha(r.fecha_fin) %></td>
        <td class="num">
          <span class="badge <%= r.dias_restantes <= 1 ? 'danger' : 'warn' %>">
            <%= r.dias_restantes === 0 ? '¡Hoy!' : r.dias_restantes + ' d' %>
          </span>
        </td>
        <td class="actions">
          <% if (r.telefono) { %>
            <form method="post" action="/dashboard/enviar-whatsapp" style="margin:0; display:inline;">
              <input type="hidden" name="socio_id" value="<%= r.socio_id %>">
              <input type="hidden" name="telefono" value="<%= r.telefono %>">
              <input type="hidden" name="plantilla_clave" value="<%= r.dias_restantes === 0 ? 'recordatorio_hoy' : 'recordatorio_3d' %>">
              <button class="btn sm wa" type="submit" title="Enviar recordatorio automático directamente por WhatsApp"><%- u.icon('whatsapp', 14) %> WhatsApp</button>
            </form>
            <% if (link) { %>
              <a class="muted" href="<%= link %>" target="_blank" rel="noopener" style="font-size:11px; text-decoration:underline;" title="Abrir en WhatsApp Web en una pestaña si el servidor no está vinculado">web</a>
            <% } %>
          <% } %>
          <a class="btn sm primary" href="/suscripciones/nueva?socio=<%= r.socio_id %>">Renovar</a>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table></div>
  <% } %>
</div>

<div class="row">
  <div>
    <div class="toolbar">
      <h2 class="mb0">Membresías Vencidas (<%= vencidos.length %>)</h2>
      <a class="btn sm" href="/socios?estado=vencido">Ver todos</a>
    </div>
    <div class="card">
      <% if (!vencidos.length) { %>
        <p class="muted mb0">No hay socios con membresía vencida.</p>
      <% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Socio</th><th class="num">Venció hace</th><th></th></tr></thead>
        <tbody>
        <% vencidos.forEach(function(r){ var link = linkPara('vencido', r); %>
          <tr>
            <td><a href="/socios/<%= r.socio_id %>"><%= r.nombres %> <%= r.apellidos %></a></td>
            <td class="num"><span class="badge danger"><%= r.dias_vencido %> d</span></td>
            <td class="actions">
              <% if (r.telefono) { %>
                <form method="post" action="/dashboard/enviar-whatsapp" style="margin:0; display:inline;">
                  <input type="hidden" name="socio_id" value="<%= r.socio_id %>">
                  <input type="hidden" name="telefono" value="<%= r.telefono %>">
                  <input type="hidden" name="plantilla_clave" value="vencido">
                  <button class="btn sm wa" type="submit" title="Enviar aviso de vencimiento directamente por WhatsApp"><%- u.icon('whatsapp', 14) %> Recordar</button>
                </form>
                <% if (link) { %>
                  <a class="muted" href="<%= link %>" target="_blank" rel="noopener" style="font-size:11px; text-decoration:underline;" title="Abrir en WhatsApp Web en una pestaña si el servidor no está vinculado">web</a>
                <% } %>
              <% } %>
              <a class="btn sm" href="/suscripciones/nueva?socio=<%= r.socio_id %>">Cobrar</a>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table></div>
      <% } %>
    </div>
  </div>

  <div>
    <div class="toolbar">
      <h2 class="mb0">En riesgo (Sin venir 14+ días) (<%= riesgo.length %>)</h2>
      <a class="btn sm" href="/mensajes">Reactivar</a>
    </div>
    <div class="card">
      <% if (!riesgo.length) { %>
        <p class="muted mb0">Todos los socios activos están asistiendo regularmente.</p>
      <% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Socio</th><th class="num">Ausente</th><th></th></tr></thead>
        <tbody>
        <% riesgo.forEach(function(r){ var link = linkPara('te_extranamos', r); %>
          <tr>
            <td><a href="/socios/<%= r.socio_id %>"><%= r.nombres %> <%= r.apellidos %></a></td>
            <td class="num"><span class="badge warn"><%= r.dias_sin_venir == null ? '—' : r.dias_sin_venir + ' d' %></span></td>
            <td>
              <% if (link) { %><a class="btn sm wa" href="<%= link %>" target="_blank" rel="noopener">Recuperar</a><% } %>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table></div>
      <% } %>
    </div>
  </div>
</div>

<% if (cumples.length) { %>
<div class="toolbar" style="margin-top:20px;">
  <h2 class="mb0" style="display:flex; align-items:center; gap:8px;">Cumpleaños de hoy (<%= cumples.length %>)</h2>
</div>
<div class="card">
  <div class="pill-list">
  <% cumples.forEach(function(r){ %>
    <a class="btn sm" href="/socios/<%= r.socio_id %>" style="padding:8px 14px;">
      <%- u.icon('user', 14) %> <%= r.nombres %> <%= r.apellidos %>
    </a>
  <% }); %>
  </div>
</div>
<% } %>

<!-- Modal Flotante: Registrar Socio desde Dashboard -->
<div id="modal-socio-dash" class="modal-backdrop" style="display:none;" onclick="if(event.target===this) window.cerrarModal('modal-socio-dash');">
  <div class="modal-dialog lg">
    <div class="modal-header">
      <h3 class="modal-title">
        <%- u.icon('userPlus', 16) %> Registrar Nuevo Socio
      </h3>
      <button type="button" class="modal-close" onclick="window.cerrarModal('modal-socio-dash');" aria-label="Cerrar">
        <%- u.icon('close', 16) %>
      </button>
    </div>
    <form method="post" action="/socios" class="stack" style="margin:0;">
      <div class="modal-body">
        <div class="grid2">
          <div>
            <label for="dash-socio-nombres">Nombres *</label>
            <input id="dash-socio-nombres" name="nombres" required placeholder="Ej: Juan Carlos">
          </div>
          <div>
            <label for="dash-socio-apellidos">Apellidos *</label>
            <input id="dash-socio-apellidos" name="apellidos" required placeholder="Ej: Pérez García">
          </div>
        </div>

        <div class="grid3">
          <div>
            <label for="dash-socio-dni">DNI / Documento</label>
            <input id="dash-socio-dni" name="dni" placeholder="8 dígitos...">
          </div>
          <div>
            <label for="dash-socio-tel">Teléfono (WhatsApp)</label>
            <input id="dash-socio-tel" name="telefono" placeholder="Ej: 987654321">
          </div>
          <div>
            <label for="dash-socio-fnac">Fecha de Nacimiento</label>
            <input type="date" id="dash-socio-fnac" name="fecha_nacimiento">
          </div>
        </div>

        <div class="grid3">
          <div>
            <label for="dash-socio-email">Correo Electrónico</label>
            <input type="email" id="dash-socio-email" name="email" placeholder="socio@email.com">
          </div>
          <div>
            <label for="dash-socio-genero">Género</label>
            <select id="dash-socio-genero" name="genero">
              <option value="">—</option>
              <option value="M">Masculino</option>
              <option value="F">Femenino</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div>
            <label for="dash-socio-dir">Dirección</label>
            <input id="dash-socio-dir" name="direccion" placeholder="Av. Principal 123...">
          </div>
        </div>

        <div class="grid2">
          <div>
            <label for="dash-socio-cemer">Contacto de Emergencia</label>
            <input id="dash-socio-cemer" name="contacto_emergencia_nombre" placeholder="Familiar / Amigo">
          </div>
          <div>
            <label for="dash-socio-temer">Teléfono de Emergencia</label>
            <input id="dash-socio-temer" name="contacto_emergencia_telefono" placeholder="Número de contacto">
          </div>
        </div>

        <div>
          <label for="dash-socio-notas">Notas / Salud</label>
          <textarea id="dash-socio-notas" name="notas" rows="2" placeholder="Observaciones, lesiones..."></textarea>
        </div>

        <div>
          <label style="display:flex; gap:8px; align-items:center; cursor:pointer;">
            <input type="checkbox" name="acepta_marketing" style="width:auto;" checked>
            <span>Acepta avisos y confirmaciones de pago por WhatsApp</span>
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="window.cerrarModal('modal-socio-dash');">Cancelar</button>
        <button type="submit" class="btn primary">Guardar y Asignar Plan</button>
      </div>
    </form>
  </div>
</div>

<script>
  function abrirModalSocioDashboard() {
    window.abrirModal('modal-socio-dash');
  }
</script>
