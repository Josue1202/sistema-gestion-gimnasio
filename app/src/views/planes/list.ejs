<div class="toolbar">
  <h1 class="mb0">Planes y precios</h1>
  <button class="btn primary" type="button" onclick="abrirModalPlanNuevo();" style="display:inline-flex; align-items:center; gap:6px;">
    <%- u.icon('plus', 15) %> Nuevo plan
  </button>
</div>

<div class="card">
  <div class="table-wrap"><table>
    <thead><tr><th>Nombre</th><th>Descripcion</th><th class="num">Precio</th><th class="num">Dias</th><th>Estado</th><th></th></tr></thead>
    <tbody>
    <% planes.forEach(function(p){ %>
      <tr<%= p.activo ? '' : ' class="muted"' %>>
        <td><strong><%= p.nombre %></strong></td>
        <td><%= p.descripcion || '' %></td>
        <td class="num"><%= u.soles(p.precio) %></td>
        <td class="num"><%= p.duracion_dias %></td>
        <td><span class="badge <%= p.activo ? 'ok' : 'muted' %>"><%= p.activo ? 'Activo' : 'Inactivo' %></span></td>
        <td class="actions">
          <button class="btn sm" type="button"
                  data-id="<%= p.id %>"
                  data-nombre="<%= p.nombre %>"
                  data-descripcion="<%= p.descripcion || '' %>"
                  data-precio="<%= p.precio %>"
                  data-dias="<%= p.duracion_dias %>"
                  onclick="abrirModalPlanEditar(this);"
                  style="display:inline-flex; align-items:center; gap:4px;">
            <%- u.icon('edit', 13) %> Editar
          </button>
          <form method="post" action="/planes/<%= p.id %>/toggle" style="margin:0;">
            <button class="btn sm" type="submit"><%= p.activo ? 'Desactivar' : 'Activar' %></button>
          </form>
        </td>
      </tr>
    <% }); %>
    <% if (!planes.length) { %><tr><td colspan="6" class="muted">Sin planes registrados.</td></tr><% } %>
    </tbody>
  </table></div>
</div>

<!-- Modal Flotante: Crear / Editar Plan -->
<div id="modal-plan" class="modal-backdrop" style="display:none;" onclick="if(event.target===this) window.cerrarModal('modal-plan');">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">
        <%- u.icon('planes', 16) %> <span id="plan-modal-title">Nuevo Plan</span>
      </h3>
      <button type="button" class="modal-close" onclick="window.cerrarModal('modal-plan');" aria-label="Cerrar">
        <%- u.icon('close', 16) %>
      </button>
    </div>
    <form id="form-plan" method="post" action="/planes" class="stack" style="margin:0;">
      <div class="modal-body">
        <div style="margin-bottom:12px;">
          <label for="plan-nombre">Nombre del Plan *</label>
          <input id="plan-nombre" name="nombre" required placeholder="Ej: Mensual Full, Trimestral, Anual VIP...">
        </div>
        <div style="margin-bottom:12px;">
          <label for="plan-desc">Descripción</label>
          <input id="plan-desc" name="descripcion" placeholder="Ej: Acceso total a pesas, cardio y asesoría...">
        </div>
        <div class="grid2">
          <div>
            <label for="plan-precio">Precio (S/) *</label>
            <input type="number" step="0.01" min="0" id="plan-precio" name="precio" placeholder="0.00" required>
          </div>
          <div>
            <label for="plan-dias">Duración (días) *</label>
            <input type="number" min="1" id="plan-dias" name="duracion_dias" placeholder="30" required>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="window.cerrarModal('modal-plan');">Cancelar</button>
        <button type="submit" class="btn primary">Guardar Plan</button>
      </div>
    </form>
  </div>
</div>

<script>
  function abrirModalPlanNuevo() {
    document.getElementById('plan-modal-title').textContent = 'Nuevo Plan';
    var f = document.getElementById('form-plan');
    f.action = '/planes';
    f.reset();
    window.abrirModal('modal-plan');
  }

  function abrirModalPlanEditar(btn) {
    document.getElementById('plan-modal-title').textContent = 'Editar Plan';
    var f = document.getElementById('form-plan');
    f.action = '/planes/' + btn.getAttribute('data-id');
    document.getElementById('plan-nombre').value = btn.getAttribute('data-nombre') || '';
    document.getElementById('plan-desc').value = btn.getAttribute('data-descripcion') || '';
    document.getElementById('plan-precio').value = btn.getAttribute('data-precio') || '';
    document.getElementById('plan-dias').value = btn.getAttribute('data-dias') || '';
    window.abrirModal('modal-plan');
  }
</script>
