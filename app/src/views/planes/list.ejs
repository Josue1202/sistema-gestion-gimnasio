<div class="page-container-narrow">
  <div class="toolbar">
    <div>
      <h1 class="mb0">Planes y Tarifas</h1>
      <p class="muted" style="margin-top:4px;">Configuración de membresías ofrecidas a los socios (mensual, trimestral, pase diario, etc.).</p>
    </div>
    <button class="btn primary" type="button" onclick="abrirModalPlanNuevo();" style="display:inline-flex; align-items:center; gap:6px;">
      <%- u.icon('plus', 15) %> Nuevo plan
    </button>
  </div>

  <div class="card">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th style="min-width:160px;">Plan</th>
            <th>Descripción</th>
            <th class="num" style="width:100px;">Precio</th>
            <th class="num" style="width:80px;">Días</th>
            <th style="width:90px; text-align:center;">Estado</th>
            <th style="width:145px; text-align:right;">Acciones</th>
          </tr>
        </thead>
        <tbody>
        <% planes.forEach(function(p){ %>
          <tr<%= p.activo ? '' : ' class="muted"' %>>
            <td><strong style="color:var(--text-bright);"><%= p.nombre %></strong></td>
            <td><span class="muted" style="font-size:12.5px;"><%= p.descripcion || 'Sin descripción' %></span></td>
            <td class="num" style="font-weight:700; color:var(--text-bright);"><%= u.soles(p.precio) %></td>
            <td class="num"><%= p.duracion_dias %> d</td>
            <td style="text-align:center;"><span class="badge <%= p.activo ? 'ok' : 'muted' %>"><%= p.activo ? 'Activo' : 'Inactivo' %></span></td>
            <td class="actions">
              <div style="display:flex; align-items:center; justify-content:flex-end; gap:5px;">
                <button class="btn sm" type="button"
                        data-id="<%= p.id %>"
                        data-nombre="<%= p.nombre %>"
                        data-descripcion="<%= p.descripcion || '' %>"
                        data-precio="<%= p.precio %>"
                        data-dias="<%= p.duracion_dias %>"
                        onclick="abrirModalPlanEditar(this);"
                        style="height:28px; padding:0 8px; font-size:11.5px; display:inline-flex; align-items:center; gap:4px;"
                        title="Editar">
                  <%- u.icon('edit', 12) %> Editar
                </button>
                <form method="post" action="/planes/<%= p.id %>/toggle" style="margin:0;">
                  <button class="btn sm" type="submit" style="height:28px; padding:0 8px; font-size:11.5px;" title="<%= p.activo ? 'Desactivar' : 'Activar' %>">
                    <%= p.activo ? 'Pausar' : 'Activar' %>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
        <% if (!planes.length) { %>
          <tr><td colspan="6" class="muted" style="text-align:center; padding:24px 12px;">Sin planes registrados. Haz clic en "Nuevo plan".</td></tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Flotante: Crear / Editar Plan -->
<div id="modal-plan" class="modal-backdrop" style="display:none;" onclick="if(event.target===this) window.cerrarModal('modal-plan');">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">
        <%- u.icon('planes', 16) %> <span id="plan-modal-title">Nuevo Plan</span>
      </h3>
      <button type="button" class="modal-close" onclick="window.cerrarModal('modal-plan');" aria-label="Cerrar">
        <%- u.icon('close', 16) %>
      </button>
    </div>
    <form id="form-plan" method="post" action="/planes" class="stack" style="margin:0;" autocomplete="off">
      <div class="modal-body">
        <div style="margin-bottom:12px;">
          <label for="plan-nombre">Nombre del Plan *</label>
          <input id="plan-nombre" name="nombre" required placeholder="Ej: Mensual Full, Trimestral, Anual VIP..." autocomplete="off">
        </div>
        <div style="margin-bottom:12px;">
          <label for="plan-desc">Descripción</label>
          <input id="plan-desc" name="descripcion" placeholder="Ej: Acceso total a pesas, cardio y asesoría..." autocomplete="off">
        </div>
        <div class="grid2">
          <div>
            <label for="plan-precio">Precio (S/) *</label>
            <input type="number" step="0.01" min="0" id="plan-precio" name="precio" placeholder="0.00" required>
          </div>
          <div>
            <label for="plan-dias">Duración (días) *</label>
            <input type="number" min="1" id="plan-dias" name="duracion_dias" placeholder="30" required>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="window.cerrarModal('modal-plan');">Cancelar</button>
        <button type="submit" class="btn primary">Guardar Plan</button>
      </div>
    </form>
  </div>
</div>

<script>
  function abrirModalPlanNuevo() {
    document.getElementById('plan-modal-title').textContent = 'Nuevo Plan';
    var f = document.getElementById('form-plan');
    f.action = '/planes';
    f.reset();
    window.abrirModal('modal-plan');
  }

  function abrirModalPlanEditar(btn) {
    document.getElementById('plan-modal-title').textContent = 'Editar Plan';
    var f = document.getElementById('form-plan');
    f.action = '/planes/' + btn.getAttribute('data-id');
    document.getElementById('plan-nombre').value = btn.getAttribute('data-nombre') || '';
    document.getElementById('plan-desc').value = btn.getAttribute('data-descripcion') || '';
    document.getElementById('plan-precio').value = btn.getAttribute('data-precio') || '';
    document.getElementById('plan-dias').value = btn.getAttribute('data-dias') || '';
    window.abrirModal('modal-plan');
  }
</script>
