# Variables para el despliegue en Coolify.
# En Coolify: recurso -> pestana "Environment Variables" -> pega estas (con valores reales).
# NO subas este archivo con valores reales a git.

# ---------- Dominios (subdominios que apuntan al servidor) ----------
N8N_HOST=n8n.tudominio.com
EVOLUTION_HOST=evo.tudominio.com
# El dominio de la app se configura en la UI de Coolify (servicio "app").

# ---------- Zona horaria ----------
TZ=America/Lima

# ---------- Postgres ----------
POSTGRES_USER=gym
POSTGRES_PASSWORD=          # openssl rand -hex 24
POSTGRES_DB=gym

# ---------- App ----------
SESSION_SECRET=             # openssl rand -hex 32

# ---------- n8n ----------
N8N_ENCRYPTION_KEY=         # openssl rand -hex 32   (IMPORTANTE: la misma de local si migras datos)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=    # openssl rand -hex 12

# ---------- Evolution API (WhatsApp) ----------
EVOLUTION_API_KEY=          # openssl rand -hex 24
EVOLUTION_INSTANCE=gym

# ---------- Resumen diario a la duena ----------
GYM_OWNER_PHONE=51902539354
