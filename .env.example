# Copia este archivo a ".env" y cambia TODAS las claves.
#   cp .env.example .env

# ---------- Zona horaria ----------
TZ=America/Lima

# ---------- Postgres ----------
POSTGRES_USER=gym
POSTGRES_PASSWORD=cambia-esta-clave-larga
POSTGRES_DB=gym
POSTGRES_PORT=5432

# ---------- n8n ----------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
# 32+ caracteres aleatorios. Genera con:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=reemplaza-con-32-caracteres-aleatorios
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambia-esta-clave

# ---------- Evolution API (WhatsApp) ----------
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
# Clave para llamar a la API. Genera con:  openssl rand -hex 24
EVOLUTION_API_KEY=reemplaza-con-clave-aleatoria-larga

# ---------- Adminer (visor de BD) ----------
ADMINER_PORT=8081

# ---------- App web ----------
APP_PORT=3000
# Secreto para firmar la cookie de sesion. Genera con:  openssl rand -hex 32
SESSION_SECRET=reemplaza-con-secreto-aleatorio-largo
# Pon "true" solo cuando la app se sirva por HTTPS (produccion detras de Coolify/Traefik)
COOKIE_SECURE=false
